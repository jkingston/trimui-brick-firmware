config BR2_PACKAGE_BRICK_ACCELERATOR_QUALIFICATION
	bool
	default y if BR2_BRICK_G2D_QUALIFICATION || BR2_BRICK_VE_QUALIFICATION || BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_LIBV4L
	select BR2_PACKAGE_LIBV4L_UTILS
	select BR2_PACKAGE_GSTREAMER1 if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BASE if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_IVFPARSE if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_V4L2CODECS if BR2_BRICK_VE_QUALIFICATION
	select BR2_PACKAGE_GSTREAMER1 if BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS if BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BASE if BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE if BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD if BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_IVFPARSE if BR2_BRICK_VP9_QUALIFICATION
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_V4L2CODECS if BR2_BRICK_VP9_QUALIFICATION
	help
	  Deterministic V4L2 qualification entry points and fixtures. This
	  package is present only in an isolated accelerator profile.
