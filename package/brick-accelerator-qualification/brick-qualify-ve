#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

usage="usage: $0 probe NEW-RESULT-DIRECTORY | decode CASE NEW-RESULT-DIRECTORY"
[ "$#" -ge 2 ] || { echo "$usage" >&2; exit 2; }
marker=/sys/firmware/devicetree/base/chosen/trimui,ve-qualification
combined=/sys/firmware/devicetree/base/chosen/trimui,accelerator-qualification
if [ -f "$marker" ] && [ "$(tr -d '\000' < "$marker")" = isolated ]; then
	:
elif [ -f "$combined" ] && [ "$(tr -d '\000' < "$combined")" = combined-v1 ]; then
	:
else
	echo "not a video-engine qualification image" >&2
	exit 2
fi
mode=$1
shift
assets=/usr/share/brick-qualification/ve
out=
before_lines=0

capture_diagnostics()
{
	[ -n "$out" ] && [ -d "$out" ] || return 0
	cat /proc/interrupts > "$out/interrupts-after" 2>&1 || true
	find /sys/kernel/debug/clk -maxdepth 2 -type f \
		\( -name clk_rate -o -name clk_parent \) -path '*ve*' \
		-print -exec cat '{}' \; > "$out/clocks-after" 2>&1 || true
	dmesg > "$out/dmesg-after" 2>&1 || true
	if [ "$before_lines" -gt 0 ]; then
		sed -n "$((before_lines + 1)),\$p" "$out/dmesg-after" \
			> "$out/dmesg-delta" || true
	fi
}

finish()
{
	status=$?
	trap - EXIT
	capture_diagnostics
	if [ "$status" -ne 0 ] && [ -n "$out" ] && [ -d "$out" ] && [ ! -e "$out/RESULT" ]; then
		printf 'FAIL status=%s\n' "$status" > "$out/RESULT"
	fi
	exit "$status"
}

runtime_contract()
{
	if ! grep -q '[[:space:]]/sys/kernel/debug[[:space:]]debugfs[[:space:]]' /proc/mounts; then
		mount -t debugfs debugfs /sys/kernel/debug
	fi
	[ "$(cat /sys/kernel/debug/clk/ve/clk_rate)" = 432000000 ] || {
		echo "VE clock is not at stock 432 MHz" >&2
		exit 2
	}
	[ "$(cat /sys/kernel/debug/clk/ve/clk_parent)" = pll-ve ] || {
		echo "VE clock parent is not stock PLL-VE" >&2
		exit 2
	}
	set -- /sys/bus/platform/devices/*1c0e000.video-codec
	[ "$#" -eq 1 ] && [ -d "$1" ] && [ -L "$1/iommu_group" ] || {
		echo "VE is not attached to one IOMMU group" >&2
		exit 2
	}
	readlink -f "$1/iommu_group" > "$out/iommu-group"
	set -- /sys/bus/platform/devices/video-engine-domain
	[ "$#" -eq 1 ] && [ -d "$1" ] && [ -L "$1/driver" ] && \
		[ "$(basename "$(readlink -f "$1/driver")")" = sun50i-a133-ve-domain ] || {
		echo "shared video-engine domain is not bound to its reviewed driver" >&2
		exit 2
	}
	readlink -f "$1/driver" > "$out/domain-driver"
}

check_new_diagnostics()
{
	capture_diagnostics
	if grep -Ei '(BUG:|Oops:|Kernel panic|Call trace:|iommu.*fault|(cedrus|video-engine-domain).*(timeout|fault|error|failed))' \
		"$out/dmesg-delta" > "$out/kernel-errors"; then
		echo "new kernel fault or Cedrus error during qualification" >&2
		return 1
	fi
}

trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

find_cedrus()
{
	found=
	for path in /sys/class/video4linux/video*; do
		[ -e "$path" ] || continue
		[ "$(cat "$path/name")" = cedrus ] || continue
		[ -z "$found" ] || { echo "duplicate Cedrus devices" >&2; exit 2; }
		found=/dev/$(basename "$path")
	done
	[ -n "$found" ] || { echo "missing Cedrus device" >&2; exit 2; }
	printf '%s\n' "$found"
}

if [ "$mode" = probe ] && [ "$#" -eq 1 ]; then
	[ ! -e "$1" ] || { echo "$1 already exists" >&2; exit 2; }
	mkdir "$1"
	out=$(cd "$1" && pwd)
	dmesg > "$out/dmesg-before"
	before_lines=$(wc -l < "$out/dmesg-before")
	runtime_contract
	device=$(find_cedrus)
	cat /proc/interrupts > "$out/interrupts-before"
	v4l2-ctl -d "$device" --all > "$out/v4l2-ctl.log" 2>&1
	timeout 120 v4l2-compliance -d "$device" > "$out/v4l2-compliance.log" 2>&1
	for decoder in v4l2slmpeg2dec v4l2slh264dec v4l2slh265dec v4l2slvp8dec; do
		timeout 15 gst-inspect-1.0 "$decoder" > "$out/$decoder.log" 2>&1
	done
	check_new_diagnostics
	printf 'PASS ve probe qualification\n' | tee "$out/RESULT"
	exit 0
fi

[ "$mode" = decode ] && [ "$#" -eq 2 ] || { echo "$usage" >&2; exit 2; }
case_name=$1
out=$2
[ ! -e "$out" ] || { echo "$out already exists" >&2; exit 2; }
case "$case_name" in
	mpeg2-ipb) suffix=mpeg2; parser=mpegvideoparse; decoder=v4l2slmpeg2dec;;
	h264-ip) suffix=h264; parser=h264parse; decoder=v4l2slh264dec;;
	hevc-ip|hevc-tiles|hevc-wpp) suffix=hevc; parser=h265parse; decoder=v4l2slh265dec;;
	vp8-ip) suffix=ivf; parser=ivfparse; decoder=v4l2slvp8dec;;
	*) echo "unknown case: $case_name" >&2; exit 2;;
esac
input=$assets/$case_name.$suffix
[ -f "$input" ] || exit 2
expected_input=$(awk -v name="$case_name.$suffix" '$2 == name { print $1 }' \
	"$assets/FIXTURE-SHA256")
[ -n "$expected_input" ] && [ "$(sha256sum "$input" | awk '{ print $1 }')" = "$expected_input" ] || {
	echo "fixture checksum mismatch" >&2
	exit 2
}
mkdir "$out"
out=$(cd "$out" && pwd)
find_cedrus > "$out/device"
dmesg > "$out/dmesg-before"
before_lines=$(wc -l < "$out/dmesg-before")
runtime_contract
cat /proc/interrupts > "$out/interrupts-before"
timeout 15 gst-inspect-1.0 "$decoder" > "$out/decoder.log" 2>&1
GST_DEBUG='v4l2codecs*:5' timeout 30 gst-launch-1.0 -e -v \
	filesrc location="$input" ! "$parser" ! "$decoder" ! \
	videoconvert ! 'video/x-raw,format=I420' ! \
	filesink location="$out/output.yuv" >> "$out/decoder.log" 2>&1
[ "$(sha256sum "$input" | awk '{ print $1 }')" = "$expected_input" ] || {
	echo "fixture changed during decode" >&2
	exit 1
}
expected=$(awk -v name="$case_name.reference.yuv" '$2 == name { print $1 }' "$assets/REFERENCE-SHA256")
[ -n "$expected" ] || exit 2
actual=$(sha256sum "$out/output.yuv" | awk '{ print $1 }')
[ "$actual" = "$expected" ] || {
	printf 'FAIL expected=%s actual=%s\n' "$expected" "$actual" | tee "$out/RESULT"
	exit 1
}
check_new_diagnostics
printf 'PASS ve decode case=%s sha256=%s\n' "$case_name" "$actual" | tee "$out/RESULT"
