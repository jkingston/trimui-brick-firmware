config BR2_PACKAGE_BRICK_WPEWEBKIT
	bool "Brick WPE WebKit captive browser engine"
	depends on BR2_aarch64
	depends on BR2_USE_MMU
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_17
	depends on BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS
	depends on !BR2_STATIC_LIBS
	select BR2_HOST_CMAKE_AT_LEAST_3_20
	select BR2_PACKAGE_BUBBLEWRAP
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_HARFBUZZ
	select BR2_PACKAGE_ICU
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBEPOXY
	select BR2_PACKAGE_LIBGCRYPT
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBSECCOMP
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_LIBTASN1
	select BR2_PACKAGE_LIBUDEV_ZERO
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_LIBXSLT
	select BR2_PACKAGE_MESA3D
	select BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE
	select BR2_PACKAGE_MESA3D_OPENGL_EGL
	select BR2_PACKAGE_MESA3D_OPENGL_ES
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_WEBP_DEMUX
	select BR2_PACKAGE_WEBP_MUX
	select BR2_PACKAGE_WOFF2
	select BR2_PACKAGE_XDG_DBUS_PROXY
	select BR2_PACKAGE_XKEYBOARD_CONFIG
	help
	  Pinned WPE WebKit 2.54 engine for the Brick captive browser.
	  This builds the upstream DRM WPEPlatform backend against Mesa
	  softpipe/GBM and libudev-zero with four narrow Brick integration
	  patches. It does not build Wayland, the legacy WPE API, a custom
	  WPEPlatform backend, or a second browser engine.
