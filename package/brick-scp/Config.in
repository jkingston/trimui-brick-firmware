config BR2_PACKAGE_BRICK_SCP
	bool "Brick SCP startup profile"
	select BR2_PACKAGE_HOST_PYTHON3
	help
	  Build the opt-in Brick SCP profile using the exact SCP and service
	  device tree extracted from the official firmware archive. The profile
	  includes bounded startup, mailbox loopback, the versioned native wake
	  ABI and the source support needed for stock-compatible system suspend.

config BR2_PACKAGE_BRICK_SCP_SYSTEM_SUSPEND
	bool "Brick SCP system-suspend profile"
	select BR2_PACKAGE_BRICK_SCP
	help
	  Expose the complete, default-off A133 PSCI system-suspend path. Select
	  this only as part of the paired deep firmware and kernel-DT profile.
