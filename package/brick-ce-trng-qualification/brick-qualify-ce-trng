#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

usage="usage: $0 core|lifecycle|suspend NEW-RESULT-DIRECTORY"
[ "$#" -eq 2 ] || { echo "$usage" >&2; exit 2; }
mode=$1
out=$2
case "$mode" in core|lifecycle|suspend) ;; *) echo "$usage" >&2; exit 2;; esac
[ ! -e "$out" ] || { echo "$out already exists" >&2; exit 2; }
marker=/sys/firmware/devicetree/base/chosen/trimui,ce-trng-qualification
combined=/sys/firmware/devicetree/base/chosen/trimui,accelerator-qualification
if [ -f "$marker" ] && [ "$(tr -d '\000' < "$marker")" = isolated-zero-credit ]; then
	:
elif [ -f "$combined" ] && [ "$(tr -d '\000' < "$combined")" = combined-v2 ]; then
	:
else
	echo "not a CE/TRNG qualification image" >&2
	exit 2
fi
mkdir "$out"
out=$(cd "$out" && pwd)
tool=/usr/libexec/brick-qualification/brick-ce-kat
before_lines=0
stress_pid=
stress_group=0
stress_dmesg_lines=0
stress_irq_before=0
stress_label=

stress_exit()
{
	stage=$1
	pgid=$stress_pid
	if kill -0 -"$pgid" 2>/dev/null; then
		kill -KILL -"$pgid" 2>/dev/null || true
	else
		kill -KILL "$stress_pid" 2>/dev/null || true
	fi
	status=0
	wait "$stress_pid" || status=$?
	stress_pid=
	stress_group=0
	if kill -0 -"$pgid" 2>/dev/null; then
		kill -KILL -"$pgid" 2>/dev/null || true
	fi
	echo "concurrent CE load exited $stage (status=$status)" >&2
	return 1
}

stress_require_alive()
{
	stage=$1
	kill -0 "$stress_pid" 2>/dev/null &&
		kill -0 -"$stress_pid" 2>/dev/null || stress_exit "$stage"
}

stress_stop()
{
	pgid=$stress_pid
	if ! kill -TERM -"$pgid" 2>/dev/null; then
		stress_exit "before explicit stop"
	fi
	# Terminate every member even if a future worker grows helper processes or
	# mishandles TERM. The qualification fails if the group remains afterwards.
	sleep 1
	if kill -0 -"$pgid" 2>/dev/null; then
		kill -KILL -"$pgid" 2>/dev/null || {
			echo "could not terminate concurrent CE process group" >&2
			return 1
		}
	fi
	status=0
	wait "$stress_pid" || status=$?
	stress_pid=
	stress_group=0
	if [ "$status" -ne 143 ] && [ "$status" -ne 137 ]; then
		echo "concurrent CE load returned unexpected stop status $status" >&2
		return 1
	fi
	sleep 1
	if kill -0 -"$pgid" 2>/dev/null; then
		echo "concurrent CE descendants survived process-group termination" >&2
		return 1
	fi
}

ce_irq_count()
{
	awk '/1904000.crypto/ { total = 0; for (i = 2; i <= NF; i++) {
		if ($i !~ /^[0-9]+$/) break; total += $i } print total }' /proc/interrupts
}

check_tcrypt_run()
{
	label=$1
	start_lines=$2
	start_irqs=$3
	require_complete=${4:-yes}
	delta="$out/tcrypt-$label.dmesg"
	dmesg | sed -n "$((start_lines + 1)),\$p" > "$delta"
	grep -q 'tcrypt: testing speed' "$delta" || {
		echo "tcrypt did not start exact CE test $label" >&2
		return 1
	}
	if [ "$require_complete" = yes ]; then
		grep -q 'operations in' "$delta" || {
			echo "tcrypt completed no exact CE operations for $label" >&2
			return 1
		}
	fi
	if grep -Ei 'sun50i-a133-ce.*(failed|timeout|error|uncontained|quarantine)|tcrypt:.*(failed|error)' \
		"$delta" > "$out/tcrypt-$label.errors"; then
		echo "exact CE test $label reported a hardware or crypto error" >&2
		return 1
	fi
	end_irqs=$(ce_irq_count)
	[ -n "$start_irqs" ] && [ -n "$end_irqs" ] && [ "$end_irqs" -gt "$start_irqs" ] || {
		echo "exact CE test $label produced no CE interrupt" >&2
		return 1
	}
	printf 'interrupts_before=%s interrupts_after=%s\n' "$start_irqs" "$end_irqs" \
		> "$out/tcrypt-$label.interrupts"
}

run_tcrypt()
{
	label=$1
	mode=$2
	algorithm=$3
	keylen=$4
	workers=$5
	require_complete=${6:-yes}
	start_lines=$(dmesg | wc -l)
	start_irqs=$(ce_irq_count)
	status=0
	timeout 180 modprobe tcrypt mode="$mode" alg="$algorithm" sec=1 \
		num_mb="$workers" klen="$keylen" > "$out/tcrypt-$label.modprobe" 2>&1 || status=$?
	# tcrypt deliberately returns -EAGAIN after a successful, one-shot run.
	[ "$status" -eq 1 ] && [ ! -e /sys/module/tcrypt ] || {
		echo "unexpected tcrypt module status $status for $label" >&2
		return 1
	}
	check_tcrypt_run "$label" "$start_lines" "$start_irqs" "$require_complete"
}

run_exact_ce_suite()
{
	prefix=$1
	run_tcrypt "$prefix-ecb" 600 ecb-aes-a133-ce 16 4
	run_tcrypt "$prefix-cbc" 600 cbc-aes-a133-ce 16 4
	# SHA updates below the hardware threshold stay in software; the final is
	# still submitted to CE and is proved by the interrupt delta.
	run_tcrypt "$prefix-sha256" 400 sha256-a133-ce 0 1 no
}

start_exact_ce_stress()
{
	stress_label=$1
	seconds=$2
	stress_dmesg_lines=$(dmesg | wc -l)
	stress_irq_before=$(ce_irq_count)
	setsid timeout 600 modprobe tcrypt mode=600 alg=ecb-aes-a133-ce \
		sec="$seconds" num_mb=4 klen=16 \
		> "$out/tcrypt-$stress_label.modprobe" 2>&1 &
	stress_pid=$!
	stress_group=1
}

finish_exact_ce_stress()
{
	status=0
	wait "$stress_pid" || status=$?
	stress_pid=
	stress_group=0
	[ "$status" -eq 1 ] || {
		echo "unexpected exact CE stress status $status" >&2
		return 1
	}
	check_tcrypt_run "$stress_label" "$stress_dmesg_lines" "$stress_irq_before"
}

select_and_probe_trng()
{
	phase=$1
	grep -qw a133-ce-trng-unqualified "$rng/rng_available" || {
		echo "missing explicitly unqualified A133 TRNG after $phase" >&2
		return 1
	}
	printf '%s\n' a133-ce-trng-unqualified > "$rng/rng_current"
	[ "$(cat "$rng/rng_current")" = a133-ce-trng-unqualified ] || {
		echo "A133 TRNG is not selected after $phase" >&2
		return 1
	}
	[ "$(cat "$rng/rng_quality")" = 0 ] || {
		echo "A133 TRNG received nonzero entropy credit after $phase" >&2
		return 1
	}
	timeout 15 dd if=/dev/hwrng of="$out/trng-$phase.bin" bs=32 count=1 \
		2> "$out/trng-$phase.log"
	[ "$(wc -c < "$out/trng-$phase.bin")" -eq 32 ] || {
		echo "A133 TRNG returned a short sample after $phase" >&2
		return 1
	}
}

capture_diagnostics()
{
	cat /proc/interrupts > "$out/interrupts-after" 2>&1 || true
	cat /proc/crypto > "$out/proc-crypto-after" 2>&1 || true
	find /sys/kernel/debug/clk -maxdepth 2 -type f \
		\( -name clk_rate -o -name clk_parent \) -path '*ce*' \
		-print -exec cat '{}' \; > "$out/clocks-after" 2>&1 || true
	find /sys/kernel/iommu_groups -maxdepth 3 -type l -print \
		> "$out/iommu-groups-after" 2>&1 || true
	dmesg > "$out/dmesg-after" 2>&1 || true
	if [ "$before_lines" -gt 0 ]; then
		sed -n "$((before_lines + 1)),\$p" "$out/dmesg-after" \
			> "$out/dmesg-delta" || true
	fi
}

finish()
{
	status=$?
	trap - EXIT
	if [ -n "$stress_pid" ]; then
		if [ "$stress_group" -eq 1 ]; then
			kill -KILL -"$stress_pid" 2>/dev/null || true
		else
			kill -KILL "$stress_pid" 2>/dev/null || true
		fi
		wait "$stress_pid" 2>/dev/null || true
	fi
	capture_diagnostics
	if [ "$status" -ne 0 ] && [ ! -e "$out/RESULT" ]; then
		printf 'FAIL mode=%s status=%s\n' "$mode" "$status" > "$out/RESULT"
	fi
	exit "$status"
}

trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! grep -q '[[:space:]]/sys/kernel/debug[[:space:]]debugfs[[:space:]]' /proc/mounts; then
	mount -t debugfs debugfs /sys/kernel/debug
fi

set -- /sys/bus/platform/devices/*1904000.crypto
[ "$#" -eq 1 ] && [ -d "$1" ] || { echo "missing unique A133 CE device" >&2; exit 2; }
device=$1
device_name=$(basename "$device")
[ -L "$device/driver" ] && [ "$(basename "$(readlink -f "$device/driver")")" = sun50i-a133-ce ] || {
	echo "A133 CE is not bound to its reviewed driver" >&2
	exit 2
}
[ ! -e "$device/iommu_group" ] || {
	echo "A133 CE unexpectedly acquired an IOMMU mapping" >&2
	exit 2
}
for member in /sys/kernel/iommu_groups/*/devices/*; do
	[ -e "$member" ] || continue
	[ "$(basename "$(readlink -f "$member")")" != "$device_name" ] || {
		echo "A133 CE appears in an IOMMU group" >&2
		exit 2
	}
done

set -- /sys/kernel/debug/clk/ce/clk_rate
[ "$#" -eq 1 ] && [ -f "$1" ] && [ "$(cat "$1")" = 400000000 ] || {
	echo "CE clock is not held at reviewed 400 MHz" >&2
	exit 2
}

for driver in ecb-aes-a133-ce cbc-aes-a133-ce sha256-a133-ce; do
	grep -q "^driver[[:space:]]*: $driver$" /proc/crypto || {
		echo "missing exact Crypto API driver $driver" >&2
		exit 2
	}
done

rng=/sys/class/misc/hw_random
[ -c /dev/hwrng ] && [ -f "$rng/rng_available" ] && [ -f "$rng/rng_current" ] || {
	echo "missing hwrng public interface" >&2
	exit 2
}
select_and_probe_trng baseline

cat /proc/interrupts > "$out/interrupts-before"
cat /proc/crypto > "$out/proc-crypto-before"
find /sys/kernel/debug/clk -maxdepth 2 -type f \
	\( -name clk_rate -o -name clk_parent \) -path '*ce*' \
	-print -exec cat '{}' \; > "$out/clocks-before" 2>&1 || true
find /sys/kernel/iommu_groups -maxdepth 3 -type l -print \
	> "$out/iommu-groups-before" 2>&1 || true
dmesg > "$out/dmesg-before"
before_lines=$(wc -l < "$out/dmesg-before")

run_core()
{
	timeout 180 "$tool" kat > "$out/af-alg-kat.log" 2>&1
	timeout 180 "$tool" concurrency 1024 > "$out/af-alg-concurrency.log" 2>&1
	run_exact_ce_suite baseline
	start_exact_ce_stress concurrent-trng 1
	for flow in 0 1 2 3; do
		timeout 15 dd if=/dev/hwrng of="$out/trng-flow-$flow.bin" bs=32 count=1 \
			2> "$out/trng-flow-$flow.log"
		[ "$(wc -c < "$out/trng-flow-$flow.bin")" -eq 32 ] || exit 1
	done
	for sample in 0 1; do
		timeout 30 dd if=/dev/hwrng of="$out/trng-8192-$sample.bin" bs=8192 count=1 \
			2> "$out/trng-8192-$sample.log"
		[ "$(wc -c < "$out/trng-8192-$sample.bin")" -eq 8192 ] || exit 1
	done
	cmp -s "$out/trng-8192-0.bin" "$out/trng-8192-1.bin" && {
		echo "repeated 8 KiB TRNG output" >&2
		exit 1
	}
	dd if=/dev/zero of="$out/zero-8192.bin" bs=8192 count=1 2>/dev/null
	cmp -s "$out/trng-8192-0.bin" "$out/zero-8192.bin" && {
		echo "TRNG returned an all-zero block" >&2
		exit 1
	}
	rm "$out/zero-8192.bin"
	finish_exact_ce_stress
}

if [ "$mode" = core ]; then
	run_core
elif [ "$mode" = lifecycle ]; then
	driver=$(readlink -f "$device/driver")
	[ -w "$driver/unbind" ] && [ -w "$driver/bind" ] || {
		echo "CE lifecycle unavailable: driver suppresses bind attributes" >&2
		exit 2
	}
	run_core
	printf '%s\n' "$device_name" > "$driver/unbind"
	[ ! -L "$device/driver" ] || { echo "CE unbind did not complete" >&2; exit 1; }
	for name in ecb-aes-a133-ce cbc-aes-a133-ce sha256-a133-ce; do
		! grep -q "^driver[[:space:]]*: $name$" /proc/crypto || {
			echo "$name survived CE unbind" >&2
			exit 1
		}
	done
	if grep -qw a133-ce-trng-unqualified "$rng/rng_available"; then
		echo "A133 TRNG survived CE unbind" >&2
		exit 1
	fi
	printf '%s\n' "$device_name" > "$driver/bind"
	[ -L "$device/driver" ] || { echo "CE rebind did not complete" >&2; exit 1; }
	timeout 180 "$tool" all > "$out/post-reset-af-alg.log" 2>&1
	run_exact_ce_suite post-rebind
	select_and_probe_trng rebind
else
	set -- /sys/class/rtc/rtc*/wakealarm
	[ "$#" -ge 1 ] && [ -w "$1" ] || {
		echo "no writable RTC wake alarm; suspend was not attempted" >&2
		exit 2
	}
	wakealarm=$1
	timeout 180 "$tool" kat > "$out/pre-suspend-af-alg.log" 2>&1
	run_exact_ce_suite pre-suspend
	start_exact_ce_stress suspend-load 30
	sleep 1
	printf '0\n' > "$wakealarm"
	printf '+5\n' > "$wakealarm"
	cat "$wakealarm" > "$out/wakealarm"
	stress_require_alive "before suspend"
	printf 'freeze\n' > /sys/power/state
	stress_require_alive "after resume"
	stress_stop
	check_tcrypt_run "$stress_label" "$stress_dmesg_lines" "$stress_irq_before" no
	timeout 180 "$tool" all > "$out/post-resume-af-alg.log" 2>&1
	run_exact_ce_suite post-resume
	select_and_probe_trng resume
fi

capture_diagnostics
if grep -Ei '(BUG:|Oops:|Kernel panic|Call trace:|iommu.*fault|sun50i-a133-ce.*(timeout|fault|error|failed|uncontained|quarantine))' \
	"$out/dmesg-delta" > "$out/kernel-errors"; then
	echo "new kernel fault or CE containment error during qualification" >&2
	exit 1
fi
printf 'PASS ce-trng qualification mode=%s zero-entropy-credit\n' "$mode" | tee "$out/RESULT"
