#!/bin/sh
set -eu

case "${1:-}" in
start) ;;
stop) exit 0 ;;
*) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac

case " $(cat /proc/cmdline) " in
	*" brick.bootdir=brick-diag "*) bootdir=brick-diag ;;
	*" brick.bootdir=brick-previous "*) bootdir=brick-previous ;;
	*" brick.bootdir=brick-baseline "*) bootdir=brick-baseline ;;
	*) exit 0 ;;
esac

device=/dev/mmcblk0p1
mountpoint=/run/brick-boot
state=$mountpoint/brick-bootcount
temporary=$mountpoint/.brick-bootcount.good.$$

[ "$(cat /sys/class/block/mmcblk0/device/type 2>/dev/null)" = SD ]
[ -b "$device" ]
[ -c /dev/watchdog ]
mkdir -p "$mountpoint"
mount -o rw,sync "$device" "$mountpoint"
cleanup() {
	rm -f "$temporary"
	umount "$mountpoint"
}
trap cleanup EXIT

(cd "$mountpoint/$bootdir" && sha256sum -c SHA256SUMS)

# Every selected slot inherits the handoff watchdog.  A verified recovery slot
# must stop it too, but must leave the failed candidate rejected so the next
# boot continues to use the recovery command.
printf V > /dev/watchdog

if [ "$bootdir" != brick-diag ]; then
	umount "$mountpoint"
	trap - EXIT
	exit 0
fi

# U-Boot bootcount_fs: magic, version, count=0, upgrade_available=0.
printf '\275\001\000\000' > "$temporary"
sync
mv "$temporary" "$state"
sync
umount "$mountpoint"
trap - EXIT
