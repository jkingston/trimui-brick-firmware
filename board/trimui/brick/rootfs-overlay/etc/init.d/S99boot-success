#!/bin/sh
set -eu

case "${1:-}" in
start) ;;
stop) exit 0 ;;
*) echo "Usage: $0 {start|stop}" >&2; exit 2 ;;
esac

case " $(cat /proc/cmdline) " in
	*" brick.bootdir=brick-diag "*) ;;
	*) exit 0 ;;
esac

device=/dev/mmcblk0p1
mountpoint=/run/brick-boot
state=$mountpoint/brick-bootcount
temporary=$mountpoint/.brick-bootcount.good.$$

[ "$(cat /sys/class/block/mmcblk0/device/type 2>/dev/null)" = SD ]
[ -b "$device" ]
[ -c /dev/watchdog ]
mkdir -p "$mountpoint"
mount -o rw,sync "$device" "$mountpoint"
cleanup() {
	rm -f "$temporary"
	umount "$mountpoint"
}
trap cleanup EXIT

(cd "$mountpoint/brick-diag" && sha256sum -c SHA256SUMS)

# The candidate reached late init with an intact payload. Stop the handoff
# watchdog before committing success so a later failure cannot repeatedly boot
# a candidate already recorded as good.
printf V > /dev/watchdog

# U-Boot bootcount_fs: magic, version, count=0, upgrade_available=0.
printf '\275\001\000\000' > "$temporary"
sync
mv "$temporary" "$state"
sync
umount "$mountpoint"
trap - EXIT
