#!/bin/sh
set -eu
state=/run/brick-usb-current
mkdir -p "$state"
exec 9>"$state/service.lock"
flock -x 9
daemon=/usr/sbin/brick-usb-current
pidfile="$state/pid"
case "${1:-}" in
start)
	start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
		--pidfile "$pidfile" --exec "$daemon" 9>&-
	;;
stop)
	/usr/libexec/brick-stop-daemon usb-current "$pidfile" "$daemon"
	;;
restart)
	/usr/libexec/brick-stop-daemon usb-current "$pidfile" "$daemon"
	exec 9>&-
	exec "$0" start
	;;
*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
