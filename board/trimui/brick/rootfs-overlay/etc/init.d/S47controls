#!/bin/sh
set -eu
mkdir -p /run/brick-controls
exec 9>/run/brick-controls/service.lock
flock -x 9
daemon=/usr/sbin/brick-controls
pidfile=/run/brick-controls/pid

case "${1:-}" in
start)
	case "$(cat /run/brick-data/state 2>/dev/null || true)" in
	persistent) settings=/data/settings/controls ;;
	volatile) settings=/run/brick-controls/settings ;;
	*) echo 'controls: persistent state unavailable' >&2; exit 1 ;;
	esac
	FN_MUTE=0
	[ ! -f /etc/default/brick-controls ] || . /etc/default/brick-controls
	set -- "$settings"
	case "$FN_MUTE" in
	0) ;;
	1) set -- "$@" --fn-mute ;;
	*) echo 'controls: FN_MUTE must be 0 or 1' >&2; exit 1 ;;
	esac
	start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
		--pidfile "$pidfile" --exec "$daemon" -- "$@" 9>&-
	;;
stop)
	/usr/libexec/brick-stop-daemon controls "$pidfile" "$daemon"
	;;
restart)
	/usr/libexec/brick-stop-daemon controls "$pidfile" "$daemon"
	exec 9>&-
	exec "$0" start
	;;
*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
