#!/bin/sh
# Persist DHCP metadata and start the non-blocking connectivity classifier.
set -eu
umask 077

state=${WIFI_STATE_DIR:-/run/brick-wifi}
connectivity=${WIFI_CONNECTIVITY:-/usr/libexec/brick-wifi-connectivity}
private_mac=${WIFI_PRIVATE_MAC:-/usr/libexec/brick-wifi-private-mac}
mkdir -p "$state"

network_id() {
	case ${WPA_ID:-} in
	''|*[!0-9]*) return 1 ;;
	*) printf '%s\n' "$WPA_ID" ;;
	esac
}

check_connectivity() {
	"$connectivity" check "$1" >/dev/null 2>&1 || return
	if grep -qx 'state=captive' "$state/connectivity" 2>/dev/null; then
		id=$(network_id) || return
		"$private_mac" mark-captive "$id" >/dev/null 2>&1 || :
	fi
}

decode_capport() {
	hex=${opt114:-}
	case $hex in
	''|*[!0-9A-Fa-f]*) return 1 ;;
	esac
	[ $(( ${#hex} % 2 )) -eq 0 ] || return 1
	uri=$(printf '%s\n' "$hex" | awk '
		BEGIN { digits = "0123456789abcdef" }
		{
			text = tolower($0)
			for (i = 1; i <= length(text); i += 2) {
				high = index(digits, substr(text, i, 1)) - 1
				low = index(digits, substr(text, i + 1, 1)) - 1
				value = high * 16 + low
				if (value < 33 || value > 126)
					exit 1
				printf "%c", value
			}
		}
	') || return 1
	[ ${#uri} -le 255 ] || return 1
	case $uri in
	https://*|urn:ietf:params:capport:unrestricted)
		printf '%s\n' "$uri"
		;;
	*)
		return 1
		;;
	esac
}

case ${1:-} in
bound|renew)
	capport_uri=$(decode_capport 2>/dev/null || :)
	rm -f "$state"/dhcp.tmp.*
	tmp="$state/dhcp.tmp.$$"
	trap 'rm -f "$tmp"' EXIT HUP INT TERM
	{
		printf 'interface=%s\n' "${interface:-}"
		printf 'address=%s\n' "${ip:-}"
		printf 'lease_seconds=%s\n' "${lease:-}"
		printf 'capport_uri=%s\n' "$capport_uri"
	} > "$tmp"
	[ -z "${WIFI_FAULT_HOOK:-}" ] || "$WIFI_FAULT_HOOK" dhcp-after-temp
	mv "$tmp" "$state/dhcp"
	[ -z "${WIFI_FAULT_HOOK:-}" ] || "$WIFI_FAULT_HOOK" dhcp-after-rename
	trap - EXIT HUP INT TERM
	if id=$(network_id); then
		case ${lease:-} in
		''|*[!0-9]*) ;;
		*) "$private_mac" lease "$id" "$lease" >/dev/null 2>&1 || : ;;
		esac
	fi
	check_connectivity "$capport_uri" &
	;;
deconfig|nak)
	rm -f "$state/dhcp"
	"$connectivity" clear >/dev/null 2>&1 &
	;;
esac

exit 0
