From: Jack Kingston <998656+jkingston@users.noreply.github.com>
Subject: [PATCH] sunxi: match the Brick secure-memory layout

Match the stock A133 secure-memory contract: keep BL31 in the
0x48000000..0x48040000 window, preserve the separate standby scratch
at 0x40020000, and leave 0x48040000 upward to the vendor SCP.

Signed-off-by: Jack Kingston <998656+jkingston@users.noreply.github.com>
---
diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -288,7 +288,8 @@
 config SUNXI_BL31_BASE
 	hex
 	default 0x00044000 if MACH_SUN50I || MACH_SUN50I_H5
-	default 0x40000000 if MACH_SUN50I_H616 || MACH_SUN50I_A133
+	default 0x40000000 if MACH_SUN50I_H616
+	default 0x48000000 if MACH_SUN50I_A133
 	default 0x00104000 if SUN50I_GEN_H6
 	default 0x00054000 if MACH_SUN55I_A523
 	default 0x0
diff --git a/arch/arm/mach-sunxi/a133_vendor_scp.c b/arch/arm/mach-sunxi/a133_vendor_scp.c
--- a/arch/arm/mach-sunxi/a133_vendor_scp.c
+++ b/arch/arm/mach-sunxi/a133_vendor_scp.c
@@ -42,10 +42,12 @@
 
 #define A133_SCP_FDT_STAGING_BASE	0x48fb0000UL
 #define A133_SCP_STAGING_BASE		0x48fe0000UL
-#define A133_TFA_BASE			0x40000000ULL
+#define A133_STANDBY_SCRATCH_BASE	0x40020000ULL
+#define A133_STANDBY_SCRATCH_SIZE	0x00000800ULL
+#define A133_TFA_BASE			0x48000000ULL
 #define A133_TFA_RESERVE_SIZE		0x00040000ULL
-#define A133_VENDOR_RESERVE_BASE	0x48000000ULL
-#define A133_VENDOR_RESERVE_SIZE	0x01000000ULL
+#define A133_VENDOR_RESERVE_BASE	0x48040000ULL
+#define A133_VENDOR_RESERVE_SIZE	0x00fc0000ULL
 
 #define A133_SCP_RESET_REG		SUNXI_R_CPUCFG_BASE
 #define A133_SCP_RESET_BIT		BIT(0)
@@ -341,6 +343,11 @@
 	if (ret)
 		return ret;
 
+	ret = a133_scp_add_reservation(fdt, A133_STANDBY_SCRATCH_BASE,
+				       A133_STANDBY_SCRATCH_SIZE);
+	if (ret)
+		return ret;
+
 	ret = a133_scp_add_reservation(fdt, A133_TFA_BASE,
 				       A133_TFA_RESERVE_SIZE);
 	if (ret)
diff --git a/configs/trimui-brick_defconfig b/configs/trimui-brick_defconfig
--- a/configs/trimui-brick_defconfig
+++ b/configs/trimui-brick_defconfig
@@ -33,11 +33,11 @@
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_HUSH_PARSER=y
 CONFIG_SUPPORT_RAW_INITRD=y
-CONFIG_BOOTCOMMAND="gpio set PH3; sleep 0.12; gpio clear PH3; setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-diag brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.zst && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x40000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init brick.bootdir=${brick_bootdir}; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD boot failed; while true; do sleep 1; done"
+CONFIG_BOOTCOMMAND="gpio set PH3; sleep 0.12; gpio clear PH3; setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-diag brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.zst && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x48000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init brick.bootdir=${brick_bootdir}; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD boot failed; while true; do sleep 1; done"
 CONFIG_BOOTCOUNT_LIMIT=y
 CONFIG_BOOTCOUNT_FS=y
 CONFIG_BOOTCOUNT_BOOTLIMIT=1
-CONFIG_BOOTCOUNT_ALTBOOTCMD="gpio set PH3; sleep 0.12; gpio clear PH3; setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.zst && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x40000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init brick.bootdir=${brick_bootdir}; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD recovery boot failed; while true; do sleep 1; done"
+CONFIG_BOOTCOUNT_ALTBOOTCMD="gpio set PH3; sleep 0.12; gpio clear PH3; setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.zst && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x48000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init brick.bootdir=${brick_bootdir}; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD recovery boot failed; while true; do sleep 1; done"
 CONFIG_SYS_BOOTCOUNT_FS_INTERFACE="mmc"
 CONFIG_SYS_BOOTCOUNT_FS_DEVPART="0:1"
 CONFIG_SYS_BOOTCOUNT_FS_NAME="/brick-bootcount"
