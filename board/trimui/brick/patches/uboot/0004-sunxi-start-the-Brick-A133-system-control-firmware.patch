diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index 318bbd97275..a7f2d88b6fe 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -7,6 +7,20 @@ config TRIMUI_BRICK_SD_DIAGNOSTIC
 	  Restrict persistent boot to removable SD while retaining volatile FEL
 	  recovery, and enable the Brick-specific PMIC rail table.
 
+config SUNXI_A133_VENDOR_SCP
+	bool "Experimental A133 vendor SCP boot boundary"
+	depends on TRIMUI_BRICK_SD_DIAGNOSTIC && SPL_LOAD_FIT && OF_BOARD_SETUP
+	select SPL_SHA256
+	help
+	  Load the exact Brick vendor SCP and its service device tree, export the
+	  parameters actually used by the native A133 DRAM initialization into the
+	  stock 32-word handoff, and release the SCP from reset. The feature is
+	  disabled by default and does not add a PSCI system-suspend implementation.
+
+	  SCP and SCP_FDT must name the two external build artifacts. The exporter
+	  accepts only the Brick's 672 MHz LPDDR3, 1 GiB, one-rank, 32-bit geometry;
+	  an unexpected native initialization result fails closed.
+
 config IDENT_STRING
 	default " Allwinner Technology"
 
@@ -285,6 +299,7 @@ config SUNXI_SCP_BASE
 	hex
 	default 0x00050000 if MACH_SUN50I || MACH_SUN50I_H5
 	default 0x00114000 if MACH_SUN50I_H6
+	default 0x00100000 if SUNXI_A133_VENDOR_SCP
 	default 0x0
 	help
 	  Address where SCP firmware is loaded, or zero if it is not used.
