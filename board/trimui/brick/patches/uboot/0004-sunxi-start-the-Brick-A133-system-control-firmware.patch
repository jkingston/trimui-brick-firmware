index 00000000000..764d25acea5
--- /dev/null
+++ b/tools/binman/etype/scp_fdt.py
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0+
+"""Binman entry for the vendor SCP service device tree."""
+
+from binman.etype.blob_named_by_arg import Entry_blob_named_by_arg
+
+
+class Entry_scp_fdt(Entry_blob_named_by_arg):
+    """External service FDT supplied with ``SCP_FDT``."""
+
+    def __init__(self, section, etype, node):
+        super().__init__(section, etype, node, 'scp-fdt')
+        self.external = True
