diff --git a/arch/arm/mach-sunxi/a133_vendor_scp.c b/arch/arm/mach-sunxi/a133_vendor_scp.c
new file mode 100644
index 00000000000..e0a21b6d55e
--- /dev/null
+++ b/arch/arm/mach-sunxi/a133_vendor_scp.c
@@ -0,0 +1,333 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Fail-closed boot boundary for the exact A133 vendor SCP used by the Brick.
+ *
+ * Stock boot0 validates its package, holds the SCP in reset, loads 0x14000
+ * bytes at 0x00100000, copies a post-training 128-byte DRAM block to 0x00104008
+ * and releases reset. It separately loads the SCP service FDT at 0x48100000.
+ * Keep that hardware contract while allowing stronger size/hash/error checks.
+ */
+
+#include <cpu_func.h>
+#include <fdt_support.h>
+#include <hang.h>
+#include <mapmem.h>
+#include <spl.h>
+#include <u-boot/sha256.h>
+#include <asm/arch/a133_vendor_scp.h>
+#include <asm/arch/cpu.h>
+#include <asm/barriers.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/libfdt.h>
+#include <linux/string.h>
+
+#define A133_SCP_RUNTIME_BASE		0x00100000UL
+#define A133_SCP_LOAD_SIZE		0x00014000UL
+#define A133_SCP_FILE_SIZE		0x00014008UL
+#define A133_SCP_VECTOR_FIRST		0x00000100UL
+#define A133_SCP_VECTOR_LAST		0x00000e00UL
+#define A133_SCP_VECTOR_STRIDE		0x00000100UL
+#define A133_SCP_VECTOR_SIZE		0x00000008UL
+#define A133_SCP_SRAM_OFFSET		0x00004000UL
+#define A133_SCP_SRAM_SIZE		0x00010000UL
+#define A133_SCP_DRAM_OFFSET		0x00004008UL
+#define A133_SCP_DRAM_SIZE		0x00000080UL
+
+#define A133_SCP_FDT_BASE		0x48100000UL
+#define A133_SCP_FDT_SIZE		0x00025600UL
+#define A133_SCP_FDT_MAX_SIZE		0x00040000UL
+
+#define A133_SCP_FDT_STAGING_BASE	0x48fb0000UL
+#define A133_SCP_STAGING_BASE		0x48fe0000UL
+#define A133_TFA_BASE			0x40000000ULL
+#define A133_TFA_RESERVE_SIZE		0x00040000ULL
+#define A133_VENDOR_RESERVE_BASE	0x48000000ULL
+#define A133_VENDOR_RESERVE_SIZE	0x01000000ULL
+
+#define A133_SCP_RESET_REG		SUNXI_R_CPUCFG_BASE
+#define A133_SCP_RESET_BIT		BIT(0)
+#define A133_SCP_RESET_POLLS		1000
+
+#define A133_SCP_HAVE_IMAGE		BIT(0)
+#define A133_SCP_HAVE_FDT		BIT(1)
+#define A133_SCP_HAVE_DRAM		BIT(2)
+#define A133_SCP_HAVE_ALL		(A133_SCP_HAVE_IMAGE | \
+					 A133_SCP_HAVE_FDT | \
+					 A133_SCP_HAVE_DRAM)
+
+#if defined(CONFIG_XPL_BUILD)
+static const u8 a133_scp_sha256[SHA256_SUM_LEN] = {
+	0xb2, 0x5e, 0xac, 0xb0, 0x50, 0xbc, 0x5c, 0x19,
+	0x24, 0x5b, 0xb3, 0xb0, 0x32, 0xf8, 0x85, 0x1f,
+	0x83, 0xbc, 0xd4, 0xe6, 0x34, 0xbb, 0x71, 0x11,
+	0xae, 0xe8, 0x11, 0xbd, 0x5b, 0xa8, 0xbb, 0xe8,
+};
+
+static const u8 a133_scp_fdt_sha256[SHA256_SUM_LEN] = {
+	0x06, 0xc8, 0x20, 0xc4, 0xfe, 0x4d, 0xf1, 0xef,
+	0xb4, 0x54, 0xfb, 0x57, 0x94, 0xe7, 0xe8, 0xa1,
+	0x85, 0x95, 0x6c, 0xb6, 0x60, 0xad, 0x33, 0x71,
+	0x1c, 0x36, 0x5a, 0xf6, 0x6a, 0x5c, 0xf7, 0xd8,
+};
+
+#define A133_SCP_DRAM_EMPTY_MAGIC	0x53435030U
+#define A133_SCP_DRAM_VALID_MAGIC	0x53435044U
+
+/* FIT callbacks run before SPL relocation; retain their state with .data. */
+static u8 a133_scp_loaded = A133_SCP_HAVE_ALL + 1;
+static struct {
+	u32 magic;
+	u32 words[A133_SCP_DRAM_SIZE / sizeof(u32)];
+} a133_scp_dram_handoff = {
+	.magic = A133_SCP_DRAM_EMPTY_MAGIC,
+};
+
+static int a133_scp_set_reset(bool asserted);
+
+int sunxi_a133_vendor_scp_set_dram_handoff(const u32 *words,
+					   unsigned int count)
+{
+	if (!words || count != ARRAY_SIZE(a133_scp_dram_handoff.words))
+		return -EINVAL;
+
+	memcpy(a133_scp_dram_handoff.words, words,
+	       sizeof(a133_scp_dram_handoff.words));
+	a133_scp_dram_handoff.magic = A133_SCP_DRAM_VALID_MAGIC;
+
+	return 0;
+}
+
+static int a133_scp_check_image(const struct spl_image_info *image,
+				ulong address, ulong size,
+				const u8 expected[SHA256_SUM_LEN])
+{
+	u8 digest[SHA256_SUM_LEN];
+	const void *data;
+
+	if (image->load_addr != address || image->size != size)
+		return -EMSGSIZE;
+
+	data = map_sysmem(address, size);
+	sha256_csum_wd(data, size, digest, CHUNKSZ_SHA256);
+	unmap_sysmem(data);
+
+	if (memcmp(digest, expected, sizeof(digest)))
+		return -EBADMSG;
+
+	return 0;
+}
+
+int board_spl_fit_prepare_loadables(void)
+{
+	a133_scp_loaded = a133_scp_dram_handoff.magic == A133_SCP_DRAM_VALID_MAGIC ?
+			  A133_SCP_HAVE_DRAM : 0;
+
+	return a133_scp_set_reset(true);
+}
+
+int board_spl_fit_loadable_post_load(const char *name,
+				     const struct spl_image_info *image)
+{
+	int ret;
+
+	if (!strcmp(name, "scp")) {
+		ret = a133_scp_check_image(image, A133_SCP_STAGING_BASE,
+					   A133_SCP_FILE_SIZE, a133_scp_sha256);
+		if (!ret)
+			a133_scp_loaded |= A133_SCP_HAVE_IMAGE;
+		return ret;
+	}
+
+	if (!strcmp(name, "scp-service-dtb")) {
+		if (image->size > A133_SCP_FDT_MAX_SIZE)
+			return -E2BIG;
+		ret = a133_scp_check_image(image, A133_SCP_FDT_STAGING_BASE,
+					   A133_SCP_FDT_SIZE,
+					   a133_scp_fdt_sha256);
+		if (!ret)
+			a133_scp_loaded |= A133_SCP_HAVE_FDT;
+		return ret;
+	}
+
+	return 0;
+}
+
+static int a133_scp_set_reset(bool asserted)
+{
+	void __iomem *reg = (void __iomem *)A133_SCP_RESET_REG;
+	u32 expected = asserted ? 0 : A133_SCP_RESET_BIT;
+	u32 value;
+	int i;
+
+	value = readl(reg);
+	if (asserted)
+		value &= ~A133_SCP_RESET_BIT;
+	else
+		value |= A133_SCP_RESET_BIT;
+	writel(value, reg);
+
+	for (i = 0; i < A133_SCP_RESET_POLLS; i++) {
+		if ((readl(reg) & A133_SCP_RESET_BIT) == expected)
+			return 0;
+	}
+
+	return -ETIMEDOUT;
+}
+
+/*
+ * The A133 CPU view exposes sparse OpenRISC vectors, then 64 KiB of SRAM.
+ * Match shipped Boot0's aligned word accesses without touching vector holes.
+ */
+static int a133_scp_copy_words(void *dst, const void *src, ulong size)
+{
+	ulong offset;
+
+	if (((ulong)dst | (ulong)src | size) & (sizeof(u32) - 1))
+		return -EINVAL;
+
+	for (offset = 0; offset < size; offset += sizeof(u32))
+		writel(*(const u32 *)((const u8 *)src + offset),
+		       (u8 *)dst + offset);
+	dsb();
+
+	for (offset = 0; offset < size; offset += sizeof(u32)) {
+		if (readl((u8 *)dst + offset) !=
+		    *(const u32 *)((const u8 *)src + offset))
+			return -EIO;
+	}
+
+	return 0;
+}
+
+static int a133_scp_copy_runtime(void *dst, const void *src)
+{
+	ulong offset;
+	int ret;
+
+	for (offset = A133_SCP_VECTOR_FIRST;
+	     offset <= A133_SCP_VECTOR_LAST;
+	     offset += A133_SCP_VECTOR_STRIDE) {
+		ret = a133_scp_copy_words((u8 *)dst + offset,
+					  (const u8 *)src + offset,
+					  A133_SCP_VECTOR_SIZE);
+		if (ret)
+			return ret;
+	}
+
+	return a133_scp_copy_words((u8 *)dst + A133_SCP_SRAM_OFFSET,
+				   (const u8 *)src + A133_SCP_SRAM_OFFSET,
+				   A133_SCP_SRAM_SIZE);
+}
+
+static int a133_scp_start(void)
+{
+	void *dram_dst, *fdt_dst, *fdt_src, *scp_dst, *scp_src;
+	int ret;
+
+	BUILD_BUG_ON(A133_SCP_RUNTIME_BASE % ARCH_DMA_MINALIGN);
+	BUILD_BUG_ON(A133_SCP_LOAD_SIZE % ARCH_DMA_MINALIGN);
+	BUILD_BUG_ON(A133_SCP_FDT_BASE % ARCH_DMA_MINALIGN);
+	BUILD_BUG_ON(A133_SCP_FDT_SIZE % ARCH_DMA_MINALIGN);
+
+	if (a133_scp_loaded != A133_SCP_HAVE_ALL)
+		return -ENODATA;
+
+	ret = a133_scp_set_reset(true);
+	if (ret)
+		return ret;
+
+	scp_src = map_sysmem(A133_SCP_STAGING_BASE, A133_SCP_LOAD_SIZE);
+	scp_dst = map_sysmem(A133_SCP_RUNTIME_BASE, A133_SCP_LOAD_SIZE);
+	ret = a133_scp_copy_runtime(scp_dst, scp_src);
+	if (ret)
+		goto out_unmap_scp;
+
+	fdt_src = map_sysmem(A133_SCP_FDT_STAGING_BASE, A133_SCP_FDT_SIZE);
+	fdt_dst = map_sysmem(A133_SCP_FDT_BASE, A133_SCP_FDT_SIZE);
+	ret = a133_scp_copy_words(fdt_dst, fdt_src, A133_SCP_FDT_SIZE);
+	if (ret)
+		goto out_unmap_fdt;
+
+	dram_dst = map_sysmem(A133_SCP_RUNTIME_BASE + A133_SCP_DRAM_OFFSET,
+			      A133_SCP_DRAM_SIZE);
+	ret = a133_scp_copy_words(dram_dst, a133_scp_dram_handoff.words,
+				  A133_SCP_DRAM_SIZE);
+	if (ret)
+		goto out_unmap_dram;
+
+	flush_dcache_range(A133_SCP_FDT_BASE,
+			   A133_SCP_FDT_BASE + A133_SCP_FDT_SIZE);
+	dsb();
+	ret = a133_scp_set_reset(false);
+
+out_unmap_dram:
+	unmap_sysmem(dram_dst);
+out_unmap_fdt:
+	unmap_sysmem(fdt_dst);
+	unmap_sysmem(fdt_src);
+out_unmap_scp:
+	unmap_sysmem(scp_dst);
+	unmap_sysmem(scp_src);
+
+	return ret;
+}
+
+void spl_board_prepare_for_boot(void)
+{
+	int ret = a133_scp_start();
+
+	if (ret) {
+		a133_scp_set_reset(true);
+		panic("A133 vendor SCP start failed: %d\n", ret);
+	}
+}
+#endif
+
+static int a133_scp_add_reservation(void *fdt, u64 start, u64 size)
+{
+	bool conflict = false;
+	u64 address, length;
+	int count, i;
+
+	count = fdt_num_mem_rsv(fdt);
+	if (count < 0)
+		return count;
+
+	for (i = 0; i < count; i++) {
+		if (fdt_get_mem_rsv(fdt, i, &address, &length))
+			return -FDT_ERR_BADOFFSET;
+		if (address <= start && length >= size &&
+		    start - address <= length - size)
+			return 0;
+		if ((address <= start && start - address < length) ||
+		    (start < address && address - start < size))
+			conflict = true;
+	}
+	if (conflict)
+		return -FDT_ERR_BADVALUE;
+
+	return fdt_add_mem_rsv(fdt, start, size);
+}
+
+int sunxi_a133_vendor_scp_reserve_fdt(void *fdt, struct bd_info *bd)
+{
+	int ret;
+
+	(void)bd;
+
+	ret = a133_scp_add_reservation(fdt, A133_SCP_RUNTIME_BASE,
+				       A133_SCP_LOAD_SIZE);
+	if (ret)
+		return ret;
+
+	ret = a133_scp_add_reservation(fdt, A133_TFA_BASE,
+				       A133_TFA_RESERVE_SIZE);
+	if (ret)
+		return ret;
+
+	return a133_scp_add_reservation(fdt, A133_VENDOR_RESERVE_BASE,
+					A133_VENDOR_RESERVE_SIZE);
+}
diff --git a/arch/arm/mach-sunxi/dram_sun50i_a133.c b/arch/arm/mach-sunxi/dram_sun50i_a133.c
index 261a342bb90..468490ae49f 100644
--- a/arch/arm/mach-sunxi/dram_sun50i_a133.c
+++ b/arch/arm/mach-sunxi/dram_sun50i_a133.c
@@ -18,6 +18,7 @@
 //#define DEBUG
 
 #include <asm/arch/clock.h>
+#include <asm/arch/a133_vendor_scp.h>
 #include <asm/arch/cpu.h>
 #include <asm/arch/dram.h>
 #include <asm/arch/prcm.h>
@@ -25,6 +26,7 @@
 #include <init.h>
 #include <linux/bitops.h>
 #include <linux/delay.h>
+#include <linux/errno.h>
 #include <log.h>
 
 #ifdef CONFIG_DRAM_SUNXI_PHY_ADDR_MAP_1
@@ -1203,9 +1205,92 @@ static const struct dram_para para = {
 	.tpr14 = CONFIG_DRAM_SUNXI_TPR14,
 };
 
+enum a133_stock_dram_word {
+	A133_DRAM_CLK,
+	A133_DRAM_TYPE,
+	A133_DRAM_DX_ODT,
+	A133_DRAM_DX_DRI,
+	A133_DRAM_CA_DRI,
+	A133_DRAM_PARA0,
+	A133_DRAM_PARA1,
+	A133_DRAM_PARA2,
+	A133_DRAM_MR0,
+	A133_DRAM_MR1,
+	A133_DRAM_MR2,
+	A133_DRAM_MR3,
+	A133_DRAM_MR4,
+	A133_DRAM_MR5,
+	A133_DRAM_MR6,
+	A133_DRAM_MR11,
+	A133_DRAM_MR12,
+	A133_DRAM_MR13,
+	A133_DRAM_MR14,
+	A133_DRAM_MR16,
+	A133_DRAM_MR17,
+	A133_DRAM_MR22,
+	A133_DRAM_TPR0,
+	A133_DRAM_TPR1,
+	A133_DRAM_TPR2,
+	A133_DRAM_TPR3,
+	A133_DRAM_TPR6,
+	A133_DRAM_TPR10,
+	A133_DRAM_TPR11,
+	A133_DRAM_TPR12,
+	A133_DRAM_TPR13,
+	A133_DRAM_TPR14,
+	A133_DRAM_WORDS,
+};
+
+static int a133_export_stock_dram_handoff(const struct dram_para *dram,
+					  const struct dram_config *config,
+					  unsigned long size)
+{
+	u32 words[A133_DRAM_WORDS] = {
+		[A133_DRAM_CLK] = dram->clk,
+		[A133_DRAM_TYPE] = dram->type,
+		[A133_DRAM_DX_ODT] = dram->dx_odt,
+		[A133_DRAM_DX_DRI] = dram->dx_dri,
+		[A133_DRAM_CA_DRI] = dram->ca_dri,
+		[A133_DRAM_PARA0] = dram->para0,
+		[A133_DRAM_MR1] = 0x83,
+		[A133_DRAM_MR2] = 0x1c,
+		[A133_DRAM_MR3] = 0x2,
+		[A133_DRAM_MR11] = dram->mr11,
+		[A133_DRAM_MR12] = dram->mr12,
+		[A133_DRAM_MR13] = dram->mr13,
+		[A133_DRAM_MR14] = dram->mr14,
+		[A133_DRAM_MR22] = dram->mr22,
+		[A133_DRAM_TPR0] = dram->tpr0,
+		[A133_DRAM_TPR1] = dram->tpr1,
+		[A133_DRAM_TPR2] = dram->tpr2,
+		[A133_DRAM_TPR3] = dram->tpr3,
+		[A133_DRAM_TPR6] = dram->tpr6,
+		[A133_DRAM_TPR10] = dram->tpr10,
