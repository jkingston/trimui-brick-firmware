+	if (dram->clk != 672 || dram->type != SUNXI_DRAM_TYPE_LPDDR3 ||
+	    size != 1024UL * 1024 * 1024 || config->cols != 10 ||
+	    config->rows != 15 || config->ranks != 0 || config->banks != 3 ||
+	    config->bankgrps != 0 || !config->bus_full_width)
+		return -EINVAL;
+
+	/* Stock A133 encoding: columns, rows, banks, then cached size in MiB. */
+	words[A133_DRAM_PARA1] = config->cols | config->rows << 4 |
+				 config->banks << 12;
+	words[A133_DRAM_PARA2] = (size >> 20) << 16;
