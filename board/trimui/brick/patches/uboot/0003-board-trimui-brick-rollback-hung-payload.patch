From: Jack Kingston <998656+jkingston@users.noreply.github.com>
Subject: [PATCH] board: trimui-brick: roll back a hung SD payload

Arm the SoC watchdog across the kernel handoff and count a pending payload's
boot attempts in a four-byte file on the boot FAT filesystem.  Give the current
payload one attempt, then boot only retained recovery payloads until userspace
publishes another candidate.

Signed-off-by: Jack Kingston <998656+jkingston@users.noreply.github.com>

--- a/configs/trimui-brick_defconfig
+++ b/configs/trimui-brick_defconfig
@@ -33,10 +33,19 @@ CONFIG_ENV_IS_NOWHERE=y
 CONFIG_USE_BOOTCOMMAND=y
 CONFIG_HUSH_PARSER=y
 CONFIG_SUPPORT_RAW_INITRD=y
-CONFIG_BOOTCOMMAND="setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-diag brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.gz && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x40000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD boot failed; while true; do sleep 1; done"
+CONFIG_BOOTCOMMAND="setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-diag brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.gz && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x40000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init brick.bootdir=${brick_bootdir}; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD boot failed; while true; do sleep 1; done"
+CONFIG_BOOTCOUNT_LIMIT=y
+CONFIG_BOOTCOUNT_FS=y
+CONFIG_BOOTCOUNT_BOOTLIMIT=1
+CONFIG_BOOTCOUNT_ALTBOOTCMD="setenv kernel_addr_r 0x42000000; setenv fdt_addr_r 0x44000000; setenv ramdisk_addr_r 0x45000000; for brick_bootdir in brick-previous brick-baseline; do if load mmc 0:1 ${kernel_addr_r} ${brick_bootdir}/Image && load mmc 0:1 ${ramdisk_addr_r} ${brick_bootdir}/initramfs.cpio.gz && setenv diag_rdsize ${filesize} && load mmc 0:1 ${fdt_addr_r} ${brick_bootdir}/brick-usb.dtb && fdt addr ${fdt_addr_r} && fdt resize 4096 && fdt rsvmem add 0x40000000 0x40000; then setenv bootargs console=ttyS0,115200 loglevel=8 rdinit=/init brick.bootdir=${brick_bootdir}; booti ${kernel_addr_r} ${ramdisk_addr_r}:${diag_rdsize} ${fdt_addr_r}; fi; done; echo SD recovery boot failed; while true; do sleep 1; done"
+CONFIG_SYS_BOOTCOUNT_FS_INTERFACE="mmc"
+CONFIG_SYS_BOOTCOUNT_FS_DEVPART="0:1"
+CONFIG_SYS_BOOTCOUNT_FS_NAME="/brick-bootcount"
+CONFIG_SYS_BOOTCOUNT_ADDR=0x45000000
+CONFIG_WATCHDOG_AUTOSTART=y
 CONFIG_TRIMUI_BRICK_SD_DIAGNOSTIC=y
 CONFIG_MMC_SUNXI_SLOT_EXTRA=-1
-# CONFIG_MMC_WRITE is not set
+CONFIG_MMC_WRITE=y
 # CONFIG_CMD_SAVEENV is not set
 # CONFIG_BOOTSTD is not set
 # CONFIG_DISTRO_DEFAULTS is not set
@@ -47,7 +56,7 @@
 # CONFIG_CMD_NET is not set
 # CONFIG_AXP_DISABLE_BOOT_ON_POWERON is not set
 # CONFIG_ENV_IS_IN_FAT is not set
-# CONFIG_FAT_WRITE is not set
+CONFIG_FAT_WRITE=y
 CONFIG_FS_FAT=y
 CONFIG_DOS_PARTITION=y
 CONFIG_CMD_FS_GENERIC=y
