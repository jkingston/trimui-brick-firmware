diff --git a/drivers/power/axp_spl.c b/drivers/power/axp_spl.c
index 0162ef5..8e71dfc 100644
--- a/drivers/power/axp_spl.c
+++ b/drivers/power/axp_spl.c
@@ -140,7 +140,25 @@ static int axp_set_dcdc(int dcdc_num, unsigned int mvolt)
 	if (mvolt == 0)
 		return pmic_bus_clrbits(reg->enable_reg, reg->enable_mask);
 
-	ret = pmic_bus_write(reg->volt_reg, axp_mvolt_to_cfg(mvolt, reg));
+	if (IS_ENABLED(CONFIG_TRIMUI_BRICK_SD_DIAGNOSTIC)) {
+		u8 old, value, check;
+
+		ret = pmic_bus_read(reg->volt_reg, &old);
+		if (ret)
+			return ret;
+		value = (old & ~reg->volt_mask) |
+			(axp_mvolt_to_cfg(mvolt, reg) & reg->volt_mask);
+		ret = pmic_bus_write(reg->volt_reg, value);
+		if (ret)
+			return ret;
+		ret = pmic_bus_read(reg->volt_reg, &check);
+		if (ret)
+			return ret;
+		if ((check & reg->volt_mask) != (value & reg->volt_mask))
+			return -EIO;
+	} else {
+		ret = pmic_bus_write(reg->volt_reg, axp_mvolt_to_cfg(mvolt, reg));
+	}
 	if (ret)
 		return ret;
 
diff --git a/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts b/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts
new file mode 100644
index 0000000..c5fa16c
--- /dev/null
+++ b/dts/upstream/src/arm64/allwinner/sun50i-a133-trimui-brick.dts
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * TrimUI Brick (A133P): what U-Boot needs to reach the kernel, the SD card
+ * and the PMIC. No regulator constraints here: SPL sets DCDC2 and DCDC3 to
+ * what TrimUI's boot0 leaves them at, and the LDOs as TrimUI's system has
+ * them (board/sunxi/board.c). The internal eMMC is left out on purpose.
+ */
+
+/dts-v1/;
+
+#include "sun50i-a100.dtsi"
+
+/ {
+	model = "TrimUI Brick";
+	compatible = "trimui,brick", "allwinner,sun50i-a100";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&mmc0 {
+	bus-width = <4>;
+	broken-cd;
+	status = "okay";
+};
+
+&r_i2c0 {
+	status = "okay";
+
+	axp717: pmic@34 {
+		compatible = "x-powers,axp717";
+		reg = <0x34>;
+	};
+};
+
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_pb_pins>;
+	status = "okay";
+};
