Subject: [PATCH] sunxi: retain the validated Brick SD boot and PMIC setup

Base: u-boot/u-boot 5e3b01c8466dbe45cd6a06299f8f4c7e8c1c2363
Initial Brick board/LPDDR3 support: ericreinsmidt/plastron
414735de1c10c950e99defff0f4acf6567f13375, buildroot/board/brick/u-boot/patches.
Additional changes preserve captured DRAM timings, mask/readback PMIC rail
writes, exclude internal MMC and persistent environment writes, and capture
read-only PMIC state. No power-key timing or CC/charger reconfiguration.

diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index b0c5d3c..318bbd9 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -1,5 +1,12 @@
 if ARCH_SUNXI
 
+config TRIMUI_BRICK_SD_DIAGNOSTIC
+	bool "TrimUI Brick removable-SD-only diagnostic boot"
+	depends on MACH_SUN50I_A133 && AXP717_POWER
+	help
+	  Restrict the diagnostic SPL to an SD boot source, and enable the
+	  Brick-specific PMIC rail table. This does not change power-key timing.
+
 config IDENT_STRING
 	default " Allwinner Technology"
 
@@ -267,7 +274,7 @@ config SUNXI_RVBAR_ALTERNATIVE
 config SUNXI_BL31_BASE
 	hex
 	default 0x00044000 if MACH_SUN50I || MACH_SUN50I_H5
-	default 0x40000000 if MACH_SUN50I_H616
+	default 0x40000000 if MACH_SUN50I_H616 || MACH_SUN50I_A133
 	default 0x00104000 if SUN50I_GEN_H6
 	default 0x00054000 if MACH_SUN55I_A523
 	default 0x0
@@ -689,6 +696,14 @@ config SUNXI_DRAM_A133_DDR4
 	  This option is the DDR4 timing used by the boot0 on A133 devices
 	  which use a DDR4 timing.
 
+config SUNXI_DRAM_A133_LPDDR3
+	bool "LPDDR3 boot0 timings on the A133 DRAM controller"
+	select SUNXI_DRAM_LPDDR3
+	depends on DRAM_SUN50I_A133
+	help
+	  This option is the LPDDR3 timing used by the boot0 on the TrimUI
+	  Brick, at 672 MHz.
+
 config SUNXI_DRAM_A133_LPDDR4
 	bool "LPDDR4 boot0 timings on the A133 DRAM controller"
 	select SUNXI_DRAM_LPDDR4
diff --git a/arch/arm/mach-sunxi/board.c b/arch/arm/mach-sunxi/board.c
index 432b1c1..b54efea 100644
--- a/arch/arm/mach-sunxi/board.c
+++ b/arch/arm/mach-sunxi/board.c
@@ -291,6 +291,11 @@ uint32_t sunxi_get_boot_device(void)
 {
 	int boot_source = sunxi_get_boot_source();
 
+	if (IS_ENABLED(CONFIG_TRIMUI_BRICK_SD_DIAGNOSTIC) &&
+	    boot_source != SUNXI_BOOTED_FROM_MMC0 &&
+	    boot_source != SUNXI_BOOTED_FROM_MMC0_HIGH)
+		panic("Brick diagnostic requires removable SD boot\n");
+
 	/*
 	 * When booting from the SD card or NAND memory, the "eGON.BT0"
 	 * signature is expected to be found in memory at the address 0x0004
diff --git a/arch/arm/mach-sunxi/clock_sun50i_h6.c b/arch/arm/mach-sunxi/clock_sun50i_h6.c
index 80004f1..741f865 100644
--- a/arch/arm/mach-sunxi/clock_sun50i_h6.c
+++ b/arch/arm/mach-sunxi/clock_sun50i_h6.c
@@ -42,6 +42,16 @@ void clock_init_safe(void)
 		setbits_le32(prcm + CCU_PRCM_PLL_LDO_CFG, 0x60000);
 	}
 
+	if (IS_ENABLED(CONFIG_MACH_SUN50I_A133)) {
+		/*
+		 * Both PLL LDOs on, at the output boot0 sets (TrimUI Brick:
+		 * 0x00040005). Without the second one the PLLs nothing enables
+		 * before Linux (video, audio, GPU, ...) never lock.
+		 */
+		clrsetbits_le32(prcm + CCU_PRCM_PLL_LDO_CFG, 0x70000,
+				0xA7000000 | 0x40005);
+	}
+
 	clock_set_pll1(408000000);
 
 	writel(CCM_PLL6_DEFAULT, ccm + CCU_H6_PLL6_CFG);
diff --git a/arch/arm/mach-sunxi/dram_sun50i_a133.c b/arch/arm/mach-sunxi/dram_sun50i_a133.c
index ca3e251..261a342 100644
--- a/arch/arm/mach-sunxi/dram_sun50i_a133.c
+++ b/arch/arm/mach-sunxi/dram_sun50i_a133.c
@@ -766,8 +766,9 @@ static void mctl_dfi_init(const struct dram_para *para)
 		mctl_mr_write(MRCTRL0_MR_ADDR(6), 0x862 & (~BIT(7)));
 		break;
 	case SUNXI_DRAM_TYPE_LPDDR3:
-		mctl_mr_write_lpddr3(1, 0xc3);	/* MR1: nWR=8, BL8 */
-		mctl_mr_write_lpddr3(2, 0xa);	/* MR2: RL=12, WL=6 */
+		/* As the TrimUI Brick's boot0: RL 14 / WL 8, as the PHY is set */
