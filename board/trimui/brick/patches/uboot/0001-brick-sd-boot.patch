diff --git a/arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c b/arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c
new file mode 100644
index 0000000..31d3521
--- /dev/null
+++ b/arch/arm/mach-sunxi/dram_timings/a133_lpddr3.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * A133 LPDDR3 timings, as the TrimUI Brick's boot0 leaves the controller at
+ * 672 MHz: read from the running controller, not computed, so valid at that
+ * clock only.
+ */
+#include <asm/io.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/dram.h>
+
+void mctl_set_timing_params(const struct dram_para *para)
+{
+	struct sunxi_mctl_ctl_reg *const mctl_ctl =
+		(struct sunxi_mctl_ctl_reg *)SUNXI_DRAM_CTL0_BASE;
+
+	writel(0x1011180f, &mctl_ctl->dramtmg[0]);
+	writel(0x00030318, &mctl_ctl->dramtmg[1]);
+	writel(0x04070d0c, &mctl_ctl->dramtmg[2]);
+	writel(0x0050500c, &mctl_ctl->dramtmg[3]);
+	writel(0x0902040a, &mctl_ctl->dramtmg[4]);
+	writel(0x05050503, &mctl_ctl->dramtmg[5]);
+	writel(0x02020005, &mctl_ctl->dramtmg[6]);
+	writel(0x00000202, &mctl_ctl->dramtmg[7]);
+	writel(0x04041004, &mctl_ctl->dramtmg[8]);
+	writel(0x00020208, &mctl_ctl->dramtmg[9]);
+	writel(0x000e0c05, &mctl_ctl->dramtmg[10]);
+	writel(0x440c021c, &mctl_ctl->dramtmg[11]);
+	writel(0x00000008, &mctl_ctl->dramtmg[12]);
+	writel(0x0a100002, &mctl_ctl->dramtmg[13]);
+	writel(0x0000004a, &mctl_ctl->dramtmg[14]);
+
+	writel(0x004f0112, &mctl_ctl->init[0]);
+	writel(0x01f20000, &mctl_ctl->init[1]);
+	writel(0x00000d05, &mctl_ctl->init[2]);
+	writel(0x0083001c, &mctl_ctl->init[3]);		/* MR1/MR2 */
+	writel(0x00020000, &mctl_ctl->init[4]);		/* MR3 */
+	writel(0x00100004, &mctl_ctl->init[5]);
+	writel(0, &mctl_ctl->init[6]);
+	writel(0, &mctl_ctl->init[7]);
+	writel(0, &mctl_ctl->dfimisc);
+
+	writel(0x0000066f, &mctl_ctl->rankctl);
+	writel(0x028c8006, &mctl_ctl->dfitmg0);
+	writel(0x00100202, &mctl_ctl->dfitmg1);
+	writel(0x00280047, &mctl_ctl->rfshtmg);
+}
diff --git a/board/sunxi/board.c b/board/sunxi/board.c
index 3d1afec..73a4ee4 100644
--- a/board/sunxi/board.c
+++ b/board/sunxi/board.c
@@ -12,6 +12,7 @@
 
 #include <clock_legacy.h>
 #include <dm.h>
+#include <dm/ofnode.h>
 #include <env.h>
 #include <hang.h>
 #include <i2c.h>
@@ -575,6 +576,7 @@ void sunxi_board_init(void)
 {
 	int power_failed = 0;
 
+
 	if (CONFIG_IS_ENABLED(SUNXI_LED_STATUS))
 		status_led_init();
 
@@ -589,6 +591,36 @@ void sunxi_board_init(void)
 	defined CONFIG_AXP803_POWER
 	power_failed = axp_init();
 
+#if defined(CONFIG_TRIMUI_BRICK_SD_DIAGNOSTIC)
+	/*
+	 * The TrimUI Brick's LDOs as TrimUI's system has them (voltages
+	 * 0x93-0x9f, then enables 0x90 and 0x91), read from the PMIC there;
+	 * ALDO2 at 3.3 V, as in TrimUI's boot-time table. TrimUI's boot0 turns
+	 * these on before the kernel; the kernel expects them on.
+	 */
+	if (!power_failed) {
+		static const u8 brick_ldo[][2] = {
+			{ 0x93, 0x0d }, { 0x94, 0x1c }, { 0x95, 0x1c }, { 0x96, 0x0d },
+			{ 0x97, 0x1c }, { 0x98, 0x0d }, { 0x99, 0x1c }, { 0x9a, 0x0d },
+			{ 0x9b, 0x0d }, { 0x9c, 0x1c }, { 0x9d, 0x1c }, { 0x9e, 0x1c },
+			{ 0x9f, 0x08 }, { 0x90, 0x7e }, { 0x91, 0xdd },
+		};
+		for (int i = 0; i < ARRAY_SIZE(brick_ldo); i++) {
+			u8 reg = brick_ldo[i][0];
+			u8 mask = reg == 0x90 ? 0xff : 0x1f;
+			u8 old, value, check;
+
+			/* Preserve bits outside the documented voltage/enable fields. */
+			if (pmic_bus_read(reg, &old))
+				panic("Brick PMIC rail read failed\n");
+			value = (old & ~mask) | (brick_ldo[i][1] & mask);
+			if (pmic_bus_write(reg, value) ||
+			    pmic_bus_read(reg, &check) || (check & mask) != (value & mask))
+				panic("Brick PMIC rail setup failed\n");
+		}
+	}
+#endif
+
 	if (IS_ENABLED(CONFIG_AXP_DISABLE_BOOT_ON_POWERON) && !power_failed) {
 		u8 boot_reason;
 
@@ -652,12 +684,15 @@ void sunxi_board_init(void)
 	power_failed |= axp_set_sw(IS_ENABLED(CONFIG_AXP_SW_ON));
 #endif
 #endif	/* CONFIG_AXPxxx_POWER */
+	if (IS_ENABLED(CONFIG_TRIMUI_BRICK_SD_DIAGNOSTIC) && power_failed)
+		panic("Brick PMIC initialization failed\n");
 	printf("DRAM:");
 	gd->ram_size = sunxi_dram_init();
 	printf(" %d MiB\n", (int)(gd->ram_size >> 20));
 	if (!gd->ram_size)
 		hang();
 
+
 	sunxi_spl_store_dram_size(gd->ram_size);
 
 	/*
@@ -928,6 +963,74 @@ static void board_dt_fixup(void *blob)
 	}
 }
 
+/* Read-only PMIC evidence after SPL, before Linux. Never configure charging. */
+static void brick_pmic_snapshot(void *blob)
+{
+	static const u8 registers[] = { 0x0b, 0x17, 0xe1, 0xe3, 0x00, 0xe7 };
+	struct udevice *bus, *chip;
+	char snapshot[192];
+	const char *phase = "bus-node";
+	ofnode node;
+	size_t used;
+	u8 value;
+	int ret, chosen;
+	unsigned int i;
+
+	if (!IS_ENABLED(CONFIG_TRIMUI_BRICK_SD_DIAGNOSTIC) ||
+	    !IS_ENABLED(CONFIG_DM_I2C) ||
+	    fdt_node_check_compatible(gd->fdt_blob, 0, "trimui,brick") ||
+	    fdt_node_check_compatible(blob, 0, "trimui,brick"))
+		return;
+
+	used = snprintf(snapshot, sizeof(snapshot), "stage=post-spl-pre-linux ");
+	/* Resolve the enabled bus in U-Boot's control DT, not Linux's DT. */
+	node = ofnode_path("/soc/i2c@7081400");
+	ret = -ENODEV;
+	if (!ofnode_valid(node))
+		goto record;
+	phase = "bus";
+	ret = uclass_get_device_by_ofnode(UCLASS_I2C, node, &bus);
+	if (ret)
+		goto record;
+	phase = "chip";
+	/* No bus scan or address probe; this obtains the fixed chip only. */
+	ret = i2c_get_chip(bus, 0x34, 1, &chip);
+	if (ret)
+		goto record;
+	phase = "offset-length";
+	ret = i2c_set_chip_offset_len(chip, 1);
+	if (ret)
+		goto record;
+	phase = "read";
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		/* Register-select byte plus read, never a PMIC data write.
+		 * MVTWSI has finite per-phase timeouts. Stop at first error,
+		 * including its positive encoded errors; never retry here.
+		 */
+		ret = dm_i2c_read(chip, registers[i], &value, 1);
+		if (ret) {
+			used += snprintf(snapshot + used, sizeof(snapshot) - used,
+					 "failed-reg=%02x ", registers[i]);
+			break;
+		}
+		used += snprintf(snapshot + used, sizeof(snapshot) - used,
+				 "%02x=%02x ", registers[i], value);
+	}
+record:
+	snprintf(snapshot + used, sizeof(snapshot) - used,
+		 "phase=%s rc=%d\n", phase, ret);
+	chosen = fdt_path_offset(blob, "/chosen");
+	if (chosen < 0)
+		chosen = fdt_add_subnode(blob, 0, "chosen");
+	if (chosen >= 0) {
+		ret = fdt_setprop_string(blob, chosen, "brick,pmic-snapshot", snapshot);
+		if (ret)
+			printf("Brick PMIC snapshot property failed: %d\n", ret);
+	} else {
+		printf("Brick PMIC snapshot chosen node failed: %d\n", chosen);
+	}
+}
+
 int ft_board_setup(void *blob, struct bd_info *bd)
 {
 	int __maybe_unused r;
@@ -942,6 +1045,7 @@ int ft_board_setup(void *blob, struct bd_info *bd)
 
 	bluetooth_dt_fixup(blob);
 	board_dt_fixup(blob);
+	brick_pmic_snapshot(blob);
 
 #ifdef CONFIG_VIDEO_DT_SIMPLEFB
 	r = sunxi_simplefb_setup(blob);
