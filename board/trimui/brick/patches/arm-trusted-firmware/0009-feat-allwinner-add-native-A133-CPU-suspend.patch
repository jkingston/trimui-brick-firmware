+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#ifndef SUNXI_A133_PM_DISPATCH_H
+#define SUNXI_A133_PM_DISPATCH_H
+
+#include <stdint.h>
+
+#include <sunxi_a133_cpuidle.h>
+
+struct sunxi_a133_pm_backend {
+	void *cookie;
+	int (*system_prepare)(void *cookie, const void *target_state,
+			      uintptr_t affinity);
+	int (*system_commit)(void *cookie);
+	int (*system_finish)(void *cookie);
+	void (*cpuif_disable)(void *cookie);
+	void (*local_power_off)(void *cookie, unsigned int hardware_level);
+	void (*pcpu_distif_init)(void *cookie);
+	void (*cpuif_enable)(void *cookie);
+};
+
+int sunxi_a133_pm_dispatch_early(const struct sunxi_a133_pm_backend *backend,
+				enum sunxi_a133_suspend_kind kind,
+				const void *target_state, uintptr_t affinity);
+int sunxi_a133_pm_dispatch_suspend(const struct sunxi_a133_pm_backend *backend,
+				  enum sunxi_a133_suspend_kind kind);
+int sunxi_a133_pm_dispatch_finish(const struct sunxi_a133_pm_backend *backend,
+				 enum sunxi_a133_suspend_kind kind);
+
+#endif /* SUNXI_A133_PM_DISPATCH_H */
diff --git a/plat/allwinner/common/sunxi_a133_pm_dispatch.c b/plat/allwinner/common/sunxi_a133_pm_dispatch.c
new file mode 100644
index 0000000..789d84e
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_pm_dispatch.c
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stddef.h>
+
+#include <sunxi_a133_pm_dispatch.h>
+
+#define SUNXI_A133_DISPATCH_OK		0
+#define SUNXI_A133_DISPATCH_INVALID	(-1)
+
+static int backend_valid(const struct sunxi_a133_pm_backend *backend)
+{
+	return (backend != NULL) && (backend->cpuif_disable != NULL) &&
+	       (backend->local_power_off != NULL) &&
+	       (backend->pcpu_distif_init != NULL) &&
+	       (backend->cpuif_enable != NULL);
+}
+
+int sunxi_a133_pm_dispatch_early(const struct sunxi_a133_pm_backend *backend,
+				enum sunxi_a133_suspend_kind kind,
+				const void *target_state, uintptr_t affinity)
+{
+	if (!backend_valid(backend)) {
+		return SUNXI_A133_DISPATCH_INVALID;
+	}
+	if ((kind == SUNXI_A133_SUSPEND_CORE) ||
+	    (kind == SUNXI_A133_SUSPEND_CLUSTER)) {
+		return SUNXI_A133_DISPATCH_OK;
+	}
+	if ((kind == SUNXI_A133_SUSPEND_SYSTEM) &&
+	    (backend->system_prepare != NULL)) {
+		return backend->system_prepare(backend->cookie, target_state,
+					       affinity);
+	}
+	return SUNXI_A133_DISPATCH_INVALID;
+}
+
+int sunxi_a133_pm_dispatch_suspend(const struct sunxi_a133_pm_backend *backend,
+				  enum sunxi_a133_suspend_kind kind)
+{
+	unsigned int hardware_level;
+
+	if (!backend_valid(backend)) {
+		return SUNXI_A133_DISPATCH_INVALID;
+	}
+	if ((kind == SUNXI_A133_SUSPEND_CORE) ||
+	    (kind == SUNXI_A133_SUSPEND_CLUSTER)) {
+		hardware_level = kind == SUNXI_A133_SUSPEND_CORE ?
+			SUNXI_A133_CPUIDLE_CORE_LEVEL :
+			SUNXI_A133_CPUIDLE_CLUSTER_LEVEL;
+		backend->cpuif_disable(backend->cookie);
+		backend->local_power_off(backend->cookie, hardware_level);
+		return SUNXI_A133_DISPATCH_OK;
+	}
+	if ((kind == SUNXI_A133_SUSPEND_SYSTEM) &&
+	    (backend->system_commit != NULL)) {
+		return backend->system_commit(backend->cookie);
+	}
+	return SUNXI_A133_DISPATCH_INVALID;
+}
+
+int sunxi_a133_pm_dispatch_finish(const struct sunxi_a133_pm_backend *backend,
+				 enum sunxi_a133_suspend_kind kind)
+{
+	int ret;
+
+	if (!backend_valid(backend)) {
+		return SUNXI_A133_DISPATCH_INVALID;
+	}
+	if ((kind == SUNXI_A133_SUSPEND_CORE) ||
+	    (kind == SUNXI_A133_SUSPEND_CLUSTER)) {
+		backend->pcpu_distif_init(backend->cookie);
+		backend->cpuif_enable(backend->cookie);
+		return SUNXI_A133_DISPATCH_OK;
+	}
+	if ((kind == SUNXI_A133_SUSPEND_SYSTEM) &&
+	    (backend->system_finish != NULL)) {
+		ret = backend->system_finish(backend->cookie);
+		if (ret == SUNXI_A133_DISPATCH_OK) {
+			backend->cpuif_enable(backend->cookie);
+		}
+		return ret;
+	}
+	return SUNXI_A133_DISPATCH_INVALID;
+}
