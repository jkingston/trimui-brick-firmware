+static int sunxi_a133_validate_power_state(unsigned int power_state,
+					   psci_power_state_t *target_state)
+{
+	uint8_t states[PLAT_MAX_PWR_LVL + 1U];
+	unsigned int level;
+
+	assert(target_state != NULL);
+	if (sunxi_a133_cpuidle_decode(power_state, states) != 0) {
+		return PSCI_E_INVALID_PARAMS;
