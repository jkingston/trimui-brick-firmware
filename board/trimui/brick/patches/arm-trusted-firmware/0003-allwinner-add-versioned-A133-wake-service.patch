diff --git a/plat/allwinner/common/sunxi_a133_native_svc.c b/plat/allwinner/common/sunxi_a133_native_svc.c
new file mode 100644
index 0000000..883b92e
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_native_svc.c
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifndef SUNXI_A133_NATIVE_SVC_HOST_TEST
+#include <common/runtime_svc.h>
+#include <lib/smccc.h>
+
+#include <sunxi_a133_vendor_scp_runtime.h>
+#endif
+
+#include <sunxi_a133_native_svc.h>
+#include <sunxi_vendor_scp.h>
+
+static uint32_t map_transport_status(int status)
+{
+	switch (status) {
+	case SUNXI_VENDOR_SCP_OK:
+		return SUNXI_A133_SIP_SUCCESS;
+	case SUNXI_VENDOR_SCP_EINVAL:
+		return SUNXI_A133_SIP_INVALID_PARAMETER;
+	case SUNXI_VENDOR_SCP_ETIMEOUT:
+		return SUNXI_A133_SIP_TIMEOUT;
+	case SUNXI_VENDOR_SCP_ENOTREADY:
+		return SUNXI_A133_SIP_NOT_READY;
+	case SUNXI_VENDOR_SCP_EPOISONED:
+		return SUNXI_A133_SIP_POISONED;
+	case SUNXI_VENDOR_SCP_EPROTO:
+		return SUNXI_A133_SIP_PROTOCOL_ERROR;
+	default:
+		return SUNXI_A133_SIP_PROTOCOL_ERROR;
+	}
+}
+
+static uint32_t abi_capabilities(
+	const struct sunxi_a133_native_svc_backend *backend)
+{
+	uint32_t transport;
+
+	if ((backend == NULL) || (backend->capabilities == NULL) ||
+	    (backend->set_wake_source == NULL) ||
+	    (backend->clear_wake_source == NULL)) {
+		return 0U;
+	}
+
+	transport = backend->capabilities(backend->cookie);
+	if ((transport & SUNXI_VENDOR_SCP_CAP_WAKE_SOURCE) == 0U) {
+		return 0U;
+	}
+
+	return SUNXI_A133_SIP_CAP_WAKE_SOURCE |
+	       SUNXI_A133_SIP_CAP_RAW_SPI_INDEX;
+}
+
+static void dispatch_wake_source(
+	const struct sunxi_a133_native_svc_backend *backend, bool set,
+	uint32_t wake_source, uint32_t x2, uint32_t x3, uint32_t x4,
+	struct sunxi_a133_native_svc_response *response)
+{
+	uint8_t scp_result = 0U;
+	int ret;
+
+	if ((wake_source >= SUNXI_A133_SIP_NUM_SPI_INDICES) ||
+	    (x2 != 0U) || (x3 != 0U) || (x4 != 0U)) {
+		response->x0 = SUNXI_A133_SIP_INVALID_PARAMETER;
+		return;
+	}
+	if ((abi_capabilities(backend) & SUNXI_A133_SIP_CAP_WAKE_SOURCE) == 0U) {
+		response->x0 = SUNXI_A133_SIP_NOT_READY;
+		return;
+	}
+
+	if (set) {
+		ret = backend->set_wake_source(backend->cookie, wake_source,
+					       &scp_result);
+	} else {
+		ret = backend->clear_wake_source(backend->cookie, wake_source,
+						 &scp_result);
+	}
+	response->x0 = map_transport_status(ret);
+	response->x1 = scp_result;
+	if ((ret == SUNXI_VENDOR_SCP_OK) && (scp_result != 0U)) {
+		response->x0 = SUNXI_A133_SIP_REMOTE_ERROR;
+	}
+}
+
+void sunxi_a133_native_svc_dispatch(
+	const struct sunxi_a133_native_svc_backend *backend,
+	bool non_secure, uint32_t smc_fid, uint32_t x1, uint32_t x2,
+	uint32_t x3, uint32_t x4,
+	struct sunxi_a133_native_svc_response *response)
+{
+	*response = (struct sunxi_a133_native_svc_response){ 0U };
+	if (!non_secure) {
+		response->x0 = SUNXI_A133_SIP_NOT_SUPPORTED;
+		return;
+	}
+
+	switch (smc_fid) {
+	case SUNXI_A133_SIP_CALL_COUNT:
+		response->x0 = SUNXI_A133_SIP_NUM_CALLS;
+		break;
+	case SUNXI_A133_SIP_UID:
+		response->x0 = SUNXI_A133_SIP_UID_WORD0;
+		response->x1 = SUNXI_A133_SIP_UID_WORD1;
+		response->x2 = SUNXI_A133_SIP_UID_WORD2;
+		response->x3 = SUNXI_A133_SIP_UID_WORD3;
+		break;
+	case SUNXI_A133_SIP_VERSION:
+		response->x0 = SUNXI_A133_SIP_VERSION_MAJOR;
+		response->x1 = SUNXI_A133_SIP_VERSION_MINOR;
+		break;
+	case SUNXI_A133_SIP_CAPABILITIES:
+		response->x0 = SUNXI_A133_SIP_SUCCESS;
+		response->x1 = abi_capabilities(backend);
+		break;
+	case SUNXI_A133_SIP_SET_WAKE_SOURCE:
+		dispatch_wake_source(backend, true, x1, x2, x3, x4,
+				     response);
+		break;
+	case SUNXI_A133_SIP_CLEAR_WAKE_SOURCE:
+		dispatch_wake_source(backend, false, x1, x2, x3, x4,
+				     response);
+		break;
+	default:
+		response->x0 = SUNXI_A133_SIP_NOT_SUPPORTED;
+		break;
+	}
+}
+
+#ifndef SUNXI_A133_NATIVE_SVC_HOST_TEST
+static uint32_t runtime_capabilities(void *cookie)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_capabilities();
+}
+
+static int runtime_set_wake_source(void *cookie, uint32_t wake_source,
+				   uint8_t *scp_result)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_set_wake_source(wake_source,
+							   scp_result);
+}
+
+static int runtime_clear_wake_source(void *cookie, uint32_t wake_source,
+				     uint8_t *scp_result)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_clear_wake_source(wake_source,
+							     scp_result);
+}
+
+static const struct sunxi_a133_native_svc_backend runtime_backend = {
+	.capabilities = runtime_capabilities,
+	.set_wake_source = runtime_set_wake_source,
+	.clear_wake_source = runtime_clear_wake_source,
+};
+
+static int32_t sunxi_a133_native_svc_setup(void)
+{
+	return 0;
+}
+
+static uintptr_t sunxi_a133_native_svc_handler(uint32_t smc_fid,
+					       u_register_t x1,
+					       u_register_t x2,
+					       u_register_t x3,
+					       u_register_t x4,
+					       void *cookie,
+					       void *handle,
+					       u_register_t flags)
+{
+	struct sunxi_a133_native_svc_response response;
+
+	(void)cookie;
+	sunxi_a133_native_svc_dispatch(&runtime_backend,
+		is_caller_non_secure(flags), smc_fid, (uint32_t)x1,
+		(uint32_t)x2, (uint32_t)x3, (uint32_t)x4, &response);
+	SMC_RET4(handle, response.x0, response.x1, response.x2, response.x3);
+}
+
+DECLARE_RT_SVC(
+	sunxi_a133_native_svc,
+	OEN_SIP_START,
+	OEN_SIP_END,
+	SMC_TYPE_FAST,
+	sunxi_a133_native_svc_setup,
+	sunxi_a133_native_svc_handler
+);
+#endif
diff --git a/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c b/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c
new file mode 100644
index 0000000..93f8936
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stdbool.h>
+
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <lib/spinlock.h>
+#include <plat/common/platform.h>
+
+#include <sunxi_a133_vendor_scp.h>
+#include <sunxi_a133_vendor_scp_runtime.h>
+#include <sunxi_def.h>
+
+static struct sunxi_a133_vendor_scp a133_vendor_scp;
+static spinlock_t a133_vendor_scp_lock;
+
+static uint64_t runtime_timeout_ticks(void)
+{
+	return plat_get_syscnt_freq2() / 2U;
+}
+
+void sunxi_a133_vendor_scp_runtime_setup(void)
+{
+	uint64_t now = read_cntpct_el0();
+	int ret;
+
+	ret = sunxi_a133_vendor_scp_init(&a133_vendor_scp,
+					 SUNXI_MSGBOX_BASE);
+	if (ret == SUNXI_VENDOR_SCP_OK) {
+		ret = sunxi_a133_vendor_scp_startup(&a133_vendor_scp,
+						   (uint32_t)now,
+						   runtime_timeout_ticks());
+	}
+
+	if (ret == SUNXI_VENDOR_SCP_OK) {
+		NOTICE("BL31: A133 vendor SCP transport ready\n");
+	} else {
+		WARN("BL31: A133 vendor SCP startup failed: %d\n", ret);
+	}
+}
+
+uint32_t sunxi_a133_vendor_scp_runtime_capabilities(void)
+{
+	uint32_t capabilities;
+
+	spin_lock(&a133_vendor_scp_lock);
+	capabilities = sunxi_vendor_scp_capabilities(
+		&a133_vendor_scp.transport);
+	spin_unlock(&a133_vendor_scp_lock);
+
+	return capabilities;
+}
+
+static int runtime_wake_source(bool set, uint32_t wake_source,
+			       uint8_t *scp_result)
+{
+	int ret;
+
+	spin_lock(&a133_vendor_scp_lock);
+	if (set) {
+		ret = sunxi_vendor_scp_set_wake_source(
+			&a133_vendor_scp.transport, wake_source, scp_result,
+			runtime_timeout_ticks());
+	} else {
+		ret = sunxi_vendor_scp_clear_wake_source(
+			&a133_vendor_scp.transport, wake_source, scp_result,
+			runtime_timeout_ticks());
+	}
+	spin_unlock(&a133_vendor_scp_lock);
+
+	return ret;
+}
+
+int sunxi_a133_vendor_scp_runtime_set_wake_source(uint32_t wake_source,
+						 uint8_t *scp_result)
+{
+	return runtime_wake_source(true, wake_source, scp_result);
+}
+
+int sunxi_a133_vendor_scp_runtime_clear_wake_source(uint32_t wake_source,
+						   uint8_t *scp_result)
+{
+	return runtime_wake_source(false, wake_source, scp_result);
+}
