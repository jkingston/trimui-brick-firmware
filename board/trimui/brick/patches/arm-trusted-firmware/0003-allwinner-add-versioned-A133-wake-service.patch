diff --git a/plat/allwinner/common/tests/test_sunxi_a133_native_svc.c b/plat/allwinner/common/tests/test_sunxi_a133_native_svc.c
new file mode 100644
index 0000000..dc3c180
--- /dev/null
+++ b/plat/allwinner/common/tests/test_sunxi_a133_native_svc.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include <sunxi_a133_native_svc.h>
+#include <sunxi_vendor_scp.h>
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+
+struct fake_backend {
+	uint32_t capabilities;
+	uint32_t last_wake_source;
+	unsigned int capability_calls;
+	unsigned int set_calls;
+	unsigned int clear_calls;
+	int status;
+	uint8_t result;
+};
+
+static uint32_t fake_capabilities(void *cookie)
+{
+	struct fake_backend *fake = cookie;
+
+	fake->capability_calls++;
+	return fake->capabilities;
+}
+
+static int fake_set(void *cookie, uint32_t wake_source, uint8_t *result)
+{
+	struct fake_backend *fake = cookie;
+
+	fake->set_calls++;
+	fake->last_wake_source = wake_source;
+	*result = fake->result;
+	return fake->status;
+}
+
+static int fake_clear(void *cookie, uint32_t wake_source, uint8_t *result)
+{
+	struct fake_backend *fake = cookie;
+
+	fake->clear_calls++;
+	fake->last_wake_source = wake_source;
+	*result = fake->result;
+	return fake->status;
+}
+
+static void init_backend(struct fake_backend *fake,
+			 struct sunxi_a133_native_svc_backend *backend)
+{
+	*fake = (struct fake_backend){
+		.capabilities = SUNXI_VENDOR_SCP_CAP_WAKE_SOURCE,
+	};
+	*backend = (struct sunxi_a133_native_svc_backend){
+		.cookie = fake,
+		.capabilities = fake_capabilities,
+		.set_wake_source = fake_set,
+		.clear_wake_source = fake_clear,
+	};
+}
+
+static struct sunxi_a133_native_svc_response dispatch(
+	const struct sunxi_a133_native_svc_backend *backend, bool non_secure,
+	uint32_t fid, uint32_t x1, uint32_t x2, uint32_t x3, uint32_t x4)
+{
+	struct sunxi_a133_native_svc_response response;
+
+	sunxi_a133_native_svc_dispatch(backend, non_secure, fid, x1, x2,
+				       x3, x4, &response);
+	return response;
+}
+
+static void test_discovery_is_stable(void)
+{
+	struct sunxi_a133_native_svc_response response;
+
+	response = dispatch(NULL, true, SUNXI_A133_SIP_CALL_COUNT,
+			    0U, 0U, 0U, 0U);
+	assert(response.x0 == SUNXI_A133_SIP_NUM_CALLS);
+	response = dispatch(NULL, true, SUNXI_A133_SIP_UID, 0U, 0U, 0U, 0U);
+	assert(response.x0 == SUNXI_A133_SIP_UID_WORD0);
+	assert(response.x1 == SUNXI_A133_SIP_UID_WORD1);
+	assert(response.x2 == SUNXI_A133_SIP_UID_WORD2);
+	assert(response.x3 == SUNXI_A133_SIP_UID_WORD3);
+	response = dispatch(NULL, true, SUNXI_A133_SIP_VERSION,
+			    0U, 0U, 0U, 0U);
+	assert(response.x0 == SUNXI_A133_SIP_VERSION_MAJOR);
+	assert(response.x1 == SUNXI_A133_SIP_VERSION_MINOR);
+}
+
+static void test_security_and_unknown_calls(void)
+{
+	struct sunxi_a133_native_svc_response response;
+
+	response = dispatch(NULL, false, SUNXI_A133_SIP_UID, 0U, 0U, 0U, 0U);
+	assert(response.x0 == UINT32_MAX);
+	response = dispatch(NULL, true, 0x82000103U, 0U, 0U, 0U, 0U);
+	assert(response.x0 == UINT32_MAX);
+	response = dispatch(NULL, true, 0xc2000100U, 0U, 0U, 0U, 0U);
+	assert(response.x0 == UINT32_MAX);
+}
+
+static void test_capability_requires_ready_complete_backend(void)
+{
+	struct sunxi_a133_native_svc_backend backend;
+	struct sunxi_a133_native_svc_response response;
+	struct fake_backend fake;
+
+	init_backend(&fake, &backend);
+	response = dispatch(&backend, true, SUNXI_A133_SIP_CAPABILITIES,
+			    0U, 0U, 0U, 0U);
+	assert(response.x0 == SUNXI_A133_SIP_SUCCESS);
+	assert(response.x1 == (SUNXI_A133_SIP_CAP_WAKE_SOURCE |
+			       SUNXI_A133_SIP_CAP_RAW_SPI_INDEX));
+
+	fake.capabilities = 0U;
+	response = dispatch(&backend, true, SUNXI_A133_SIP_CAPABILITIES,
+			    0U, 0U, 0U, 0U);
+	assert(response.x1 == 0U);
+	backend.clear_wake_source = NULL;
+	fake.capabilities = SUNXI_VENDOR_SCP_CAP_WAKE_SOURCE;
+	response = dispatch(&backend, true, SUNXI_A133_SIP_CAPABILITIES,
+			    0U, 0U, 0U, 0U);
+	assert(response.x1 == 0U);
+}
+
+static void test_raw_spi_set_and_clear(void)
+{
+	struct sunxi_a133_native_svc_backend backend;
+	struct sunxi_a133_native_svc_response response;
+	struct fake_backend fake;
+
+	init_backend(&fake, &backend);
+	response = dispatch(&backend, true, SUNXI_A133_SIP_SET_WAKE_SOURCE,
+			    0x67U, 0U, 0U, 0U);
+	assert(response.x0 == SUNXI_A133_SIP_SUCCESS);
+	assert(response.x1 == 0U);
+	assert(fake.set_calls == 1U && fake.clear_calls == 0U);
+	assert(fake.last_wake_source == 0x67U);
+
+	response = dispatch(&backend, true, SUNXI_A133_SIP_CLEAR_WAKE_SOURCE,
+			    SUNXI_A133_SIP_NUM_SPI_INDICES - 1U,
+			    0U, 0U, 0U);
+	assert(response.x0 == SUNXI_A133_SIP_SUCCESS);
+	assert(fake.set_calls == 1U && fake.clear_calls == 1U);
+	assert(fake.last_wake_source == SUNXI_A133_SIP_NUM_SPI_INDICES - 1U);
+}
+
+static void test_invalid_arguments_do_not_reach_scp(void)
+{
+	struct sunxi_a133_native_svc_backend backend;
+	struct sunxi_a133_native_svc_response response;
+	struct fake_backend fake;
+	unsigned int i;
+	const uint32_t extra[][3] = {
+		{ 1U, 0U, 0U },
+		{ 0U, 1U, 0U },
+		{ 0U, 0U, 1U },
+	};
+
+	init_backend(&fake, &backend);
+	response = dispatch(&backend, true, SUNXI_A133_SIP_SET_WAKE_SOURCE,
+			    SUNXI_A133_SIP_NUM_SPI_INDICES, 0U, 0U, 0U);
+	assert(response.x0 == (uint32_t)SUNXI_A133_SIP_INVALID_PARAMETER);
+	for (i = 0U; i < ARRAY_SIZE(extra); i++) {
+		response = dispatch(&backend, true,
+				    SUNXI_A133_SIP_CLEAR_WAKE_SOURCE, 0x67U,
+				    extra[i][0], extra[i][1], extra[i][2]);
+		assert(response.x0 ==
+		       (uint32_t)SUNXI_A133_SIP_INVALID_PARAMETER);
+	}
+	assert(fake.set_calls == 0U && fake.clear_calls == 0U);
+}
+
+static void test_not_ready_does_not_reach_scp(void)
+{
+	struct sunxi_a133_native_svc_backend backend;
+	struct sunxi_a133_native_svc_response response;
+	struct fake_backend fake;
+
+	init_backend(&fake, &backend);
+	fake.capabilities = 0U;
+	response = dispatch(&backend, true, SUNXI_A133_SIP_SET_WAKE_SOURCE,
+			    0x67U, 0U, 0U, 0U);
+	assert(response.x0 == (uint32_t)SUNXI_A133_SIP_NOT_READY);
+	assert(fake.set_calls == 0U && fake.clear_calls == 0U);
+}
+
+static void test_transport_and_remote_errors_are_stable(void)
+{
+	struct sunxi_a133_native_svc_backend backend;
+	struct sunxi_a133_native_svc_response response;
+	struct fake_backend fake;
+	unsigned int i;
+	const struct {
+		int transport;
+		uint32_t abi;
+	} errors[] = {
+		{ SUNXI_VENDOR_SCP_EINVAL, SUNXI_A133_SIP_INVALID_PARAMETER },
+		{ SUNXI_VENDOR_SCP_ETIMEOUT, SUNXI_A133_SIP_TIMEOUT },
+		{ SUNXI_VENDOR_SCP_ENOTREADY, SUNXI_A133_SIP_NOT_READY },
+		{ SUNXI_VENDOR_SCP_EPOISONED, SUNXI_A133_SIP_POISONED },
+		{ SUNXI_VENDOR_SCP_EPROTO, SUNXI_A133_SIP_PROTOCOL_ERROR },
+		{ -99, SUNXI_A133_SIP_PROTOCOL_ERROR },
+	};
+
+	init_backend(&fake, &backend);
+	for (i = 0U; i < ARRAY_SIZE(errors); i++) {
+		fake.status = errors[i].transport;
+		response = dispatch(&backend, true,
+				    SUNXI_A133_SIP_SET_WAKE_SOURCE, 0x67U,
+				    0U, 0U, 0U);
+		assert(response.x0 == errors[i].abi);
+		assert(response.x1 == 0U);
+	}
+
+	fake.status = SUNXI_VENDOR_SCP_OK;
+	fake.result = 0xa5U;
+	response = dispatch(&backend, true, SUNXI_A133_SIP_CLEAR_WAKE_SOURCE,
+			    0x67U, 0U, 0U, 0U);
+	assert(response.x0 == (uint32_t)SUNXI_A133_SIP_REMOTE_ERROR);
+	assert(response.x1 == 0xa5U);
+}
+
+int main(void)
+{
+	test_discovery_is_stable();
+	test_security_and_unknown_calls();
+	test_capability_requires_ready_complete_backend();
+	test_raw_spi_set_and_clear();
+	test_invalid_arguments_do_not_reach_scp();
+	test_not_ready_does_not_reach_scp();
+	test_transport_and_remote_errors_are_stable();
+	puts("sunxi_a133_native_svc tests: PASS");
+	return 0;
+}
