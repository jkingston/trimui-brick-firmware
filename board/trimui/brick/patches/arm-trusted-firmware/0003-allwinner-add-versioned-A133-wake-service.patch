diff --git a/plat/allwinner/common/include/sunxi_a133_native_svc.h b/plat/allwinner/common/include/sunxi_a133_native_svc.h
new file mode 100644
index 0000000..bc7f618
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_a133_native_svc.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#ifndef SUNXI_A133_NATIVE_SVC_H
+#define SUNXI_A133_NATIVE_SVC_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Allwinner A133 SiP service: fast SMC32 calls. */
+#define SUNXI_A133_SIP_CALL_COUNT	0x8200ff00U
+#define SUNXI_A133_SIP_UID		0x8200ff01U
+#define SUNXI_A133_SIP_VERSION		0x8200ff03U
+#define SUNXI_A133_SIP_CAPABILITIES	0x82000100U
+#define SUNXI_A133_SIP_SET_WAKE_SOURCE	0x82000101U
+#define SUNXI_A133_SIP_CLEAR_WAKE_SOURCE	0x82000102U
+
+#define SUNXI_A133_SIP_NUM_CALLS		6U
+#define SUNXI_A133_SIP_VERSION_MAJOR	1U
+#define SUNXI_A133_SIP_VERSION_MINOR	0U
+
+/* UUID 2052c028-f921-540c-8330-bba08ba2c772 in SMCCC register order. */
+#define SUNXI_A133_SIP_UID_WORD0		0x28c05220U
+#define SUNXI_A133_SIP_UID_WORD1		0x0c5421f9U
+#define SUNXI_A133_SIP_UID_WORD2		0xa0bb3083U
+#define SUNXI_A133_SIP_UID_WORD3		0x72c7a28bU
+
+#define SUNXI_A133_SIP_CAP_WAKE_SOURCE		(1U << 0)
+#define SUNXI_A133_SIP_CAP_RAW_SPI_INDEX		(1U << 1)
+
+/* GICv2 SPI INTIDs are 32 through 1019; the ABI carries INTID - 32. */
+#define SUNXI_A133_SIP_NUM_SPI_INDICES		988U
+
+enum sunxi_a133_sip_status {
+	SUNXI_A133_SIP_SUCCESS = 0,
+	SUNXI_A133_SIP_NOT_SUPPORTED = -1,
+	SUNXI_A133_SIP_INVALID_PARAMETER = -4,
+	SUNXI_A133_SIP_NOT_READY = -5,
+	SUNXI_A133_SIP_TIMEOUT = -6,
+	SUNXI_A133_SIP_POISONED = -7,
+	SUNXI_A133_SIP_PROTOCOL_ERROR = -8,
+	SUNXI_A133_SIP_REMOTE_ERROR = -9,
+};
+
+struct sunxi_a133_native_svc_backend {
+	void *cookie;
+	uint32_t (*capabilities)(void *cookie);
+	int (*set_wake_source)(void *cookie, uint32_t wake_source,
+			       uint8_t *scp_result);
+	int (*clear_wake_source)(void *cookie, uint32_t wake_source,
+				 uint8_t *scp_result);
+};
+
+struct sunxi_a133_native_svc_response {
+	uint32_t x0;
+	uint32_t x1;
+	uint32_t x2;
+	uint32_t x3;
+};
+
+void sunxi_a133_native_svc_dispatch(
+	const struct sunxi_a133_native_svc_backend *backend,
+	bool non_secure, uint32_t smc_fid, uint32_t x1, uint32_t x2,
+	uint32_t x3, uint32_t x4,
+	struct sunxi_a133_native_svc_response *response);
+
+#endif /* SUNXI_A133_NATIVE_SVC_H */
diff --git a/plat/allwinner/common/include/sunxi_a133_vendor_scp_runtime.h b/plat/allwinner/common/include/sunxi_a133_vendor_scp_runtime.h
