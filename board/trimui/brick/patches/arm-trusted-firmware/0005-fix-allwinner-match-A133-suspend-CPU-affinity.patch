+static void test_mpidr_admission_and_normalization(void)
+{
+	static const struct {
+		uint64_t mpidr;
+		uint32_t cpu_affinity;
+	} accepted_non_affinity[] = {
+		{ UINT64_C(0x80000000), 0U },
+		{ (UINT64_C(1) << 24) | 1U, 1U },
+		{ (UINT64_C(1) << 30) | 2U, 2U },
+		{ UINT64_C(0xc1000003), 3U },
+	};
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	const uint64_t unavailable_core[] = {
+		UINT64_C(4),
+		UINT64_C(0xff),
+	};
+	const uint64_t higher_affinity[] = {
+		UINT64_C(1) << 8,
+		UINT64_C(1) << 16,
+		UINT64_C(1) << 32,
+	};
+	const uint64_t reserved_bits[] = {
+		UINT64_C(1) << 25,
+		UINT64_C(1) << 29,
+		UINT64_C(1) << 40,
+		UINT64_C(1) << 63,
+	};
+	const uint64_t *rejected[] = {
+		unavailable_core,
+		higher_affinity,
+		reserved_bits,
+	};
+	const size_t rejected_count[] = {
+		ARRAY_SIZE(unavailable_core),
+		ARRAY_SIZE(higher_affinity),
+		ARRAY_SIZE(reserved_bits),
+	};
+	unsigned int i;
+	unsigned int group;
+
+	for (i = 0U; i < ARRAY_SIZE(accepted_non_affinity); i++) {
+		setup(&suspend, &fake);
+		assert(sunxi_a133_suspend_prepare(
+			       &suspend, &state, accepted_non_affinity[i].mpidr,
+			       0x40000100U) == SUNXI_A133_SUSPEND_OK);
+		assert(sunxi_a133_suspend_commit(&suspend) ==
+		       SUNXI_A133_SUSPEND_OK);
+		assert(fake.cpu_affinity ==
+		       accepted_non_affinity[i].cpu_affinity);
+	}
+
+	for (group = 0U; group < ARRAY_SIZE(rejected); group++) {
+		for (i = 0U; i < rejected_count[group]; i++) {
+			setup(&suspend, &fake);
+			assert(sunxi_a133_suspend_prepare(
+				       &suspend, &state, rejected[group][i],
+				       0x40000100U) ==
+			       SUNXI_A133_SUSPEND_EINVAL);
+			assert(suspend.phase == SUNXI_A133_SUSPEND_IDLE);
+			assert(fake.cpu_op_calls == 0U);
+		}
+	}
+}
+
 static void test_capabilities_are_all_required(void)
 {
 	struct sunxi_a133_suspend suspend;
@@ -191,7 +263,8 @@ static void test_precommit_abort(void)
 	       SUNXI_A133_SUSPEND_OK);
 	assert(sunxi_a133_suspend_abort(&suspend) == SUNXI_A133_SUSPEND_OK);
 	assert(suspend.phase == SUNXI_A133_SUSPEND_IDLE);
-	assert(suspend.mpidr == 0U && suspend.resume_entry == 0U);
+	assert(suspend.cpu_affinity == 0U &&
+	       suspend.secure_resume_entry == 0U);
 	assert(fake.cpu_op_calls == 0U && fake.restore_calls == 0U);
 	assert(sunxi_a133_suspend_abort(&suspend) ==
 	       SUNXI_A133_SUSPEND_ESTATE);
@@ -352,6 +425,7 @@ int main(void)
 {
 	test_exact_state_and_arguments();
 	test_validation_is_precommit();
+	test_mpidr_admission_and_normalization();
 	test_capabilities_are_all_required();
 	test_precommit_abort();
 	test_retry_only_before_commit_boundary();
