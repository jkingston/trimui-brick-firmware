+	    (secure_resume_entry > UINT32_MAX) ||
+	    ((secure_resume_entry & 3U) != 0U)) {
 		return SUNXI_A133_SUSPEND_EINVAL;
 	}
 	if (suspend->phase == SUNXI_A133_SUSPEND_FAILED) {
@@ -104,8 +138,9 @@ int sunxi_a133_suspend_prepare(
 		return SUNXI_A133_SUSPEND_ENOTREADY;
 	}
 
-	suspend->mpidr = (uint32_t)mpidr;
-	suspend->resume_entry = (uint32_t)resume_entry;
+	suspend->cpu_affinity = cpu_affinity;
+	/* The caller must supply TF-A's trusted secure warm-entry address. */
+	suspend->secure_resume_entry = (uint32_t)secure_resume_entry;
 	suspend->last_transport_status = SUNXI_VENDOR_SCP_OK;
 	suspend->wake_source = 0U;
 	suspend->wake_source_valid = false;
@@ -148,7 +183,8 @@ int sunxi_a133_suspend_commit(struct sunxi_a133_suspend *suspend)
 	}
 
