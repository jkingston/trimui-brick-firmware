 #define STOCK_SUSPEND_LOCAL_STATE	3U
 
+/* MPIDR_EL1 affinity fields plus its architectural RES1, U and MT bits. */
+#define A133_MPIDR_AFF0_MASK		UINT64_C(0xff)
+#define A133_MPIDR_AFFINITY_MASK	UINT64_C(0xff00ffffff)
+#define A133_MPIDR_NON_AFFINITY_MASK	UINT64_C(0xc1000000)
+#define A133_MPIDR_ALLOWED_MASK		(A133_MPIDR_AFFINITY_MASK | \
+					 A133_MPIDR_NON_AFFINITY_MASK)
+
 #ifndef SUNXI_A133_SUSPEND_HOST_TEST
 CASSERT(PLAT_MAX_PWR_LVL == 2U, assert_a133_has_three_power_levels);
 CASSERT(PLAT_MAX_OFF_STATE == STOCK_SUSPEND_LOCAL_STATE,
 	assert_a133_off_state_matches_stock);
+CASSERT(PLATFORM_CLUSTER_COUNT == 1U, assert_a133_has_one_cluster);
+CASSERT(PLATFORM_MAX_CPUS_PER_CLUSTER == 4U, assert_a133_has_four_cores);
 #endif
 
 static bool backend_complete(
@@ -36,8 +45,29 @@ static bool backend_ready(struct sunxi_a133_suspend *suspend)
 
 static void clear_request(struct sunxi_a133_suspend *suspend)
 {
-	suspend->mpidr = 0U;
-	suspend->resume_entry = 0U;
+	suspend->cpu_affinity = 0U;
+	suspend->secure_resume_entry = 0U;
+}
+
+static bool normalize_mpidr(uint64_t mpidr, uint32_t *cpu_affinity)
+{
+	uint32_t affinity;
+
+	if ((mpidr & ~A133_MPIDR_ALLOWED_MASK) != 0U) {
+		return false;
+	}
+	if ((mpidr & (A133_MPIDR_AFFINITY_MASK &
+		      ~A133_MPIDR_AFF0_MASK)) != 0U) {
+		return false;
+	}
+
+	affinity = (uint32_t)(mpidr & A133_MPIDR_AFF0_MASK);
+	if (affinity >= PLATFORM_MAX_CPUS_PER_CLUSTER) {
+		return false;
+	}
+
+	*cpu_affinity = affinity;
+	return true;
 }
 
