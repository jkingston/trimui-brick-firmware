@@ -140,14 +141,14 @@ void sunxi_a133_vendor_scp_runtime_suspend_state(
 
 int sunxi_a133_vendor_scp_runtime_suspend_prepare(
 	const psci_power_state_t *target_state, uint64_t mpidr,
-	uint64_t resume_entry)
+	uint64_t secure_resume_entry)
 {
 	int ret;
 
 	spin_lock(&a133_vendor_scp_lock);
 	ret = a133_suspend_ready ?
 		sunxi_a133_suspend_prepare(&a133_suspend, target_state, mpidr,
-					   resume_entry) :
+					   secure_resume_entry) :
 		SUNXI_A133_SUSPEND_ENOTREADY;
 	spin_unlock(&a133_vendor_scp_lock);
