diff --git a/plat/allwinner/common/tests/test_sunxi_a133_gic.c b/plat/allwinner/common/tests/test_sunxi_a133_gic.c
new file mode 100644
index 0000000..a60e342
--- /dev/null
+++ b/plat/allwinner/common/tests/test_sunxi_a133_gic.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include <sunxi_a133_gic.h>
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+#define GICD 0x03021000U
+#define GICC 0x03022000U
+
+struct write_event {
+	uintptr_t address;
+	uint32_t value;
+};
+
+struct fake_backend {
+	struct write_event events[128];
+	size_t count;
+	uint32_t typer;
+};
+
+static uint32_t fake_read_32(void *cookie, uintptr_t address)
+{
+	struct fake_backend *fake = cookie;
+
+	assert(address == GICD + 0x004U);
+	return fake->typer;
+}
+
+static void fake_write_32(void *cookie, uintptr_t address, uint32_t value)
+{
+	struct fake_backend *fake = cookie;
+
+	assert(fake->count < ARRAY_SIZE(fake->events));
+	fake->events[fake->count++] = (struct write_event) {
+		.address = address,
+		.value = value,
+	};
+}
+
+static void expect(const struct fake_backend *fake, size_t index,
+		   uintptr_t address, uint32_t value)
+{
+	assert(index < fake->count);
+	assert(fake->events[index].address == address);
+	assert(fake->events[index].value == value);
+}
+
+int main(void)
+{
+	struct fake_backend fake = { .typer = 4U };
+	const struct sunxi_a133_gic_backend backend = {
+		.cookie = &fake,
+		.read_32 = fake_read_32,
+		.write_32 = fake_write_32,
+	};
+	size_t i;
+	size_t pos = 0U;
+
+	assert(sunxi_a133_gic_reset(&backend));
+	expect(&fake, pos++, GICC + 0x000U, 0U);
+	expect(&fake, pos++, GICD + 0x180U, 0xffff0000U);
+	expect(&fake, pos++, GICD + 0x100U, 0x0000ffffU);
+	for (i = 0U; i < 32U; i += 4U) {
+		expect(&fake, pos++, GICD + 0x400U + i, 0xa0a0a0a0U);
+	}
+	expect(&fake, pos++, GICC + 0x004U, 0xf0U);
+	expect(&fake, pos++, GICC + 0x000U, 0xbU);
+	expect(&fake, pos++, GICD + 0x000U, 0U);
+	for (i = 0U; i < 10U; ++i) {
+		expect(&fake, pos++, GICD + 0x080U + i * 4U, UINT32_MAX);
+	}
+	for (i = 0U; i < 160U; i += 16U) {
+		expect(&fake, pos++, GICD + 0xc00U + i / 4U, 0U);
+	}
+	for (i = 32U; i < 148U; i += 4U) {
+		expect(&fake, pos++, GICD + 0x400U + i, 0xa0a0a0a0U);
+		expect(&fake, pos++, GICD + 0x800U + i, 0x01010101U);
+	}
+	for (i = 32U; i < 160U; i += 32U) {
+		expect(&fake, pos++, GICD + 0x180U + i / 8U, UINT32_MAX);
+		expect(&fake, pos++, GICD + 0x380U + i / 8U, UINT32_MAX);
+	}
+	expect(&fake, pos++, GICD + 0x000U, 3U);
+	assert(pos == fake.count);
+	fake.count = 0U;
+	fake.typer = 3U;
+	assert(!sunxi_a133_gic_reset(&backend));
+	assert(fake.count == 0U);
+	puts("sunxi_a133 stock GIC reset tests: PASS");
+	return 0;
+}
diff --git a/plat/allwinner/common/tests/test_sunxi_a133_secure_context.c b/plat/allwinner/common/tests/test_sunxi_a133_secure_context.c
new file mode 100644
index 0000000..1f2e0f9
--- /dev/null
+++ b/plat/allwinner/common/tests/test_sunxi_a133_secure_context.c
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <sunxi_a133_secure_context.h>
+
+#define ARRAY_SIZE(array)	(sizeof(array) / sizeof((array)[0]))
+
+#define COUNTER_LOW		0x08110000U
+#define COUNTER_HIGH		0x08110004U
+#define COUNTER_CTRL		0x08120000U
+#define COUNTER_LOW_SET		0x08120008U
+#define COUNTER_HIGH_SET	0x0812000cU
+#define COUNTER_FREQID		0x08120020U
+#define RVBAR_LO(cpu)		(0x08100040U + (cpu) * 8U)
+#define RVBAR_HI(cpu)		(0x08100044U + (cpu) * 8U)
+#define GICC_CTLR		0x03022000U
+#define CCU_SEC_SWITCH		0x03001f00U
+#define PLL_COM			0x03001060U
+#define CPUCFG_CLUSTER_CTRL1	0x09010014U
+
+enum event_kind {
+	EVENT_READ,
+	EVENT_WRITE,
+	EVENT_BARRIER,
+	EVENT_GIC_RESET,
+	EVENT_COMMIT,
+	EVENT_FINISH,
+};
+
+struct event {
+	enum event_kind kind;
+	uintptr_t address;
+	uint32_t value;
+};
+
+struct register_value {
+	uintptr_t address;
+	uint32_t value;
+};
+
+struct fake_backend {
+	struct event events[256];
+	struct register_value registers[64];
+	size_t event_count;
+	size_t register_count;
+	int commit_status;
+	int finish_status;
+	bool gic_reset_ok;
+	bool pll_never_locks;
+};
+
+static void record(struct fake_backend *fake, enum event_kind kind,
+		   uintptr_t address, uint32_t value)
+{
+	assert(fake->event_count < ARRAY_SIZE(fake->events));
+	fake->events[fake->event_count++] = (struct event) {
+		.kind = kind,
+		.address = address,
+		.value = value,
+	};
+}
+
+static void set_register(struct fake_backend *fake, uintptr_t address,
+			 uint32_t value)
+{
+	size_t i;
+
+	for (i = 0U; i < fake->register_count; ++i) {
+		if (fake->registers[i].address == address) {
+			fake->registers[i].value = value;
+			return;
+		}
+	}
+	assert(fake->register_count < ARRAY_SIZE(fake->registers));
+	fake->registers[fake->register_count++] = (struct register_value) {
+		.address = address,
+		.value = value,
+	};
+}
+
+static uint32_t get_register(const struct fake_backend *fake,
+			     uintptr_t address)
+{
+	size_t i;
+
+	for (i = 0U; i < fake->register_count; ++i) {
+		if (fake->registers[i].address == address) {
+			return fake->registers[i].value;
+		}
+	}
+	return 0U;
+}
+
+static uint32_t fake_read_32(void *cookie, uintptr_t address)
+{
+	struct fake_backend *fake = cookie;
+	uint32_t value = get_register(fake, address);
+
+	if ((address == PLL_COM) && !fake->pll_never_locks) {
+		value |= 0x10000000U;
+	}
+	record(fake, EVENT_READ, address, value);
+	return value;
+}
+
+static void fake_write_32(void *cookie, uintptr_t address, uint32_t value)
+{
+	struct fake_backend *fake = cookie;
+
+	set_register(fake, address, value);
+	record(fake, EVENT_WRITE, address, value);
+}
+
+static void fake_barrier(void *cookie)
+{
+	struct fake_backend *fake = cookie;
+
+	record(fake, EVENT_BARRIER, 0U, 0U);
+}
+
+static bool fake_gic_reset(void *cookie)
+{
+	struct fake_backend *fake = cookie;
+
+	record(fake, EVENT_GIC_RESET, 0U, 0U);
+	return fake->gic_reset_ok;
+}
+
+static int fake_commit(void *cookie)
+{
+	struct fake_backend *fake = cookie;
+
+	record(fake, EVENT_COMMIT, 0U, (uint32_t)fake->commit_status);
+	return fake->commit_status;
+}
+
+static int fake_finish(void *cookie, uint32_t *wake_source)
+{
+	struct fake_backend *fake = cookie;
+
+	*wake_source = 0x13579bdfU;
+	record(fake, EVENT_FINISH, 0U, (uint32_t)fake->finish_status);
+	return fake->finish_status;
+}
+
+static void setup(struct sunxi_a133_secure_context *context,
+		  struct fake_backend *fake, uint32_t pll_polls)
+{
+	const struct sunxi_a133_context_backend backend = {
+		.cookie = fake,
+		.read_32 = fake_read_32,
+		.write_32 = fake_write_32,
+		.barrier = fake_barrier,
+		.gic_reset = fake_gic_reset,
+		.transaction_commit = fake_commit,
+		.transaction_finish = fake_finish,
+	};
+
+	memset(fake, 0, sizeof(*fake));
+	fake->gic_reset_ok = true;
+	set_register(fake, COUNTER_LOW, 0x11223344U);
+	set_register(fake, COUNTER_HIGH, 0x55667788U);
+	set_register(fake, COUNTER_FREQID, 0x18U);
+	set_register(fake, GICC_CTLR, 0x3U);
+	assert(sunxi_a133_secure_context_init(context, &backend,
+					     0x40000100U, 0x40000000U,
+					     0x40020000U, pll_polls) ==
+	       SUNXI_A133_CONTEXT_OK);
+}
+
+static size_t find_event(const struct fake_backend *fake, size_t start,
+			 enum event_kind kind, uintptr_t address)
+{
+	size_t i;
+
+
+	for (i = start; i < fake->event_count; ++i) {
+		if ((fake->events[i].kind == kind) &&
+		    (fake->events[i].address == address)) {
+			return i;
+		}
+	}
+	return fake->event_count;
+}
+
+static void test_stock_order_and_exact_values(void)
+{
+	struct sunxi_a133_secure_context context;
+	struct fake_backend fake;
+	size_t restore_start;
+	size_t finish;
+	size_t security;
+	size_t counter;
+	size_t pll;
+	size_t cpucfg;
+	unsigned int cpu;
+
+	setup(&context, &fake, 4U);
+	assert(sunxi_a133_secure_context_save_early(&context) ==
+	       SUNXI_A133_CONTEXT_OK);
+	assert(fake.events[0].kind == EVENT_READ);
+	assert(fake.events[0].address == COUNTER_LOW);
+	assert(fake.events[1].address == COUNTER_HIGH);
+	assert(fake.events[2].address == COUNTER_FREQID);
+	assert(context.counter_low == 0x11223344U);
+	assert(context.counter_high == 0x55667788U);
+	assert(context.counter_frequency_id == 0x18U);
+
+	assert(sunxi_a133_secure_context_commit_late(&context) ==
+	       SUNXI_A133_CONTEXT_OK);
+	assert(fake.events[3].kind == EVENT_READ);
+	assert(fake.events[3].address == GICC_CTLR);
+	assert(fake.events[4].kind == EVENT_WRITE);
+	assert(fake.events[4].address == GICC_CTLR);
+	assert(fake.events[4].value == 0x1e0U);
+	assert(fake.events[5].kind == EVENT_COMMIT);
+	assert(fake.events[6].kind == EVENT_BARRIER);
+
+	restore_start = fake.event_count;
+	assert(sunxi_a133_secure_context_restore_early(&context) ==
+	       SUNXI_A133_CONTEXT_OK);
+	for (cpu = 0U; cpu < 4U; ++cpu) {
+		assert(fake.events[restore_start + cpu * 2U].kind == EVENT_WRITE);
+		assert(fake.events[restore_start + cpu * 2U].address ==
+		       RVBAR_LO(cpu));
+		assert(fake.events[restore_start + cpu * 2U].value ==
+		       0x40000100U);
+		assert(fake.events[restore_start + cpu * 2U + 1U].address ==
+		       RVBAR_HI(cpu));
+		assert(fake.events[restore_start + cpu * 2U + 1U].value == 0U);
+	}
+	assert(fake.events[restore_start + 8U].kind == EVENT_GIC_RESET);
+
+	finish = find_event(&fake, restore_start, EVENT_FINISH, 0U);
+	security = find_event(&fake, finish + 1U, EVENT_WRITE,
+			      CCU_SEC_SWITCH);
+	counter = find_event(&fake, security + 1U, EVENT_WRITE, COUNTER_CTRL);
+	pll = find_event(&fake, counter + 1U, EVENT_READ, PLL_COM);
+	cpucfg = find_event(&fake, pll + 1U, EVENT_WRITE,
+			    CPUCFG_CLUSTER_CTRL1);
+	assert(finish < security);
+	assert(security < counter);
+	assert(counter < pll);
+	assert(pll < cpucfg);
+	assert(get_register(&fake, COUNTER_FREQID) == 0x18U);
+	assert(get_register(&fake, COUNTER_LOW_SET) == 0x11223344U);
+	assert(get_register(&fake, COUNTER_HIGH_SET) == 0x55667788U);
+	assert(get_register(&fake, COUNTER_CTRL) == 1U);
+	assert(get_register(&fake, CPUCFG_CLUSTER_CTRL1) == 2U);
+
+	assert(context.wake_source == 0x13579bdfU);
+	assert(context.phase == SUNXI_A133_CONTEXT_IDLE);
+}
+
+static void test_trusted_entry_and_dependency_validation(void)
+{
+	struct sunxi_a133_secure_context context;
+	struct fake_backend fake;
+	struct sunxi_a133_context_backend backend;
+
+	setup(&context, &fake, 1U);
+	backend = context.backend;
+	assert(sunxi_a133_secure_context_init(NULL, &backend, 0x40000100U,
+					     0x40000000U, 0x40020000U,
+					     1U) == SUNXI_A133_CONTEXT_EINVAL);
+	assert(sunxi_a133_secure_context_init(&context, &backend, 0U,
+					     0x40000000U, 0x40020000U,
+					     1U) == SUNXI_A133_CONTEXT_EINVAL);
+	assert(sunxi_a133_secure_context_init(&context, &backend, 0x40000102U,
+					     0x40000000U, 0x40020000U,
+					     1U) == SUNXI_A133_CONTEXT_EINVAL);
+	assert(sunxi_a133_secure_context_init(&context, &backend, 0x40020000U,
+					     0x40000000U, 0x40020000U,
+					     1U) == SUNXI_A133_CONTEXT_EINVAL);
+	assert(sunxi_a133_secure_context_init(&context, &backend,
+					     UINT64_C(0x140000100),
+					     0x40000000U,
+					     UINT64_C(0x140020000), 1U) ==
+	       SUNXI_A133_CONTEXT_EINVAL);
+	backend.transaction_finish = NULL;
+	assert(sunxi_a133_secure_context_init(&context, &backend, 0x40000100U,
+					     0x40000000U, 0x40020000U,
+					     1U) == SUNXI_A133_CONTEXT_EINVAL);
+}
+
+static void test_phase_and_commit_faults(void)
+{
+	struct sunxi_a133_secure_context context;
+	struct fake_backend fake;
+
+	setup(&context, &fake, 1U);
+	assert(sunxi_a133_secure_context_commit_late(&context) ==
+	       SUNXI_A133_CONTEXT_ESTATE);
+	assert(sunxi_a133_secure_context_restore_early(&context) ==
+	       SUNXI_A133_CONTEXT_ESTATE);
+	assert(sunxi_a133_secure_context_save_early(&context) ==
+	       SUNXI_A133_CONTEXT_OK);
+	fake.commit_status = SUNXI_A133_CONTEXT_TX_RETRY;
+	assert(sunxi_a133_secure_context_commit_late(&context) ==
+	       SUNXI_A133_CONTEXT_ERETRY);
+	assert(context.phase == SUNXI_A133_CONTEXT_SAVED);
+	assert(sunxi_a133_secure_context_abort(&context) ==
+	       SUNXI_A133_CONTEXT_OK);
+
+	assert(sunxi_a133_secure_context_save_early(&context) ==
+	       SUNXI_A133_CONTEXT_OK);
+	fake.commit_status = SUNXI_A133_CONTEXT_TX_FAILED;
+	assert(sunxi_a133_secure_context_commit_late(&context) ==
+	       SUNXI_A133_CONTEXT_EFAILSTOP);
+	assert(context.phase == SUNXI_A133_CONTEXT_FAILED);
+	assert(sunxi_a133_secure_context_abort(&context) ==
+	       SUNXI_A133_CONTEXT_ESTATE);
+}
+
+static void test_restore_fault_stops_order(void)
+{
+	struct sunxi_a133_secure_context context;
+	struct fake_backend fake;
+	size_t finish;
+
+	setup(&context, &fake, 1U);
+	assert(sunxi_a133_secure_context_save_early(&context) == 0);
+	assert(sunxi_a133_secure_context_commit_late(&context) == 0);
+	fake.finish_status = SUNXI_A133_CONTEXT_TX_FAILED;
+	assert(sunxi_a133_secure_context_restore_early(&context) ==
+	       SUNXI_A133_CONTEXT_EFAILSTOP);
+	finish = find_event(&fake, 0U, EVENT_FINISH, 0U);
+	assert(finish < fake.event_count);
+	assert(find_event(&fake, finish + 1U, EVENT_WRITE, CCU_SEC_SWITCH) ==
+	       fake.event_count);
+	assert(context.phase == SUNXI_A133_CONTEXT_FAILED);
+
+	setup(&context, &fake, 1U);
+	assert(sunxi_a133_secure_context_save_early(&context) == 0);
+	assert(sunxi_a133_secure_context_commit_late(&context) == 0);
+	fake.gic_reset_ok = false;
+	assert(sunxi_a133_secure_context_restore_early(&context) ==
+	       SUNXI_A133_CONTEXT_EFAILSTOP);
+	assert(find_event(&fake, 0U, EVENT_FINISH, 0U) == fake.event_count);
+	assert(context.phase == SUNXI_A133_CONTEXT_FAILED);
+
+	setup(&context, &fake, 2U);
+	assert(sunxi_a133_secure_context_save_early(&context) == 0);
+	assert(sunxi_a133_secure_context_commit_late(&context) == 0);
+	fake.pll_never_locks = true;
+	assert(sunxi_a133_secure_context_restore_early(&context) ==
+	       SUNXI_A133_CONTEXT_ETIMEOUT);
+	assert(find_event(&fake, 0U, EVENT_WRITE, CPUCFG_CLUSTER_CTRL1) ==
+	       fake.event_count);
+	assert(context.phase == SUNXI_A133_CONTEXT_FAILED);
+}
+
+static void test_retained_header_corruption_fails_closed(void)
+{
+	struct sunxi_a133_secure_context context;
+	struct fake_backend fake;
+
+	setup(&context, &fake, 1U);
+	context.magic ^= 1U;
+	assert(sunxi_a133_secure_context_save_early(&context) ==
+	       SUNXI_A133_CONTEXT_EFAILSTOP);
+	assert(fake.event_count == 0U);
+}
+
+int main(void)
+{
+	test_stock_order_and_exact_values();
+	test_trusted_entry_and_dependency_validation();
+	test_phase_and_commit_faults();
+	test_restore_fault_stops_order();
+	test_retained_header_corruption_fails_closed();
+	puts("sunxi_a133 secure context tests: PASS");
+	return 0;
+}
diff --git a/plat/allwinner/sun50i_a133/platform.mk b/plat/allwinner/sun50i_a133/platform.mk
index 34979a1..76d1277 100644
