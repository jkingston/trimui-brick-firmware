+#endif
 
 #define SUNXI_WDOG0_CTRL_REG		(SUNXI_R_WDOG_BASE + 0x0010)
 #define SUNXI_WDOG0_CFG_REG		(SUNXI_R_WDOG_BASE + 0x0014)
@@ -74,7 +78,77 @@ static const plat_psci_ops_t sunxi_native_psci_ops = {
 	.validate_ns_entrypoint		= sunxi_validate_ns_entrypoint,
 };
 
+#if defined(SUNXI_A133_SYSTEM_SUSPEND)
+static void sunxi_a133_get_sys_suspend_power_state(
+	psci_power_state_t *target_state)
+{
+	sunxi_a133_system_suspend_state(target_state);
+}
+
+static void sunxi_a133_pwr_domain_suspend_pwrdown_early(
+	const psci_power_state_t *target_state)
+{
+	int ret = sunxi_a133_system_suspend_prepare(target_state, read_mpidr());
+
+	if (ret != SUNXI_A133_CONTEXT_OK) {
+		ERROR("PSCI: A133 suspend prepare failed: %d\n", ret);
+		panic();
+	}
+}
+
+static void sunxi_a133_pwr_domain_suspend(
+	const psci_power_state_t *target_state)
+{
+	int ret;
+
+	(void)target_state;
+	ret = sunxi_a133_system_suspend_commit();
+	if (ret != SUNXI_A133_CONTEXT_OK) {
+		ERROR("PSCI: A133 suspend commit failed: %d\n", ret);
+		panic();
+	}
+}
+
+static void sunxi_a133_pwr_domain_suspend_finish(
+	const psci_power_state_t *target_state)
+{
+	int ret;
+
+	(void)target_state;
+	ret = sunxi_a133_system_suspend_finish();
+	if (ret != SUNXI_A133_CONTEXT_OK) {
+		ERROR("PSCI: A133 suspend restore failed: %d\n", ret);
+		panic();
+	}
+	/* Generic Allwinner PSCI does not set USE_GIC_DRIVER. */
+	gicv2_cpuif_enable();
+}
+
+static const plat_psci_ops_t sunxi_a133_system_suspend_psci_ops = {
+	.pwr_domain_on			= sunxi_pwr_domain_on,
+	.pwr_domain_off			= sunxi_pwr_domain_off,
+	.pwr_domain_on_finish		= sunxi_pwr_domain_on_finish,
+	.pwr_domain_suspend_pwrdown_early =
+		sunxi_a133_pwr_domain_suspend_pwrdown_early,
+	.pwr_domain_suspend		= sunxi_a133_pwr_domain_suspend,
+	.pwr_domain_suspend_finish	= sunxi_a133_pwr_domain_suspend_finish,
+	.get_sys_suspend_power_state	=
+		sunxi_a133_get_sys_suspend_power_state,
+	.system_off			= sunxi_system_off,
+	.system_reset			= sunxi_system_reset,
+	.validate_ns_entrypoint		= sunxi_validate_ns_entrypoint,
+};
+#endif
+
 void sunxi_set_native_psci_ops(const plat_psci_ops_t **psci_ops)
 {
+#if defined(SUNXI_A133_SYSTEM_SUSPEND)
+	if (sunxi_a133_system_suspend_runtime_available()) {
+		NOTICE("PSCI: A133 system suspend is available\n");
+		*psci_ops = &sunxi_a133_system_suspend_psci_ops;
+		return;
+	}
+	WARN("PSCI: A133 system suspend disabled: SCP is unavailable\n");
+#endif
 	*psci_ops = &sunxi_native_psci_ops;
 }
