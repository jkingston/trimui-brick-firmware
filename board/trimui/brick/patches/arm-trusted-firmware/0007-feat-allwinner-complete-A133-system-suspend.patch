diff --git a/plat/allwinner/common/include/sunxi_a133_secure_context.h b/plat/allwinner/common/include/sunxi_a133_secure_context.h
new file mode 100644
index 0000000..1b8b52d
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_a133_secure_context.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#ifndef SUNXI_A133_SECURE_CONTEXT_H
+#define SUNXI_A133_SECURE_CONTEXT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define SUNXI_A133_CONTEXT_MAGIC		0x41313343U
+#define SUNXI_A133_CONTEXT_VERSION	1U
+#define SUNXI_A133_CONTEXT_PLL_POLLS	100000U
+
+enum sunxi_a133_context_status {
+	SUNXI_A133_CONTEXT_OK = 0,
+	SUNXI_A133_CONTEXT_EINVAL = -1,
+	SUNXI_A133_CONTEXT_ESTATE = -2,
+	SUNXI_A133_CONTEXT_ERETRY = -3,
+	SUNXI_A133_CONTEXT_EFAILSTOP = -4,
+	SUNXI_A133_CONTEXT_ETIMEOUT = -5,
+};
+
+enum sunxi_a133_context_phase {
+	SUNXI_A133_CONTEXT_IDLE,
+	SUNXI_A133_CONTEXT_SAVED,
+	SUNXI_A133_CONTEXT_COMMITTED,
+	SUNXI_A133_CONTEXT_FAILED,
+};
+
+enum sunxi_a133_context_transaction_status {
+	SUNXI_A133_CONTEXT_TX_OK,
+	SUNXI_A133_CONTEXT_TX_RETRY,
+	SUNXI_A133_CONTEXT_TX_FAILED,
+};
+
+struct sunxi_a133_context_backend {
+	void *cookie;
+	uint32_t (*read_32)(void *cookie, uintptr_t address);
+	void (*write_32)(void *cookie, uintptr_t address, uint32_t value);
+	void (*barrier)(void *cookie);
+	bool (*gic_reset)(void *cookie);
+	int (*transaction_commit)(void *cookie);
+	int (*transaction_finish)(void *cookie, uint32_t *wake_source);
+};
+
+struct sunxi_a133_secure_context {
+	uint32_t magic;
+	uint32_t version;
+	enum sunxi_a133_context_phase phase;
+	uint32_t trusted_warm_entry;
+	uint32_t counter_low;
+	uint32_t counter_high;
+	uint32_t counter_frequency_id;
+	uint32_t wake_source;
+	uint32_t pll_lock_polls;
+	int last_transaction_status;
+	struct sunxi_a133_context_backend backend;
+};
+
+/*
+ * trusted_warm_entry must be the sec_entrypoint passed to
+ * plat_setup_psci_ops(), and the interval must be the reserved BL31 image.
+ */
+int sunxi_a133_secure_context_init(
+	struct sunxi_a133_secure_context *context,
+	const struct sunxi_a133_context_backend *backend,
+	uint64_t trusted_warm_entry, uint64_t bl31_base, uint64_t bl31_limit,
+	uint32_t pll_lock_polls);
+int sunxi_a133_secure_context_save_early(
+	struct sunxi_a133_secure_context *context);
+int sunxi_a133_secure_context_commit_late(
+	struct sunxi_a133_secure_context *context);
+int sunxi_a133_secure_context_restore_early(
+	struct sunxi_a133_secure_context *context);
+int sunxi_a133_secure_context_abort(
+	struct sunxi_a133_secure_context *context);
+
+#endif /* SUNXI_A133_SECURE_CONTEXT_H */
