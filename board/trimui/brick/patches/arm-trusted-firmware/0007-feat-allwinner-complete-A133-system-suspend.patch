+++ b/plat/allwinner/sun50i_a133/platform.mk
@@ -107,3 +107,35 @@ $(eval $(call add_define,SUNXI_A133_PSCI_SUSPEND_PRECURSOR))
 BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_a133_psci_bridge.c \
 				${AW_PLAT}/common/sunxi_a133_psci_bridge_runtime.c
 endif
+
+# Expose PSCI SYSTEM_SUSPEND only as the complete A133 stack. At runtime the
+# native PSCI table is selected only after SCP startup and capability probing.
+SUNXI_A133_SYSTEM_SUSPEND	?=	0
+$(call assert_boolean,SUNXI_A133_SYSTEM_SUSPEND)
+ifeq (${SUNXI_A133_SYSTEM_SUSPEND},1)
+ifneq (${ARCH},aarch64)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires ARCH=aarch64)
+endif
+ifneq (${SUNXI_A133_PSCI_SUSPEND_PRECURSOR},1)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires SUNXI_A133_PSCI_SUSPEND_PRECURSOR=1)
+endif
+ifneq (${SUNXI_A133_VENDOR_SCP_STARTUP},1)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires SUNXI_A133_VENDOR_SCP_STARTUP=1)
+endif
+ifneq (${SUNXI_A133_NATIVE_WAKE_ABI},1)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires SUNXI_A133_NATIVE_WAKE_ABI=1)
+endif
+ifneq (${SUNXI_A133_SUSPEND_ORCHESTRATOR},1)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires SUNXI_A133_SUSPEND_ORCHESTRATOR=1)
+endif
+ifneq (${SUNXI_A133_STANDBY_SCRATCH},1)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires SUNXI_A133_STANDBY_SCRATCH=1)
+endif
+ifneq (${HW_ASSISTED_COHERENCY},0)
+$(error SUNXI_A133_SYSTEM_SUSPEND requires HW_ASSISTED_COHERENCY=0)
+endif
+$(eval $(call add_define,SUNXI_A133_SYSTEM_SUSPEND))
+BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_a133_secure_context.c \
+				${AW_PLAT}/common/sunxi_a133_gic.c \
+				${AW_PLAT}/common/sunxi_a133_system_suspend.c
+endif
