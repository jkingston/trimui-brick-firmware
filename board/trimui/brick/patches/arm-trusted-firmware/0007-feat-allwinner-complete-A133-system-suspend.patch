diff --git a/plat/allwinner/common/sunxi_a133_gic.c b/plat/allwinner/common/sunxi_a133_gic.c
new file mode 100644
index 0000000..bcbb81a
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_gic.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <sunxi_a133_gic.h>
+
+#define A133_GICD_BASE		0x03021000U
+#define A133_GICC_BASE		0x03022000U
+
+#define GICD_CTLR		0x000U
+#define GICD_TYPER		0x004U
+#define GICD_IGROUPR		0x080U
+#define GICD_ISENABLER		0x100U
+#define GICD_ICENABLER		0x180U
+#define GICD_ISACTIVER		0x300U
+#define GICD_ICACTIVER		0x380U
+#define GICD_IPRIORITYR		0x400U
+#define GICD_ITARGETSR		0x800U
+#define GICD_ICFGR		0xc00U
+
+#define GICC_CTLR		0x000U
+#define GICC_PMR		0x004U
+
+#define A133_GIC_NUM_INTERRUPTS	160U
+#define A133_GIC_PRIVATE_INTERRUPTS 32U
+#define A133_GIC_PRIORITY	0xa0a0a0a0U
+#define A133_GIC_CPU0_TARGET	0x01010101U
+
+static void write_32(const struct sunxi_a133_gic_backend *backend,
+		     uintptr_t address, uint32_t value)
+{
+	backend->write_32(backend->cookie, address, value);
+}
+
+bool sunxi_a133_gic_reset(const struct sunxi_a133_gic_backend *backend)
+{
+	uint32_t num_interrupts;
+	unsigned int index;
+
+	assert((backend != NULL) && (backend->read_32 != NULL) &&
+	       (backend->write_32 != NULL));
+
+	num_interrupts = ((backend->read_32(backend->cookie,
+		A133_GICD_BASE + GICD_TYPER) & 0x1fU) + 1U) * 32U;
+	/*
+	 * Stock rejects fewer than 160 interrupts, then executes fixed A133
+	 * loops. Requiring the exact known implementation fails closed if this
+	 * platform code is ever used on a different GIC.
+	 */
+	if (num_interrupts != A133_GIC_NUM_INTERRUPTS) {
+		return false;
+	}
+
+	/* Stock 0x48000a00: rebuild the CPU/private interface. */
+	write_32(backend, A133_GICC_BASE + GICC_CTLR, 0U);
+	write_32(backend, A133_GICD_BASE + GICD_ICENABLER, 0xffff0000U);
+	write_32(backend, A133_GICD_BASE + GICD_ISENABLER, 0x0000ffffU);
+	for (index = 0U; index < A133_GIC_PRIVATE_INTERRUPTS; index += 4U) {
+		write_32(backend, A133_GICD_BASE + GICD_IPRIORITYR + index,
+			 A133_GIC_PRIORITY);
+	}
+	write_32(backend, A133_GICC_BASE + GICC_PMR, 0xf0U);
+	write_32(backend, A133_GICC_BASE + GICC_CTLR, 0xbU);
+
+	/* Stock 0x480008f8: rebuild the complete A133 distributor. */
+	write_32(backend, A133_GICD_BASE + GICD_CTLR, 0U);
+	for (index = 0U; index < 10U; ++index) {
+		write_32(backend, A133_GICD_BASE + GICD_IGROUPR + index * 4U,
+			 UINT32_MAX);
+	}
+	for (index = 0U; index < A133_GIC_NUM_INTERRUPTS; index += 16U) {
+		write_32(backend, A133_GICD_BASE + GICD_ICFGR + index / 4U,
+			 0U);
+	}
+	for (index = A133_GIC_PRIVATE_INTERRUPTS;
+	     index < 148U; index += 4U) {
+		write_32(backend, A133_GICD_BASE + GICD_IPRIORITYR + index,
+			 A133_GIC_PRIORITY);
+		write_32(backend, A133_GICD_BASE + GICD_ITARGETSR + index,
+			 A133_GIC_CPU0_TARGET);
+	}
+	for (index = A133_GIC_PRIVATE_INTERRUPTS;
+	     index < A133_GIC_NUM_INTERRUPTS; index += 32U) {
+		write_32(backend, A133_GICD_BASE + GICD_ICENABLER + index / 8U,
+			 UINT32_MAX);
+		write_32(backend, A133_GICD_BASE + GICD_ICACTIVER + index / 8U,
+			 UINT32_MAX);
+	}
+	write_32(backend, A133_GICD_BASE + GICD_CTLR, 3U);
+	return true;
+}
diff --git a/plat/allwinner/common/sunxi_a133_secure_context.c b/plat/allwinner/common/sunxi_a133_secure_context.c
new file mode 100644
index 0000000..090b662
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_secure_context.c
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <sunxi_a133_secure_context.h>
+
+#define A133_CPU_COUNT			4U
+
+#define A133_SYSCON_RESUME_REG		0x03000004U
+#define A133_PLL_COM_REG		0x03001060U
+#define A133_CCU_SEC_SWITCH_REG		0x03001f00U
+#define A133_DMA_SEC_REG		0x03002020U
+#define A133_SID_CHIPID_REG		0x03006200U
+#define A133_SPC_BASE			0x03008000U
+#define A133_SPC_PORT_SET_REG(port)	(A133_SPC_BASE + 0x4U + (port) * 0x10U)
+#define A133_SPC_SPECIAL0_REG		0x030080e0U
+#define A133_SPC_SPECIAL1_REG		0x030080e4U
+#define A133_GICC_CTLR_REG		0x03022000U
+#define A133_NSI_BASE			0x03100000U
+#define A133_R_PRCM_SEC_SWITCH_REG	0x07010290U
+#define A133_CPU_RVBAR_LO_REG(cpu)	(0x08100040U + (cpu) * 8U)
+#define A133_CPU_RVBAR_HI_REG(cpu)	(0x08100044U + (cpu) * 8U)
+#define A133_COUNTER_LOW_REG		0x08110000U
+#define A133_COUNTER_HIGH_REG		0x08110004U
+#define A133_COUNTER_CTRL_REG		0x08120000U
+#define A133_COUNTER_LOW_SET_REG	0x08120008U
+#define A133_COUNTER_HIGH_SET_REG	0x0812000cU
+#define A133_COUNTER_FREQID_REG		0x08120020U
+#define A133_CPUCFG_CLUSTER_CTRL1_REG	0x09010014U
+
+#define A133_GICC_ENABLE_MASK		0x3U
+#define A133_GICC_STOCK_BYPASS_MASK	0x1e0U
+#define A133_PLL_STOCK_BITS		0x2501U
+#define A133_PLL_ENABLE_BIT		0x80000000U
+#define A133_PLL_LOCK_ENABLE_BIT	0x20000000U
+#define A133_PLL_LOCK_BIT		0x10000000U
+#define A133_PLL_OUTPUT_BIT		0x08000000U
+
+struct a133_register_value {
+	uintptr_t address;
+	uint32_t value;
+};
+
+static const struct a133_register_value nsi_resume_values[] = {
+	{ A133_NSI_BASE + 0x1618U, 0x1U },
+	{ A133_NSI_BASE + 0x1818U, 0x1U },
+	{ A133_NSI_BASE + 0x1614U, 0xaU },
+	{ A133_NSI_BASE + 0x1814U, 0xaU },
+	{ A133_NSI_BASE + 0x1a18U, 0x1U },
+	{ A133_NSI_BASE + 0x1a14U, 0xaU },
+	{ A133_NSI_BASE + 0x1c18U, 0x1U },
+	{ A133_NSI_BASE + 0x1c14U, 0xaU },
+	{ A133_NSI_BASE + 0x1e14U, 0xaU },
+	{ A133_NSI_BASE + 0x2018U, 0x1U },
+	{ A133_NSI_BASE + 0x2414U, 0xfU },
+	{ A133_NSI_BASE + 0x2e90U, 0x20020202U },
+	{ A133_NSI_BASE + 0x2e94U, 0x0U },
+	{ A133_NSI_BASE + 0x2e98U, 0x0U },
+};
+
+static bool backend_complete(const struct sunxi_a133_context_backend *backend)
+{
+	return (backend != NULL) && (backend->read_32 != NULL) &&
+	       (backend->write_32 != NULL) &&
+	       (backend->barrier != NULL) &&
+	       (backend->gic_reset != NULL) &&
+	       (backend->transaction_commit != NULL) &&
+	       (backend->transaction_finish != NULL);
+}
+
+static bool context_valid(const struct sunxi_a133_secure_context *context)
+{
+	return (context != NULL) &&
+	       (context->magic == SUNXI_A133_CONTEXT_MAGIC) &&
+	       (context->version == SUNXI_A133_CONTEXT_VERSION) &&
+	       backend_complete(&context->backend);
+}
+
+static uint32_t read_32(struct sunxi_a133_secure_context *context,
+			uintptr_t address)
+{
+	return context->backend.read_32(context->backend.cookie, address);
+}
+
+static void write_32(struct sunxi_a133_secure_context *context,
+		     uintptr_t address, uint32_t value)
+{
+	context->backend.write_32(context->backend.cookie, address, value);
+}
+
+static void restore_trusted_rvbar(struct sunxi_a133_secure_context *context)
+{
+	unsigned int cpu;
+
+	for (cpu = 0U; cpu < A133_CPU_COUNT; ++cpu) {
+		write_32(context, A133_CPU_RVBAR_LO_REG(cpu),
+			 context->trusted_warm_entry);
+		write_32(context, A133_CPU_RVBAR_HI_REG(cpu), 0U);
+	}
+}
+
+static void restore_security_policy(
+	struct sunxi_a133_secure_context *context)
+{
+	unsigned int port;
+
+	for (port = 0U; port < 14U; ++port) {
+		write_32(context, A133_SPC_PORT_SET_REG(port), UINT32_MAX);
+	}
+	write_32(context, A133_CCU_SEC_SWITCH_REG, 0x7U);
+	write_32(context, A133_R_PRCM_SEC_SWITCH_REG, 0x7U);
+	write_32(context, A133_DMA_SEC_REG, 0xffU);
+	write_32(context, A133_SPC_SPECIAL0_REG, 0x3U);
+	write_32(context, A133_SPC_SPECIAL1_REG, 0x1U);
+}
+
+static void restore_counter(struct sunxi_a133_secure_context *context)
+{
+	write_32(context, A133_COUNTER_CTRL_REG, 0U);
+	write_32(context, A133_COUNTER_FREQID_REG,
+		 context->counter_frequency_id);
+	write_32(context, A133_COUNTER_LOW_SET_REG, context->counter_low);
+	write_32(context, A133_COUNTER_HIGH_SET_REG, context->counter_high);
+	write_32(context, A133_COUNTER_CTRL_REG, 1U);
+}
+
+static void restore_nsi(struct sunxi_a133_secure_context *context)
+{
+	uint32_t chipid;
+	unsigned int i;
+
+	for (i = 0U; i < sizeof(nsi_resume_values) /
+				 sizeof(nsi_resume_values[0]); ++i) {
+		write_32(context, nsi_resume_values[i].address,
+			 nsi_resume_values[i].value);
+	}
+
+	chipid = (read_32(context, A133_SID_CHIPID_REG) >> 22) & 0xfU;
+	if ((chipid == 0U) || (chipid == 0xaU)) {
+		write_32(context, A133_NSI_BASE + 0x3008U, 0U);
+	}
+}
+
+static bool restore_pll_com(struct sunxi_a133_secure_context *context)
+{
+	uint32_t value;
+	uint32_t poll;
+
+	value = read_32(context, A133_PLL_COM_REG) | A133_PLL_STOCK_BITS;
+	write_32(context, A133_PLL_COM_REG, value);
+	if ((value & A133_PLL_ENABLE_BIT) == 0U) {
+		value |= A133_PLL_ENABLE_BIT;
+		write_32(context, A133_PLL_COM_REG, value);
+	}
+
+	value |= A133_PLL_LOCK_ENABLE_BIT;
+	write_32(context, A133_PLL_COM_REG, value);
+	for (poll = 0U; poll < context->pll_lock_polls; ++poll) {
+		if ((read_32(context, A133_PLL_COM_REG) &
+		     A133_PLL_LOCK_BIT) != 0U) {
+			break;
+		}
+	}
+	if (poll == context->pll_lock_polls) {
+		return false;
+	}
+
+	value = read_32(context, A133_PLL_COM_REG);
+	value &= ~A133_PLL_LOCK_ENABLE_BIT;
+	write_32(context, A133_PLL_COM_REG, value);
+	value |= A133_PLL_OUTPUT_BIT;
+	write_32(context, A133_PLL_COM_REG, value);
+	return true;
+}
+
+int sunxi_a133_secure_context_init(
+	struct sunxi_a133_secure_context *context,
+	const struct sunxi_a133_context_backend *backend,
+	uint64_t trusted_warm_entry, uint64_t bl31_base, uint64_t bl31_limit,
+	uint32_t pll_lock_polls)
+{
+	if ((context == NULL) || !backend_complete(backend) ||
+	    (trusted_warm_entry == 0U) ||
+	    (trusted_warm_entry > UINT32_MAX) ||
+	    ((trusted_warm_entry & 3U) != 0U) ||
+	    (bl31_base >= bl31_limit) ||
+	    (trusted_warm_entry < bl31_base) ||
+	    (trusted_warm_entry >= bl31_limit) ||
+	    (pll_lock_polls == 0U)) {
+		return SUNXI_A133_CONTEXT_EINVAL;
+	}
+
+	memset(context, 0, sizeof(*context));
+	context->magic = SUNXI_A133_CONTEXT_MAGIC;
+	context->version = SUNXI_A133_CONTEXT_VERSION;
+	context->phase = SUNXI_A133_CONTEXT_IDLE;
+	context->trusted_warm_entry = (uint32_t)trusted_warm_entry;
+	context->pll_lock_polls = pll_lock_polls;
+	context->backend = *backend;
+	return SUNXI_A133_CONTEXT_OK;
+}
+
+int sunxi_a133_secure_context_save_early(
+	struct sunxi_a133_secure_context *context)
+{
+	if (!context_valid(context)) {
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+	if (context->phase != SUNXI_A133_CONTEXT_IDLE) {
+		return SUNXI_A133_CONTEXT_ESTATE;
+	}
+
+	context->counter_low = read_32(context, A133_COUNTER_LOW_REG);
+	context->counter_high = read_32(context, A133_COUNTER_HIGH_REG);
+	context->counter_frequency_id = read_32(context,
+						 A133_COUNTER_FREQID_REG);
+	context->wake_source = 0U;
+	context->last_transaction_status = SUNXI_A133_CONTEXT_TX_OK;
+	context->phase = SUNXI_A133_CONTEXT_SAVED;
+	return SUNXI_A133_CONTEXT_OK;
+}
+
+int sunxi_a133_secure_context_commit_late(
+	struct sunxi_a133_secure_context *context)
+{
+	uint32_t value;
+	int status;
+
+	if (!context_valid(context)) {
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+	if (context->phase != SUNXI_A133_CONTEXT_SAVED) {
+		return SUNXI_A133_CONTEXT_ESTATE;
+	}
+
+	value = read_32(context, A133_GICC_CTLR_REG);
+	value = (value & ~A133_GICC_ENABLE_MASK) |
+		A133_GICC_STOCK_BYPASS_MASK;
+	write_32(context, A133_GICC_CTLR_REG, value);
+	status = context->backend.transaction_commit(context->backend.cookie);
+	context->last_transaction_status = status;
+	if (status == SUNXI_A133_CONTEXT_TX_OK) {
+		context->phase = SUNXI_A133_CONTEXT_COMMITTED;
+		context->backend.barrier(context->backend.cookie);
+		return SUNXI_A133_CONTEXT_OK;
+	}
+	if (status == SUNXI_A133_CONTEXT_TX_RETRY) {
+		return SUNXI_A133_CONTEXT_ERETRY;
+	}
+
+	context->phase = SUNXI_A133_CONTEXT_FAILED;
+	return SUNXI_A133_CONTEXT_EFAILSTOP;
+}
+
+int sunxi_a133_secure_context_restore_early(
+	struct sunxi_a133_secure_context *context)
+{
+	int status;
+
+	if (!context_valid(context)) {
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+	if (context->phase != SUNXI_A133_CONTEXT_COMMITTED) {
+		return SUNXI_A133_CONTEXT_ESTATE;
+	}
+
+	restore_trusted_rvbar(context);
+	/*
+	 * Stock resets the complete distributor before RESTORE_NOTIFY. Linux's
+	 * CPU-PM syscore notifier has already saved all normal-world Group-1
+	 * state and restores it after PSCI returns.
+	 */
+	if (!context->backend.gic_reset(context->backend.cookie)) {
+		context->phase = SUNXI_A133_CONTEXT_FAILED;
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+	status = context->backend.transaction_finish(context->backend.cookie,
+						     &context->wake_source);
+	context->last_transaction_status = status;
+	if (status != SUNXI_A133_CONTEXT_TX_OK) {
+		context->phase = SUNXI_A133_CONTEXT_FAILED;
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+
+	restore_security_policy(context);
+	restore_counter(context);
+	/* Unknown stock resume prerequisite; keep it A133-specific. */
+	write_32(context, A133_SYSCON_RESUME_REG, 0U);
+	restore_nsi(context);
+	if (!restore_pll_com(context)) {
+		context->phase = SUNXI_A133_CONTEXT_FAILED;
+		return SUNXI_A133_CONTEXT_ETIMEOUT;
+	}
+	write_32(context, A133_CPUCFG_CLUSTER_CTRL1_REG, 2U);
+	context->backend.barrier(context->backend.cookie);
+
+	context->counter_low = 0U;
+	context->counter_high = 0U;
+	context->counter_frequency_id = 0U;
+	context->phase = SUNXI_A133_CONTEXT_IDLE;
+	return SUNXI_A133_CONTEXT_OK;
+}
+
+int sunxi_a133_secure_context_abort(
+	struct sunxi_a133_secure_context *context)
+{
+	if (!context_valid(context)) {
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+	if (context->phase != SUNXI_A133_CONTEXT_SAVED) {
+		return SUNXI_A133_CONTEXT_ESTATE;
+	}
+
+	context->counter_low = 0U;
+	context->counter_high = 0U;
+	context->counter_frequency_id = 0U;
+	context->wake_source = 0U;
+	context->phase = SUNXI_A133_CONTEXT_IDLE;
+	return SUNXI_A133_CONTEXT_OK;
+}
diff --git a/plat/allwinner/common/sunxi_a133_system_suspend.c b/plat/allwinner/common/sunxi_a133_system_suspend.c
new file mode 100644
index 0000000..181f0c4
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_system_suspend.c
@@ -0,0 +1,147 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <arch_helpers.h>
+#include <platform_def.h>
+#include <lib/mmio.h>
+
+#include <sunxi_a133_gic.h>
+#include <sunxi_a133_psci_bridge.h>
+#include <sunxi_a133_secure_context.h>
+#include <sunxi_a133_system_suspend.h>
+#include <sunxi_a133_vendor_scp_runtime.h>
+
+#define A133_PLL_LOCK_POLLS	100000U
+
+static struct sunxi_a133_secure_context a133_secure_context;
+static bool a133_system_suspend_ready;
+
+static uint32_t runtime_read_32(void *cookie, uintptr_t address)
+{
+	(void)cookie;
+	return mmio_read_32(address);
+}
+
+static void runtime_write_32(void *cookie, uintptr_t address, uint32_t value)
+{
+	(void)cookie;
+	mmio_write_32(address, value);
+}
+
+static void runtime_barrier(void *cookie)
+{
+	(void)cookie;
+	dsbsy();
+}
+
+static bool runtime_gic_reset(void *cookie)
+{
+	const struct sunxi_a133_gic_backend backend = {
+		.read_32 = runtime_read_32,
+		.write_32 = runtime_write_32,
+	};
+
+	(void)cookie;
+	return sunxi_a133_gic_reset(&backend);
+}
+
+static int context_transaction_status(int status)
+{
+	if (status == SUNXI_A133_SUSPEND_OK) {
+		return SUNXI_A133_CONTEXT_TX_OK;
+	}
+	if (status == SUNXI_A133_SUSPEND_ERETRY) {
+		return SUNXI_A133_CONTEXT_TX_RETRY;
+	}
+	return SUNXI_A133_CONTEXT_TX_FAILED;
+}
+
+static int runtime_commit(void *cookie)
+{
+	(void)cookie;
+	return context_transaction_status(
+		sunxi_a133_psci_bridge_runtime_commit());
+}
+
+static int runtime_finish(void *cookie, uint32_t *wake_source)
+{
+	(void)cookie;
+	return context_transaction_status(
+		sunxi_a133_psci_bridge_runtime_finish(wake_source));
+}
+
+bool sunxi_a133_system_suspend_runtime_setup(uintptr_t secure_resume_entry)
+{
+	const struct sunxi_a133_context_backend backend = {
+		.read_32 = runtime_read_32,
+		.write_32 = runtime_write_32,
+		.barrier = runtime_barrier,
+		.gic_reset = runtime_gic_reset,
+		.transaction_commit = runtime_commit,
+		.transaction_finish = runtime_finish,
+	};
+	int ret;
+
+	a133_system_suspend_ready = false;
+	ret = sunxi_a133_psci_bridge_runtime_setup(secure_resume_entry);
+	if (ret != SUNXI_A133_SUSPEND_OK) {
+		return false;
+	}
+
+	ret = sunxi_a133_secure_context_init(&a133_secure_context, &backend,
+		secure_resume_entry, BL31_BASE, BL31_LIMIT,
+		A133_PLL_LOCK_POLLS);
+	if (ret != SUNXI_A133_CONTEXT_OK) {
+		return false;
+	}
+
+	a133_system_suspend_ready =
+		sunxi_a133_vendor_scp_runtime_suspend_available();
+	return a133_system_suspend_ready;
+}
+
+bool sunxi_a133_system_suspend_runtime_available(void)
+{
+	return a133_system_suspend_ready &&
+		sunxi_a133_vendor_scp_runtime_suspend_available();
+}
+
+void sunxi_a133_system_suspend_state(psci_power_state_t *target_state)
+{
+	sunxi_a133_psci_bridge_runtime_system_state(target_state);
+}
+
+int sunxi_a133_system_suspend_prepare(
+	const psci_power_state_t *target_state, uint64_t mpidr)
+{
+	int ret;
+
+	if (!sunxi_a133_system_suspend_runtime_available()) {
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+
+	ret = sunxi_a133_secure_context_save_early(&a133_secure_context);
+	if (ret != SUNXI_A133_CONTEXT_OK) {
+		return ret;
+	}
+
+	ret = sunxi_a133_psci_bridge_runtime_prepare(target_state, mpidr);
+	if (ret != SUNXI_A133_SUSPEND_OK) {
+		(void)sunxi_a133_secure_context_abort(&a133_secure_context);
+		return SUNXI_A133_CONTEXT_EFAILSTOP;
+	}
+	return SUNXI_A133_CONTEXT_OK;
+}
+
+int sunxi_a133_system_suspend_commit(void)
+{
+	return sunxi_a133_secure_context_commit_late(&a133_secure_context);
+}
+
+int sunxi_a133_system_suspend_finish(void)
+{
+	return sunxi_a133_secure_context_restore_early(&a133_secure_context);
+}
