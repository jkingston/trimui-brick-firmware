+# Build the validated A133 SCP suspend transaction state machine. It remains
+# disconnected from PSCI SYSTEM_SUSPEND and cannot remove CPU or DRAM power.
+SUNXI_A133_SUSPEND_ORCHESTRATOR	?=	0
+$(call assert_boolean,SUNXI_A133_SUSPEND_ORCHESTRATOR)
+ifeq (${SUNXI_A133_SUSPEND_ORCHESTRATOR},1)
+ifneq (${SUNXI_A133_NATIVE_WAKE_ABI},1)
+$(error SUNXI_A133_SUSPEND_ORCHESTRATOR requires SUNXI_A133_NATIVE_WAKE_ABI=1)
+endif
+$(eval $(call add_define,SUNXI_A133_SUSPEND_ORCHESTRATOR))
+endif
+
 # Cap BL31 at the start of stock's standby scratch. The common DT fixup still
