+void sunxi_a133_vendor_scp_runtime_suspend_state(
+	psci_power_state_t *target_state);
+int sunxi_a133_vendor_scp_runtime_suspend_prepare(
+	const psci_power_state_t *target_state, uint64_t mpidr,
+	uint64_t resume_entry);
+int sunxi_a133_vendor_scp_runtime_suspend_abort(void);
+int sunxi_a133_vendor_scp_runtime_suspend_commit(void);
+int sunxi_a133_vendor_scp_runtime_suspend_finish(uint32_t *wake_source);
+#endif
+
 #endif /* SUNXI_A133_VENDOR_SCP_RUNTIME_H */
diff --git a/plat/allwinner/common/sunxi_a133_suspend.c b/plat/allwinner/common/sunxi_a133_suspend.c
new file mode 100644
index 0000000..8c5c5e6
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_suspend.c
@@ -0,0 +1,206 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <sunxi_a133_suspend.h>
+
+#define STOCK_SUSPEND_LOCAL_STATE	3U
+
+#ifndef SUNXI_A133_SUSPEND_HOST_TEST
+CASSERT(PLAT_MAX_PWR_LVL == 2U, assert_a133_has_three_power_levels);
+CASSERT(PLAT_MAX_OFF_STATE == STOCK_SUSPEND_LOCAL_STATE,
+	assert_a133_off_state_matches_stock);
+#endif
+
+static bool backend_complete(
+	const struct sunxi_a133_suspend_backend *backend)
+{
+	return (backend != NULL) && (backend->capabilities != NULL) &&
+	       (backend->cpu_op != NULL) &&
+	       (backend->restore_notify != NULL);
+}
+
+static bool backend_ready(struct sunxi_a133_suspend *suspend)
+{
+	uint32_t capabilities;
+
+	capabilities = suspend->backend.capabilities(
+		suspend->backend.cookie);
+	return (capabilities & SUNXI_A133_SUSPEND_REQUIRED_CAPS) ==
+	       SUNXI_A133_SUSPEND_REQUIRED_CAPS;
+}
+
+static void clear_request(struct sunxi_a133_suspend *suspend)
+{
+	suspend->mpidr = 0U;
+	suspend->resume_entry = 0U;
+}
+
+int sunxi_a133_suspend_init(
+	struct sunxi_a133_suspend *suspend,
+	const struct sunxi_a133_suspend_backend *backend)
+{
+	if ((suspend == NULL) || !backend_complete(backend)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+
+	memset(suspend, 0, sizeof(*suspend));
+	suspend->backend = *backend;
+	suspend->phase = SUNXI_A133_SUSPEND_IDLE;
+	return SUNXI_A133_SUSPEND_OK;
+}
+
+void sunxi_a133_suspend_system_state(psci_power_state_t *target_state)
+{
+	unsigned int level;
+
+	assert(target_state != NULL);
+
+	for (level = 0U; level <= PLAT_MAX_PWR_LVL; level++) {
+		target_state->pwr_domain_state[level] = PLAT_MAX_OFF_STATE;
+	}
+}
+
+bool sunxi_a133_suspend_state_is_valid(
+	const psci_power_state_t *target_state)
+{
+	unsigned int level;
+
+	if (target_state == NULL) {
+		return false;
+	}
+	for (level = 0U; level <= PLAT_MAX_PWR_LVL; level++) {
+		if (target_state->pwr_domain_state[level] !=
+		    STOCK_SUSPEND_LOCAL_STATE) {
+			return false;
+		}
+	}
+
+	return true;
+}
+
+int sunxi_a133_suspend_prepare(
+	struct sunxi_a133_suspend *suspend,
+	const psci_power_state_t *target_state, uint64_t mpidr,
+	uint64_t resume_entry)
+{
+	if ((suspend == NULL) || !sunxi_a133_suspend_state_is_valid(
+						   target_state) ||
+	    (mpidr > UINT32_MAX) || (resume_entry == 0U) ||
+	    (resume_entry > UINT32_MAX) || ((resume_entry & 3U) != 0U)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (suspend->phase == SUNXI_A133_SUSPEND_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (suspend->phase != SUNXI_A133_SUSPEND_IDLE) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+	if (!backend_ready(suspend)) {
+		return SUNXI_A133_SUSPEND_ENOTREADY;
+	}
+
+	suspend->mpidr = (uint32_t)mpidr;
+	suspend->resume_entry = (uint32_t)resume_entry;
+	suspend->last_transport_status = SUNXI_VENDOR_SCP_OK;
+	suspend->wake_source = 0U;
+	suspend->wake_source_valid = false;
+	suspend->phase = SUNXI_A133_SUSPEND_PREPARED;
+	return SUNXI_A133_SUSPEND_OK;
+}
+
+int sunxi_a133_suspend_abort(struct sunxi_a133_suspend *suspend)
+{
+	if (suspend == NULL) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (suspend->phase == SUNXI_A133_SUSPEND_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (suspend->phase != SUNXI_A133_SUSPEND_PREPARED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	clear_request(suspend);
+	suspend->phase = SUNXI_A133_SUSPEND_IDLE;
+	return SUNXI_A133_SUSPEND_OK;
+}
+
+int sunxi_a133_suspend_commit(struct sunxi_a133_suspend *suspend)
+{
+	int ret;
+
+	if (suspend == NULL) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (suspend->phase == SUNXI_A133_SUSPEND_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (suspend->phase != SUNXI_A133_SUSPEND_PREPARED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+	if (!backend_ready(suspend)) {
+		return SUNXI_A133_SUSPEND_ENOTREADY;
+	}
+
+	ret = suspend->backend.cpu_op(suspend->backend.cookie,
+				      suspend->mpidr, suspend->resume_entry,
+				      STOCK_SUSPEND_LOCAL_STATE,
+				      STOCK_SUSPEND_LOCAL_STATE,
+				      STOCK_SUSPEND_LOCAL_STATE);
+	suspend->last_transport_status = ret;
+	if (ret == SUNXI_VENDOR_SCP_OK) {
+		suspend->phase = SUNXI_A133_SUSPEND_COMMITTED;
+		return SUNXI_A133_SUSPEND_OK;
+	}
+	/* Only a zero-word deadline failure is safe to retry. */
+	if ((ret == SUNXI_VENDOR_SCP_ETIMEOUT) && backend_ready(suspend)) {
+		return SUNXI_A133_SUSPEND_ERETRY;
+	}
+
+	suspend->phase = SUNXI_A133_SUSPEND_FAILED;
+	return SUNXI_A133_SUSPEND_EFAILSTOP;
+}
+
+int sunxi_a133_suspend_finish(struct sunxi_a133_suspend *suspend,
+			     uint32_t *wake_source)
+{
+	uint32_t wake;
+	int ret;
+
+	if ((suspend == NULL) || (wake_source == NULL)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (suspend->phase == SUNXI_A133_SUSPEND_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (suspend->phase != SUNXI_A133_SUSPEND_COMMITTED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+	if (!backend_ready(suspend)) {
+		suspend->phase = SUNXI_A133_SUSPEND_FAILED;
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+
+	ret = suspend->backend.restore_notify(suspend->backend.cookie, &wake);
+	suspend->last_transport_status = ret;
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		/* Only a zero-word deadline failure is safe to retry. */
+		if ((ret == SUNXI_VENDOR_SCP_ETIMEOUT) && backend_ready(suspend)) {
+			return SUNXI_A133_SUSPEND_ERETRY;
+		}
+		suspend->phase = SUNXI_A133_SUSPEND_FAILED;
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+
+	suspend->wake_source = wake;
+	suspend->wake_source_valid = true;
+	*wake_source = wake;
+	clear_request(suspend);
+	suspend->phase = SUNXI_A133_SUSPEND_IDLE;
+	return SUNXI_A133_SUSPEND_OK;
+}
diff --git a/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c b/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c
index 93f8936..c421e87 100644
--- a/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c
+++ b/plat/allwinner/common/sunxi_a133_vendor_scp_runtime.c
@@ -15,11 +15,44 @@
 static struct sunxi_a133_vendor_scp a133_vendor_scp;
 static spinlock_t a133_vendor_scp_lock;
 
+#if defined(SUNXI_A133_SUSPEND_ORCHESTRATOR)
+static struct sunxi_a133_suspend a133_suspend;
+static bool a133_suspend_ready;
+#endif
+
 static uint64_t runtime_timeout_ticks(void)
 {
 	return plat_get_syscnt_freq2() / 2U;
 }
 
+#if defined(SUNXI_A133_SUSPEND_ORCHESTRATOR)
+static uint32_t suspend_capabilities(void *cookie)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+
+	return sunxi_vendor_scp_capabilities(&scp->transport);
+}
+
+static int suspend_cpu_op(void *cookie, uint32_t mpidr,
+			  uint32_t resume_entry, uint32_t cpu_state,
+			  uint32_t cluster_state, uint32_t system_state)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+
+	return sunxi_vendor_scp_cpu_op(&scp->transport, mpidr, resume_entry,
+				       cpu_state, cluster_state, system_state,
+				       runtime_timeout_ticks());
+}
+
+static int suspend_restore_notify(void *cookie, uint32_t *wake_source)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+
+	return sunxi_vendor_scp_restore_notify(&scp->transport, wake_source,
+					       runtime_timeout_ticks());
+}
+#endif
+
 void sunxi_a133_vendor_scp_runtime_setup(void)
 {
 	uint64_t now = read_cntpct_el0();
@@ -33,6 +66,20 @@ void sunxi_a133_vendor_scp_runtime_setup(void)
 						   runtime_timeout_ticks());
 	}
 
+	if (ret == SUNXI_VENDOR_SCP_OK) {
+#if defined(SUNXI_A133_SUSPEND_ORCHESTRATOR)
+		const struct sunxi_a133_suspend_backend backend = {
+			.cookie = &a133_vendor_scp,
+			.capabilities = suspend_capabilities,
+			.cpu_op = suspend_cpu_op,
+			.restore_notify = suspend_restore_notify,
+		};
+
+		ret = sunxi_a133_suspend_init(&a133_suspend, &backend);
+		a133_suspend_ready = ret == SUNXI_A133_SUSPEND_OK;
+#endif
+	}
+
 	if (ret == SUNXI_VENDOR_SCP_OK) {
 		NOTICE("BL31: A133 vendor SCP transport ready\n");
 	} else {
@@ -83,3 +130,60 @@ int sunxi_a133_vendor_scp_runtime_clear_wake_source(uint32_t wake_source,
 {
 	return runtime_wake_source(false, wake_source, scp_result);
 }
+
+#if defined(SUNXI_A133_SUSPEND_ORCHESTRATOR)
+void sunxi_a133_vendor_scp_runtime_suspend_state(
+	psci_power_state_t *target_state)
+{
+	sunxi_a133_suspend_system_state(target_state);
+}
+
+int sunxi_a133_vendor_scp_runtime_suspend_prepare(
+	const psci_power_state_t *target_state, uint64_t mpidr,
+	uint64_t resume_entry)
+{
+	int ret;
+
+	spin_lock(&a133_vendor_scp_lock);
+	ret = a133_suspend_ready ?
+		sunxi_a133_suspend_prepare(&a133_suspend, target_state, mpidr,
+					   resume_entry) :
+		SUNXI_A133_SUSPEND_ENOTREADY;
+	spin_unlock(&a133_vendor_scp_lock);
+	return ret;
+}
+
+int sunxi_a133_vendor_scp_runtime_suspend_abort(void)
+{
+	int ret;
+
+	spin_lock(&a133_vendor_scp_lock);
+	ret = a133_suspend_ready ? sunxi_a133_suspend_abort(&a133_suspend) :
+		SUNXI_A133_SUSPEND_ENOTREADY;
+	spin_unlock(&a133_vendor_scp_lock);
+	return ret;
+}
+
+int sunxi_a133_vendor_scp_runtime_suspend_commit(void)
+{
+	int ret;
+
+	spin_lock(&a133_vendor_scp_lock);
+	ret = a133_suspend_ready ? sunxi_a133_suspend_commit(&a133_suspend) :
+		SUNXI_A133_SUSPEND_ENOTREADY;
+	spin_unlock(&a133_vendor_scp_lock);
+	return ret;
+}
+
+int sunxi_a133_vendor_scp_runtime_suspend_finish(uint32_t *wake_source)
+{
+	int ret;
+
+	spin_lock(&a133_vendor_scp_lock);
+	ret = a133_suspend_ready ?
+		sunxi_a133_suspend_finish(&a133_suspend, wake_source) :
+		SUNXI_A133_SUSPEND_ENOTREADY;
+	spin_unlock(&a133_vendor_scp_lock);
+	return ret;
+}
+#endif
