diff --git a/plat/allwinner/common/tests/test_sunxi_a133_suspend.c b/plat/allwinner/common/tests/test_sunxi_a133_suspend.c
new file mode 100644
index 0000000..e0150a7
--- /dev/null
+++ b/plat/allwinner/common/tests/test_sunxi_a133_suspend.c
@@ -0,0 +1,364 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <sunxi_a133_suspend.h>
+
+#define ARRAY_SIZE(array) (sizeof(array) / sizeof((array)[0]))
+
+struct fake_backend {
+	uint32_t capabilities;
+	uint32_t mpidr;
+	uint32_t resume_entry;
+	uint32_t cpu_state;
+	uint32_t cluster_state;
+	uint32_t system_state;
+	uint32_t wake_source;
+	unsigned int capability_calls;
+	unsigned int cpu_op_calls;
+	unsigned int restore_calls;
+	int cpu_op_status;
+	int restore_status;
+	bool clear_caps_after_cpu_op;
+	bool clear_caps_after_restore;
+};
+
+static uint32_t fake_capabilities(void *cookie)
+{
+	struct fake_backend *fake = cookie;
+
+	fake->capability_calls++;
+	return fake->capabilities;
+}
+
+static int fake_cpu_op(void *cookie, uint32_t mpidr, uint32_t resume_entry,
+		       uint32_t cpu_state, uint32_t cluster_state,
+		       uint32_t system_state)
+{
+	struct fake_backend *fake = cookie;
+
+	fake->cpu_op_calls++;
+	fake->mpidr = mpidr;
+	fake->resume_entry = resume_entry;
+	fake->cpu_state = cpu_state;
+	fake->cluster_state = cluster_state;
+	fake->system_state = system_state;
+	if (fake->clear_caps_after_cpu_op) {
+		fake->capabilities = 0U;
+	}
+	return fake->cpu_op_status;
+}
+
+static int fake_restore(void *cookie, uint32_t *wake_source)
+{
+	struct fake_backend *fake = cookie;
+
+	fake->restore_calls++;
+	*wake_source = fake->wake_source;
+	if (fake->clear_caps_after_restore) {
+		fake->capabilities = 0U;
+	}
+	return fake->restore_status;
+}
+
+static void setup(struct sunxi_a133_suspend *suspend,
+		  struct fake_backend *fake)
+{
+	const struct sunxi_a133_suspend_backend backend = {
+		.cookie = fake,
+		.capabilities = fake_capabilities,
+		.cpu_op = fake_cpu_op,
+		.restore_notify = fake_restore,
+	};
+
+	memset(fake, 0, sizeof(*fake));
+	fake->capabilities = SUNXI_A133_SUSPEND_REQUIRED_CAPS;
+	fake->wake_source = 0x67U;
+	assert(sunxi_a133_suspend_init(suspend, &backend) ==
+	       SUNXI_A133_SUSPEND_OK);
+}
+
+static psci_power_state_t stock_state(void)
+{
+	psci_power_state_t state = { { 0U } };
+
+	sunxi_a133_suspend_system_state(&state);
+	return state;
+}
+
+static void test_exact_state_and_arguments(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	uint32_t wake = 0U;
+	unsigned int level;
+
+	for (level = 0U; level <= PLAT_MAX_PWR_LVL; level++) {
+		assert(state.pwr_domain_state[level] == 3U);
+	}
+	assert(sunxi_a133_suspend_state_is_valid(&state));
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0x80000000U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_PREPARED);
+	assert(fake.cpu_op_calls == 0U);
+	assert(sunxi_a133_suspend_commit(&suspend) == SUNXI_A133_SUSPEND_OK);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_COMMITTED);
+	assert(fake.cpu_op_calls == 1U);
+	assert(fake.mpidr == 0x80000000U);
+	assert(fake.resume_entry == 0x40000100U);
+	assert(fake.cpu_state == 3U && fake.cluster_state == 3U &&
+	       fake.system_state == 3U);
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(fake.restore_calls == 1U && wake == 0x67U);
+	assert(suspend.wake_source_valid && suspend.wake_source == wake);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_IDLE);
+}
+
+static void test_validation_is_precommit(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	unsigned int level;
+
+	setup(&suspend, &fake);
+	assert(!sunxi_a133_suspend_state_is_valid(NULL));
+	for (level = 0U; level <= PLAT_MAX_PWR_LVL; level++) {
+		state = stock_state();
+		state.pwr_domain_state[level] = 2U;
+		assert(!sunxi_a133_suspend_state_is_valid(&state));
+		assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+						  0x40000100U) ==
+		       SUNXI_A133_SUSPEND_EINVAL);
+	}
+	state = stock_state();
+	assert(sunxi_a133_suspend_prepare(&suspend, &state,
+					  UINT64_C(0x100000000),
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U, 0U) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  UINT64_C(0x100000000)) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000102U) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+	assert(fake.cpu_op_calls == 0U && fake.restore_calls == 0U);
+}
+
+static void test_capabilities_are_all_required(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	const uint32_t capability[] = {
+		SUNXI_VENDOR_SCP_CAP_CPU_OP,
+		SUNXI_VENDOR_SCP_CAP_RESTORE_NOTIFY,
+		SUNXI_VENDOR_SCP_CAP_WAKE_SOURCE,
+	};
+	unsigned int i;
+
+	for (i = 0U; i < ARRAY_SIZE(capability); i++) {
+		setup(&suspend, &fake);
+		fake.capabilities &= ~capability[i];
+		assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+						  0x40000100U) ==
+		       SUNXI_A133_SUSPEND_ENOTREADY);
+		assert(suspend.phase == SUNXI_A133_SUSPEND_IDLE);
+		assert(fake.cpu_op_calls == 0U);
+	}
+}
+
+static void test_precommit_abort(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	uint32_t wake;
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 1U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_suspend_abort(&suspend) == SUNXI_A133_SUSPEND_OK);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_IDLE);
+	assert(suspend.mpidr == 0U && suspend.resume_entry == 0U);
+	assert(fake.cpu_op_calls == 0U && fake.restore_calls == 0U);
+	assert(sunxi_a133_suspend_abort(&suspend) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+}
+
+static void test_retry_only_before_commit_boundary(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	uint32_t wake;
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	fake.cpu_op_status = SUNXI_VENDOR_SCP_ETIMEOUT;
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_ERETRY);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_PREPARED);
+	assert(suspend.last_transport_status == SUNXI_VENDOR_SCP_ETIMEOUT);
+	fake.cpu_op_status = SUNXI_VENDOR_SCP_OK;
+	assert(sunxi_a133_suspend_commit(&suspend) == SUNXI_A133_SUSPEND_OK);
+	fake.restore_status = SUNXI_VENDOR_SCP_ETIMEOUT;
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_ERETRY);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_COMMITTED);
+	fake.restore_status = SUNXI_VENDOR_SCP_OK;
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_OK);
+}
+
+static void test_partial_transport_is_fail_stop(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	uint32_t wake;
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	fake.cpu_op_status = SUNXI_VENDOR_SCP_ETIMEOUT;
+	fake.clear_caps_after_cpu_op = true;
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_FAILED);
+	assert(sunxi_a133_suspend_abort(&suspend) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_suspend_commit(&suspend) == SUNXI_A133_SUSPEND_OK);
+	fake.restore_status = SUNXI_VENDOR_SCP_EPROTO;
+	fake.clear_caps_after_restore = true;
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_FAILED);
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	fake.cpu_op_status = SUNXI_VENDOR_SCP_EPROTO;
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_FAILED);
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_suspend_commit(&suspend) == SUNXI_A133_SUSPEND_OK);
+	fake.restore_status = SUNXI_VENDOR_SCP_EPROTO;
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_FAILED);
+}
+
+static void test_capability_loss_respects_commit_boundary(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	uint32_t wake;
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	fake.capabilities = 0U;
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_ENOTREADY);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_PREPARED);
+	assert(fake.cpu_op_calls == 0U);
+	assert(sunxi_a133_suspend_abort(&suspend) == SUNXI_A133_SUSPEND_OK);
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_suspend_commit(&suspend) == SUNXI_A133_SUSPEND_OK);
+	fake.capabilities = 0U;
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(suspend.phase == SUNXI_A133_SUSPEND_FAILED);
+	assert(fake.restore_calls == 0U);
+}
+
+static void test_state_machine_rejects_reordering(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct fake_backend fake;
+	psci_power_state_t state = stock_state();
+	uint32_t wake;
+
+	setup(&suspend, &fake);
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_suspend_finish(&suspend, &wake) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_suspend_prepare(&suspend, &state, 0U,
+					  0x40000100U) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_suspend_commit(&suspend) == SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_suspend_abort(&suspend) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_suspend_commit(&suspend) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+}
+
+static void test_init_rejects_incomplete_backends(void)
+{
+	struct sunxi_a133_suspend suspend;
+	struct sunxi_a133_suspend_backend backend = { 0 };
+
+	assert(sunxi_a133_suspend_init(NULL, &backend) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+	assert(sunxi_a133_suspend_init(&suspend, NULL) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+	assert(sunxi_a133_suspend_init(&suspend, &backend) ==
+	       SUNXI_A133_SUSPEND_EINVAL);
+}
+
+int main(void)
+{
+	test_exact_state_and_arguments();
+	test_validation_is_precommit();
+	test_capabilities_are_all_required();
+	test_precommit_abort();
+	test_retry_only_before_commit_boundary();
+	test_partial_transport_is_fail_stop();
+	test_capability_loss_respects_commit_boundary();
+	test_state_machine_rejects_reordering();
+	test_init_rejects_incomplete_backends();
+	puts("sunxi_a133_suspend orchestration tests: PASS");
+	return 0;
+}
