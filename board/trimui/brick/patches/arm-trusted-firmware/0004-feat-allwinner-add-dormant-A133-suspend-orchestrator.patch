new file mode 100644
index 0000000..2f75158
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_a133_suspend.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#ifndef SUNXI_A133_SUSPEND_H
+#define SUNXI_A133_SUSPEND_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifndef SUNXI_A133_SUSPEND_HOST_TEST
+#include <lib/psci/psci.h>
+#else
+#define PLAT_MAX_PWR_LVL	2U
+#define PLAT_MAX_OFF_STATE	3U
+struct psci_power_state {
+	uint8_t pwr_domain_state[PLAT_MAX_PWR_LVL + 1U];
+};
+#define psci_power_state_t struct psci_power_state
+#endif
+
+#include <sunxi_vendor_scp.h>
+
+#define SUNXI_A133_SUSPEND_REQUIRED_CAPS	\
+	(SUNXI_VENDOR_SCP_CAP_CPU_OP | SUNXI_VENDOR_SCP_CAP_RESTORE_NOTIFY | \
+	 SUNXI_VENDOR_SCP_CAP_WAKE_SOURCE)
+
+enum sunxi_a133_suspend_status {
+	SUNXI_A133_SUSPEND_OK = 0,
+	SUNXI_A133_SUSPEND_EINVAL = -1,
+	SUNXI_A133_SUSPEND_ENOTREADY = -2,
+	SUNXI_A133_SUSPEND_ESTATE = -3,
+	SUNXI_A133_SUSPEND_ERETRY = -4,
+	SUNXI_A133_SUSPEND_EFAILSTOP = -5,
+};
+
+enum sunxi_a133_suspend_phase {
+	SUNXI_A133_SUSPEND_IDLE,
+	SUNXI_A133_SUSPEND_PREPARED,
+	SUNXI_A133_SUSPEND_COMMITTED,
+	SUNXI_A133_SUSPEND_FAILED,
+};
+
+struct sunxi_a133_suspend_backend {
+	void *cookie;
+	uint32_t (*capabilities)(void *cookie);
+	int (*cpu_op)(void *cookie, uint32_t mpidr, uint32_t resume_entry,
+		      uint32_t cpu_state, uint32_t cluster_state,
+		      uint32_t system_state);
+	int (*restore_notify)(void *cookie, uint32_t *wake_source);
+};
+
+struct sunxi_a133_suspend {
+	struct sunxi_a133_suspend_backend backend;
+	enum sunxi_a133_suspend_phase phase;
+	uint32_t mpidr;
+	uint32_t resume_entry;
+	uint32_t wake_source;
+	int last_transport_status;
+	bool wake_source_valid;
+};
+
+/* The caller must serialize all operations on one context. */
+int sunxi_a133_suspend_init(
+	struct sunxi_a133_suspend *suspend,
+	const struct sunxi_a133_suspend_backend *backend);
+void sunxi_a133_suspend_system_state(psci_power_state_t *target_state);
+bool sunxi_a133_suspend_state_is_valid(
+	const psci_power_state_t *target_state);
+int sunxi_a133_suspend_prepare(
+	struct sunxi_a133_suspend *suspend,
+	const psci_power_state_t *target_state, uint64_t mpidr,
+	uint64_t resume_entry);
+int sunxi_a133_suspend_abort(struct sunxi_a133_suspend *suspend);
+int sunxi_a133_suspend_commit(struct sunxi_a133_suspend *suspend);
+int sunxi_a133_suspend_finish(struct sunxi_a133_suspend *suspend,
+			     uint32_t *wake_source);
+
+#endif /* SUNXI_A133_SUSPEND_H */
