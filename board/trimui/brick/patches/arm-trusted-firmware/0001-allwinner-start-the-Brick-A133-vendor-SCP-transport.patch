diff --git a/plat/allwinner/common/include/sunxi_a133_vendor_scp.h b/plat/allwinner/common/include/sunxi_a133_vendor_scp.h
new file mode 100644
index 0000000..52c8777
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_a133_vendor_scp.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#ifndef SUNXI_A133_VENDOR_SCP_H
+#define SUNXI_A133_VENDOR_SCP_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <sunxi_vendor_scp.h>
+
+struct sunxi_a133_vendor_scp {
+	struct sunxi_vendor_scp transport;
+	uintptr_t msgbox_base;
+	bool owners_validated;
+	bool ownership_fault;
+};
+
+int sunxi_a133_vendor_scp_init(struct sunxi_a133_vendor_scp *scp,
+			       uintptr_t msgbox_base);
+int sunxi_a133_vendor_scp_startup(struct sunxi_a133_vendor_scp *scp,
+				  uint32_t nonce, uint64_t timeout_ticks);
+
+#ifdef SUNXI_A133_VENDOR_SCP_MMIO_HOST_TEST
+uint32_t sunxi_a133_vendor_scp_test_mmio_read(uintptr_t address);
+void sunxi_a133_vendor_scp_test_mmio_write(uintptr_t address, uint32_t value);
+#endif
+
+#endif /* SUNXI_A133_VENDOR_SCP_H */
diff --git a/plat/allwinner/common/include/sunxi_vendor_scp.h b/plat/allwinner/common/include/sunxi_vendor_scp.h
new file mode 100644
index 0000000..75f5398
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_vendor_scp.h
@@ -0,0 +1,71 @@
+/*
+ * Copyright (c) 2026, The Trusted Firmware Project Contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef SUNXI_VENDOR_SCP_H
+#define SUNXI_VENDOR_SCP_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define SUNXI_VENDOR_SCP_CAP_CPU_OP		(1U << 0)
+#define SUNXI_VENDOR_SCP_CAP_RESTORE_NOTIFY	(1U << 1)
+
+enum sunxi_vendor_scp_status {
+	SUNXI_VENDOR_SCP_OK = 0,
+	SUNXI_VENDOR_SCP_EINVAL = -1,
+	SUNXI_VENDOR_SCP_ETIMEOUT = -2,
+	SUNXI_VENDOR_SCP_ENOTREADY = -3,
+	SUNXI_VENDOR_SCP_EPOISONED = -4,
+	SUNXI_VENDOR_SCP_EPROTO = -5,
+};
+
+struct sunxi_vendor_scp_io {
+	void *cookie;
+	bool (*tx_ready)(void *cookie, unsigned int channel);
+	void (*tx_write)(void *cookie, unsigned int channel, uint32_t value);
+	bool (*rx_ready)(void *cookie, unsigned int channel);
+	uint32_t (*rx_read)(void *cookie, unsigned int channel);
+};
+
+struct sunxi_vendor_scp {
+	struct sunxi_vendor_scp_io io;
+	uint32_t startup_payload[13];
+	uint8_t startup_state;
+	bool ready;
+	bool poisoned;
+};
+
+/* The caller must serialize every operation on a context and its queues. */
+
+int sunxi_vendor_scp_init(struct sunxi_vendor_scp *scp,
+			  const struct sunxi_vendor_scp_io *io);
+
+/*
+ * Accept the exact stock q2 startup notification, acknowledge it on q3 with
+ * the stock zero image-base value, then prove q4/q5 hard-sync transport with
+ * an exact nonce echo. timeout_ticks is measured by the architectural physical
+ * counter, so callers should derive it from plat_get_syscnt_freq2().
+ */
+int sunxi_vendor_scp_startup(struct sunxi_vendor_scp *scp,
+			     uint32_t nonce, uint64_t timeout_ticks);
+
+uint32_t sunxi_vendor_scp_capabilities(const struct sunxi_vendor_scp *scp);
+
+/* Send the stock five-argument, asynchronous type 0x22 CPU_OP frame. */
+int sunxi_vendor_scp_cpu_op(struct sunxi_vendor_scp *scp, uint32_t mpidr,
+			    uint32_t resume_entry, uint32_t cpu_state,
+			    uint32_t cluster_state, uint32_t system_state,
+			    uint64_t timeout_ticks);
+
+/*
+ * Send the hard-synchronous type 0x11 restore notification and return the
+ * wake source carried by its one-word response.
+ */
+int sunxi_vendor_scp_restore_notify(struct sunxi_vendor_scp *scp,
+				    uint32_t *wake_source,
+				    uint64_t timeout_ticks);
+
+#endif /* SUNXI_VENDOR_SCP_H */
diff --git a/plat/allwinner/common/sunxi_a133_vendor_scp.c b/plat/allwinner/common/sunxi_a133_vendor_scp.c
new file mode 100644
index 0000000..868834e
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_vendor_scp.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stddef.h>
+
+#ifndef SUNXI_A133_VENDOR_SCP_MMIO_HOST_TEST
+#include <lib/mmio.h>
+#endif
+
+#include <sunxi_a133_vendor_scp.h>
+
+#define MSGBOX_CTRL0_REG	0x0000U
+#define MSGBOX_CTRL1_REG	0x0004U
+#define MSGBOX_FIFO_STAT_REG(n)	(0x0100U + (4U * (n)))
+#define MSGBOX_MSG_STAT_REG(n)	(0x0140U + (4U * (n)))
+#define MSGBOX_MSG_DATA_REG(n)	(0x0180U + (4U * (n)))
+
+#define MSGBOX_FIFO_FULL	(1U << 0)
+#define MSGBOX_MSG_COUNT_MASK	0x7U
+
+/* q0..q5 owner fields after the SCP initializes the old mailbox IP. */
+#define A133_MSGBOX_CTRL0_OWNERS	0x10011001U
+#define A133_MSGBOX_CTRL1_OWNERS	0x00000110U
+
+#ifdef SUNXI_A133_VENDOR_SCP_MMIO_HOST_TEST
+static uint32_t msgbox_read(uintptr_t address)
+{
+	return sunxi_a133_vendor_scp_test_mmio_read(address);
+}
+
+static void msgbox_write(uintptr_t address, uint32_t value)
+{
+	sunxi_a133_vendor_scp_test_mmio_write(address, value);
+}
+#else
+static uint32_t msgbox_read(uintptr_t address)
+{
+	return mmio_read_32(address);
+}
+
+static void msgbox_write(uintptr_t address, uint32_t value)
+{
+	mmio_write_32(address, value);
+}
+#endif
+
+static bool validate_owners(struct sunxi_a133_vendor_scp *scp)
+{
+	uint32_t ctrl0;
+	uint32_t ctrl1;
+
+	if (scp->owners_validated)
+		return true;
+
+	ctrl0 = msgbox_read(scp->msgbox_base + MSGBOX_CTRL0_REG);
+	ctrl1 = msgbox_read(scp->msgbox_base + MSGBOX_CTRL1_REG);
+	if ((ctrl0 != A133_MSGBOX_CTRL0_OWNERS) ||
+	    (ctrl1 != A133_MSGBOX_CTRL1_OWNERS)) {
+		scp->ownership_fault = true;
+		return false;
+	}
+
+	scp->owners_validated = true;
+	return true;
+}
+
+static bool a133_tx_ready(void *cookie, unsigned int channel)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+
+	if ((channel >= 6U) || scp->ownership_fault ||
+	    !scp->owners_validated) {
+		return false;
+	}
+
+	return (msgbox_read(scp->msgbox_base + MSGBOX_FIFO_STAT_REG(channel)) &
+		MSGBOX_FIFO_FULL) == 0U;
+}
+
+static void a133_tx_write(void *cookie, unsigned int channel, uint32_t value)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+
+	msgbox_write(scp->msgbox_base + MSGBOX_MSG_DATA_REG(channel), value);
+}
+
+static bool a133_rx_ready(void *cookie, unsigned int channel)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+	uint32_t count;
+
+	if ((channel >= 6U) || scp->ownership_fault)
+		return false;
+
+	count = msgbox_read(scp->msgbox_base + MSGBOX_MSG_STAT_REG(channel)) &
+		MSGBOX_MSG_COUNT_MASK;
+	if (count == 0U)
+		return false;
+
+	/* The SCP owns initialization. Validate its contract without writing it. */
+	return validate_owners(scp);
+}
+
+static uint32_t a133_rx_read(void *cookie, unsigned int channel)
+{
+	struct sunxi_a133_vendor_scp *scp = cookie;
+
+	return msgbox_read(scp->msgbox_base + MSGBOX_MSG_DATA_REG(channel));
+}
+
+int sunxi_a133_vendor_scp_init(struct sunxi_a133_vendor_scp *scp,
+			       uintptr_t msgbox_base)
+{
+	struct sunxi_vendor_scp_io io;
+
+	if ((scp == NULL) || (msgbox_base == 0U) ||
+	    ((msgbox_base & (sizeof(uint32_t) - 1U)) != 0U)) {
+		return SUNXI_VENDOR_SCP_EINVAL;
+	}
+
+	*scp = (struct sunxi_a133_vendor_scp){
+		.msgbox_base = msgbox_base,
+	};
+	io = (struct sunxi_vendor_scp_io){
+		.cookie = scp,
+		.tx_ready = a133_tx_ready,
+		.tx_write = a133_tx_write,
+		.rx_ready = a133_rx_ready,
+		.rx_read = a133_rx_read,
+	};
+
+	return sunxi_vendor_scp_init(&scp->transport, &io);
+}
+
+int sunxi_a133_vendor_scp_startup(struct sunxi_a133_vendor_scp *scp,
+				  uint32_t nonce, uint64_t timeout_ticks)
+{
+	int ret;
+
+	if (scp == NULL)
+		return SUNXI_VENDOR_SCP_EINVAL;
+
+	ret = sunxi_vendor_scp_startup(&scp->transport, nonce, timeout_ticks);
+	if (scp->ownership_fault) {
+		scp->transport.poisoned = true;
+		return SUNXI_VENDOR_SCP_EPROTO;
+	}
+
+	return ret;
+}
