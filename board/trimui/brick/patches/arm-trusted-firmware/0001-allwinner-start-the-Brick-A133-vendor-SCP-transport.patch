diff --git a/plat/allwinner/common/sunxi_vendor_scp.c b/plat/allwinner/common/sunxi_vendor_scp.c
new file mode 100644
index 0000000..15a194b
--- /dev/null
+++ b/plat/allwinner/common/sunxi_vendor_scp.c
@@ -0,0 +1,389 @@
+/*
+ * Copyright (c) 2026, The Trusted Firmware Project Contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <string.h>
+
+#ifndef SUNXI_VENDOR_SCP_HOST_TEST
+#include <arch_helpers.h>
+#endif
+
+#include <sunxi_vendor_scp.h>
+
+#define SCP_CH_ASYNC_RX		0U
+#define SCP_CH_ASYNC_TX		1U
+#define SCP_CH_SYNC_RX		2U
+#define SCP_CH_SYNC_FEEDBACK	3U
+#define SCP_CH_HARD_TX		4U
+#define SCP_CH_HARD_RX		5U
+
+#define SCP_STATE_ALLOCATED	2U
+#define SCP_ATTR_HARDSYNC	2U
+#define SCP_TYPE_RESTORE_NOTIFY	0x11U
+#define SCP_TYPE_CPU_OP		0x22U
+#define SCP_TYPE_LOOPBACK	0x61U
+#define SCP_TYPE_STARTUP_NOTIFY	0x90U
+#define SCP_MAX_WORDS		16U
+#define SCP_STARTUP_WORDS	13U
+
+struct scp_frame {
+	uint8_t state;
+	uint8_t attr;
+	uint8_t type;
+	uint8_t result;
+	uint8_t count;
+	uint32_t payload[SCP_MAX_WORDS];
+};
+
+static uint32_t frame_header(const struct scp_frame *frame)
+{
+	return (uint32_t)frame->state |
+	       ((uint32_t)frame->attr << 8) |
+	       ((uint32_t)frame->type << 16) |
+	       ((uint32_t)frame->result << 24);
+}
+
+#ifdef SUNXI_VENDOR_SCP_HOST_TEST
+uint64_t sunxi_vendor_scp_test_time_now(void *cookie);
+#endif
+
+static uint64_t time_now(struct sunxi_vendor_scp *scp)
+{
+#ifdef SUNXI_VENDOR_SCP_HOST_TEST
+	return sunxi_vendor_scp_test_time_now(scp->io.cookie);
+#else
+	(void)scp;
+	return read_cntpct_el0();
+#endif
+}
+
+static bool deadline_elapsed(struct sunxi_vendor_scp *scp, uint64_t deadline)
+{
+	return (int64_t)(time_now(scp) - deadline) >= 0;
+}
+
+static int deadline_init(struct sunxi_vendor_scp *scp, uint64_t timeout_ticks,
+			 uint64_t *deadline)
+{
+	if (timeout_ticks > INT64_MAX) {
+		return SUNXI_VENDOR_SCP_EINVAL;
+	}
+
+	*deadline = time_now(scp) + timeout_ticks;
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+static int wait_tx(struct sunxi_vendor_scp *scp, unsigned int channel,
+		   uint64_t deadline)
+{
+	while (!scp->io.tx_ready(scp->io.cookie, channel)) {
+		if (deadline_elapsed(scp, deadline)) {
+			return SUNXI_VENDOR_SCP_ETIMEOUT;
+		}
+	}
+	if (deadline_elapsed(scp, deadline)) {
+		return SUNXI_VENDOR_SCP_ETIMEOUT;
+	}
+
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+static int wait_rx(struct sunxi_vendor_scp *scp, unsigned int channel,
+		   uint64_t deadline)
+{
+	while (!scp->io.rx_ready(scp->io.cookie, channel)) {
+		if (deadline_elapsed(scp, deadline)) {
+			return SUNXI_VENDOR_SCP_ETIMEOUT;
+		}
+	}
+	if (deadline_elapsed(scp, deadline)) {
+		return SUNXI_VENDOR_SCP_ETIMEOUT;
+	}
+
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+static int write_word(struct sunxi_vendor_scp *scp, unsigned int channel,
+		      uint32_t value, uint64_t deadline,
+		      unsigned int *written)
+{
+	int ret;
+
+	ret = wait_tx(scp, channel, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		if (*written != 0U) {
+			scp->poisoned = true;
+		}
+		return ret;
+	}
+
+	scp->io.tx_write(scp->io.cookie, channel, value);
+	(*written)++;
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+static int send_frame(struct sunxi_vendor_scp *scp, unsigned int channel,
+		      const struct scp_frame *frame, uint64_t deadline)
+{
+	unsigned int i;
+	unsigned int written = 0U;
+	int ret;
+
+	if (frame->count > SCP_MAX_WORDS) {
+		return SUNXI_VENDOR_SCP_EINVAL;
+	}
+
+	ret = write_word(scp, channel, frame_header(frame), deadline, &written);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	ret = write_word(scp, channel, frame->count, deadline, &written);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	for (i = 0U; i < frame->count; i++) {
+		ret = write_word(scp, channel, frame->payload[i], deadline,
+				 &written);
+		if (ret != SUNXI_VENDOR_SCP_OK) {
+			return ret;
+		}
+	}
+
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+static int receive_frame(struct sunxi_vendor_scp *scp, unsigned int channel,
+			 struct scp_frame *frame, uint64_t deadline)
+{
+	uint32_t header;
+	uint32_t count;
+	unsigned int i;
+	int ret;
+
+	ret = wait_rx(scp, channel, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	header = scp->io.rx_read(scp->io.cookie, channel);
+
+	ret = wait_rx(scp, channel, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		scp->poisoned = true;
+		return ret;
+	}
+	count = scp->io.rx_read(scp->io.cookie, channel);
+	if (count > UINT8_MAX) {
+		scp->poisoned = true;
+		return SUNXI_VENDOR_SCP_EPROTO;
+	}
+
+	frame->state = header & 0xffU;
+	frame->attr = (header >> 8) & 0xffU;
+	frame->type = (header >> 16) & 0xffU;
+	frame->result = (header >> 24) & 0xffU;
+	frame->count = count;
+
+	for (i = 0U; i < count; i++) {
+		ret = wait_rx(scp, channel, deadline);
+		if (ret != SUNXI_VENDOR_SCP_OK) {
+			scp->poisoned = true;
+			return ret;
+		}
+		if (i < SCP_MAX_WORDS) {
+			frame->payload[i] = scp->io.rx_read(scp->io.cookie,
+						       channel);
+		} else {
+			(void)scp->io.rx_read(scp->io.cookie, channel);
+		}
+	}
+
+	return count > SCP_MAX_WORDS ? SUNXI_VENDOR_SCP_EPROTO :
+		SUNXI_VENDOR_SCP_OK;
+}
+
+int sunxi_vendor_scp_init(struct sunxi_vendor_scp *scp,
+			  const struct sunxi_vendor_scp_io *io)
+{
+	if ((scp == NULL) || (io == NULL) || (io->tx_ready == NULL) ||
+	    (io->tx_write == NULL) || (io->rx_ready == NULL) ||
+	    (io->rx_read == NULL)) {
+		return SUNXI_VENDOR_SCP_EINVAL;
+	}
+
+	memset(scp, 0, sizeof(*scp));
+	scp->io = *io;
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+int sunxi_vendor_scp_startup(struct sunxi_vendor_scp *scp,
+			     uint32_t nonce, uint64_t timeout_ticks)
+{
+	struct scp_frame frame;
+	struct scp_frame reply;
+	uint64_t deadline;
+	int ret;
+
+	if ((scp == NULL) || scp->poisoned) {
+		return scp == NULL ? SUNXI_VENDOR_SCP_EINVAL :
+			SUNXI_VENDOR_SCP_EPOISONED;
+	}
+
+	ret = deadline_init(scp, timeout_ticks, &deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	memset(&frame, 0, sizeof(frame));
+	ret = receive_frame(scp, SCP_CH_SYNC_RX, &frame, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	if ((frame.attr != SCP_ATTR_HARDSYNC) ||
+	    (frame.type != SCP_TYPE_STARTUP_NOTIFY) || (frame.result != 0U) ||
+	    (frame.count != SCP_STARTUP_WORDS)) {
+		scp->poisoned = true;
+		return SUNXI_VENDOR_SCP_EPROTO;
+	}
+
+	scp->startup_state = frame.state;
+	memcpy(scp->startup_payload, frame.payload,
+	       sizeof(scp->startup_payload));
+	memset(&reply, 0, sizeof(reply));
+	reply.state = frame.state;
+	reply.attr = SCP_ATTR_HARDSYNC;
+	reply.type = SCP_TYPE_STARTUP_NOTIFY;
+	reply.count = 1U;
+	/* Stock uses zero for the disabled SCP image-base field. */
+	reply.payload[0] = 0U;
+	ret = send_frame(scp, SCP_CH_SYNC_FEEDBACK, &reply, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		scp->poisoned = true;
+		return ret;
+	}
+
+	memset(&frame, 0, sizeof(frame));
+	frame.state = SCP_STATE_ALLOCATED;
+	frame.attr = SCP_ATTR_HARDSYNC;
+	frame.type = SCP_TYPE_LOOPBACK;
+	frame.count = 1U;
+	frame.payload[0] = nonce;
+	ret = send_frame(scp, SCP_CH_HARD_TX, &frame, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		scp->poisoned = true;
+		return ret;
+	}
+
+	memset(&reply, 0, sizeof(reply));
+	ret = receive_frame(scp, SCP_CH_HARD_RX, &reply, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		scp->poisoned = true;
+		return ret;
+	}
+	if ((reply.state != SCP_STATE_ALLOCATED) ||
+	    (reply.attr != SCP_ATTR_HARDSYNC) ||
+	    (reply.type != SCP_TYPE_LOOPBACK) || (reply.result != 0U) ||
+	    (reply.count != 1U) || (reply.payload[0] != nonce)) {
+		scp->poisoned = true;
+		return SUNXI_VENDOR_SCP_EPROTO;
+	}
+
+	scp->ready = true;
+	return SUNXI_VENDOR_SCP_OK;
+}
+
+uint32_t sunxi_vendor_scp_capabilities(const struct sunxi_vendor_scp *scp)
+{
+	if ((scp == NULL) || !scp->ready || scp->poisoned) {
+		return 0U;
+	}
+
+	return SUNXI_VENDOR_SCP_CAP_CPU_OP |
+	       SUNXI_VENDOR_SCP_CAP_RESTORE_NOTIFY;
+}
+
+int sunxi_vendor_scp_cpu_op(struct sunxi_vendor_scp *scp, uint32_t mpidr,
+			    uint32_t resume_entry, uint32_t cpu_state,
+			    uint32_t cluster_state, uint32_t system_state,
+			    uint64_t timeout_ticks)
+{
+	struct scp_frame frame;
+	uint64_t deadline;
+	int ret;
+
+	if (scp == NULL) {
+		return SUNXI_VENDOR_SCP_EINVAL;
+	}
+	if (scp->poisoned) {
+		return SUNXI_VENDOR_SCP_EPOISONED;
+	}
+	if (!scp->ready) {
+		return SUNXI_VENDOR_SCP_ENOTREADY;
+	}
+
+	memset(&frame, 0, sizeof(frame));
+	frame.state = SCP_STATE_ALLOCATED;
+	frame.type = SCP_TYPE_CPU_OP;
+	frame.count = 5U;
+	frame.payload[0] = mpidr;
+	frame.payload[1] = resume_entry;
+	frame.payload[2] = cpu_state;
+	frame.payload[3] = cluster_state;
+	frame.payload[4] = system_state;
+
+	ret = deadline_init(scp, timeout_ticks, &deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	return send_frame(scp, SCP_CH_ASYNC_TX, &frame, deadline);
+}
+
+int sunxi_vendor_scp_restore_notify(struct sunxi_vendor_scp *scp,
+				    uint32_t *wake_source,
+				    uint64_t timeout_ticks)
+{
+	struct scp_frame request;
+	struct scp_frame reply;
+	uint64_t deadline;
+	int ret;
+
+	if ((scp == NULL) || (wake_source == NULL)) {
+		return SUNXI_VENDOR_SCP_EINVAL;
+	}
+	if (scp->poisoned) {
+		return SUNXI_VENDOR_SCP_EPOISONED;
+	}
+	if (!scp->ready) {
+		return SUNXI_VENDOR_SCP_ENOTREADY;
+	}
+
+	memset(&request, 0, sizeof(request));
+	request.state = SCP_STATE_ALLOCATED;
+	request.attr = SCP_ATTR_HARDSYNC;
+	request.type = SCP_TYPE_RESTORE_NOTIFY;
+
+	ret = deadline_init(scp, timeout_ticks, &deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+	ret = send_frame(scp, SCP_CH_HARD_TX, &request, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		return ret;
+	}
+
+	memset(&reply, 0, sizeof(reply));
+	ret = receive_frame(scp, SCP_CH_HARD_RX, &reply, deadline);
+	if (ret != SUNXI_VENDOR_SCP_OK) {
+		scp->poisoned = true;
+		return ret;
+	}
+	if ((reply.state != SCP_STATE_ALLOCATED) ||
+	    (reply.attr != SCP_ATTR_HARDSYNC) ||
+	    (reply.type != SCP_TYPE_RESTORE_NOTIFY) ||
+	    (reply.result != 0U) || (reply.count != 1U)) {
+		scp->poisoned = true;
+		return SUNXI_VENDOR_SCP_EPROTO;
+	}
+
+	*wake_source = reply.payload[0];
+	return SUNXI_VENDOR_SCP_OK;
+}
