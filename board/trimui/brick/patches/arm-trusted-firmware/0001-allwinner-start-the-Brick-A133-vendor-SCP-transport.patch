+						   (uint32_t)now,
+						   plat_get_syscnt_freq2() / 2U);
+	}
+
+	if (ret == SUNXI_VENDOR_SCP_OK) {
+		NOTICE("BL31: A133 vendor SCP transport ready\n");
+	} else {
+		WARN("BL31: A133 vendor SCP startup failed: %d\n", ret);
+	}
+}
+#endif
+
 static const gicv2_driver_data_t sunxi_gic_data = {
 	.gicd_base = SUNXI_GICD_BASE,
 	.gicc_base = SUNXI_GICC_BASE,
@@ -138,6 +165,10 @@ void bl31_platform_setup(void)
 	}
 	NOTICE("BL31: Detected Allwinner %s SoC (%04x)\n", soc_name, soc_id);
 
+#if defined(SUNXI_A133_VENDOR_SCP_STARTUP)
+	sunxi_a133_vendor_scp_setup();
+#endif
+
 	generic_delay_timer_init();
 
 	sunxi_find_dtb();
