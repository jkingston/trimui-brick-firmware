diff --git a/plat/allwinner/common/include/sunxi_a133_psci_bridge.h b/plat/allwinner/common/include/sunxi_a133_psci_bridge.h
new file mode 100644
index 0000000..b5a5681
--- /dev/null
+++ b/plat/allwinner/common/include/sunxi_a133_psci_bridge.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#ifndef SUNXI_A133_PSCI_BRIDGE_H
+#define SUNXI_A133_PSCI_BRIDGE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <sunxi_a133_suspend.h>
+
+enum sunxi_a133_psci_bridge_phase {
+	SUNXI_A133_PSCI_BRIDGE_UNINITIALIZED,
+	SUNXI_A133_PSCI_BRIDGE_IDLE,
+	SUNXI_A133_PSCI_BRIDGE_PREPARED,
+	SUNXI_A133_PSCI_BRIDGE_COMMITTED,
+	SUNXI_A133_PSCI_BRIDGE_FAILED,
+};
+
+struct sunxi_a133_psci_bridge_backend {
+	void *cookie;
+	void (*system_state)(void *cookie, psci_power_state_t *target_state);
+	int (*prepare)(void *cookie, const psci_power_state_t *target_state,
+		       uint64_t mpidr, uint64_t secure_resume_entry);
+	int (*abort)(void *cookie);
+	int (*commit)(void *cookie);
+	int (*finish)(void *cookie, uint32_t *wake_source);
+};
+
+struct sunxi_a133_psci_bridge {
+	struct sunxi_a133_psci_bridge_backend backend;
+	enum sunxi_a133_psci_bridge_phase phase;
+	uint32_t secure_resume_entry;
+};
+
+/*
+ * These checked, return-valued steps are deliberately not PSCI callbacks.
+ * In particular, no void callback may discard a transport failure.
+ */
+int sunxi_a133_psci_bridge_init(
+	struct sunxi_a133_psci_bridge *bridge,
+	const struct sunxi_a133_psci_bridge_backend *backend,
+	uint64_t secure_resume_entry, uint64_t secure_region_base,
+	uint64_t secure_region_limit);
+int sunxi_a133_psci_bridge_system_state(
+	struct sunxi_a133_psci_bridge *bridge,
+	psci_power_state_t *target_state);
+int sunxi_a133_psci_bridge_prepare(struct sunxi_a133_psci_bridge *bridge,
+				   const psci_power_state_t *target_state,
+				   uint64_t mpidr);
+int sunxi_a133_psci_bridge_abort(struct sunxi_a133_psci_bridge *bridge);
+int sunxi_a133_psci_bridge_commit(struct sunxi_a133_psci_bridge *bridge);
+int sunxi_a133_psci_bridge_finish(struct sunxi_a133_psci_bridge *bridge,
+				  uint32_t *wake_source);
+
+#ifndef SUNXI_A133_PSCI_BRIDGE_HOST_TEST
+int sunxi_a133_psci_bridge_runtime_setup(uintptr_t secure_resume_entry);
+int sunxi_a133_psci_bridge_runtime_system_state(
+	psci_power_state_t *target_state);
+int sunxi_a133_psci_bridge_runtime_prepare(
+	const psci_power_state_t *target_state, uint64_t mpidr);
+int sunxi_a133_psci_bridge_runtime_abort(void);
+int sunxi_a133_psci_bridge_runtime_commit(void);
+int sunxi_a133_psci_bridge_runtime_finish(uint32_t *wake_source);
+#endif
+
+#endif /* SUNXI_A133_PSCI_BRIDGE_H */
diff --git a/plat/allwinner/common/sunxi_a133_psci_bridge.c b/plat/allwinner/common/sunxi_a133_psci_bridge.c
new file mode 100644
index 0000000..19f9fcd
--- /dev/null
+++ b/plat/allwinner/common/sunxi_a133_psci_bridge.c
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <sunxi_a133_psci_bridge.h>
+
+static bool backend_complete(
+	const struct sunxi_a133_psci_bridge_backend *backend)
+{
+	return (backend != NULL) && (backend->system_state != NULL) &&
+	       (backend->prepare != NULL) && (backend->abort != NULL) &&
+	       (backend->commit != NULL) && (backend->finish != NULL);
+}
+
+static bool secure_entry_valid(uint64_t entry, uint64_t region_base,
+			       uint64_t region_limit)
+{
+	return (entry != 0U) && (region_base < region_limit) &&
+	       (entry >= region_base) &&
+	       (entry < region_limit) && (entry <= UINT32_MAX) &&
+	       ((entry & 3U) == 0U);
+}
+
+static void fail_if_terminal(struct sunxi_a133_psci_bridge *bridge, int ret)
+{
+	if (ret == SUNXI_A133_SUSPEND_EFAILSTOP) {
+		bridge->phase = SUNXI_A133_PSCI_BRIDGE_FAILED;
+	}
+}
+
+int sunxi_a133_psci_bridge_init(
+	struct sunxi_a133_psci_bridge *bridge,
+	const struct sunxi_a133_psci_bridge_backend *backend,
+	uint64_t secure_resume_entry, uint64_t secure_region_base,
+	uint64_t secure_region_limit)
+{
+	if ((bridge == NULL) || !backend_complete(backend) ||
+	    !secure_entry_valid(secure_resume_entry, secure_region_base,
+				secure_region_limit)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (bridge->phase != SUNXI_A133_PSCI_BRIDGE_UNINITIALIZED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	memset(bridge, 0, sizeof(*bridge));
+	bridge->backend = *backend;
+	bridge->secure_resume_entry = (uint32_t)secure_resume_entry;
+	bridge->phase = SUNXI_A133_PSCI_BRIDGE_IDLE;
+	return SUNXI_A133_SUSPEND_OK;
+}
+
+int sunxi_a133_psci_bridge_system_state(
+	struct sunxi_a133_psci_bridge *bridge,
+	psci_power_state_t *target_state)
+{
+	if ((bridge == NULL) || (target_state == NULL)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (bridge->phase == SUNXI_A133_PSCI_BRIDGE_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (bridge->phase != SUNXI_A133_PSCI_BRIDGE_IDLE) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	bridge->backend.system_state(bridge->backend.cookie, target_state);
+	return SUNXI_A133_SUSPEND_OK;
+}
+
+int sunxi_a133_psci_bridge_prepare(struct sunxi_a133_psci_bridge *bridge,
+				   const psci_power_state_t *target_state,
+				   uint64_t mpidr)
+{
+	int ret;
+
+	if ((bridge == NULL) || (target_state == NULL)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (bridge->phase == SUNXI_A133_PSCI_BRIDGE_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (bridge->phase != SUNXI_A133_PSCI_BRIDGE_IDLE) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	ret = bridge->backend.prepare(bridge->backend.cookie, target_state,
+				      mpidr, bridge->secure_resume_entry);
+	if (ret == SUNXI_A133_SUSPEND_OK) {
+		bridge->phase = SUNXI_A133_PSCI_BRIDGE_PREPARED;
+	} else {
+		fail_if_terminal(bridge, ret);
+	}
+	return ret;
+}
+
+int sunxi_a133_psci_bridge_abort(struct sunxi_a133_psci_bridge *bridge)
+{
+	int ret;
+
+	if (bridge == NULL) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (bridge->phase == SUNXI_A133_PSCI_BRIDGE_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (bridge->phase != SUNXI_A133_PSCI_BRIDGE_PREPARED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	ret = bridge->backend.abort(bridge->backend.cookie);
+	if (ret == SUNXI_A133_SUSPEND_OK) {
+		bridge->phase = SUNXI_A133_PSCI_BRIDGE_IDLE;
+	} else {
+		fail_if_terminal(bridge, ret);
+	}
+	return ret;
+}
+
+int sunxi_a133_psci_bridge_commit(struct sunxi_a133_psci_bridge *bridge)
+{
+	int ret;
+
+	if (bridge == NULL) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (bridge->phase == SUNXI_A133_PSCI_BRIDGE_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (bridge->phase != SUNXI_A133_PSCI_BRIDGE_PREPARED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	ret = bridge->backend.commit(bridge->backend.cookie);
+	if (ret == SUNXI_A133_SUSPEND_OK) {
+		bridge->phase = SUNXI_A133_PSCI_BRIDGE_COMMITTED;
+	} else {
+		fail_if_terminal(bridge, ret);
+	}
+	return ret;
+}
+
+int sunxi_a133_psci_bridge_finish(struct sunxi_a133_psci_bridge *bridge,
+				  uint32_t *wake_source)
+{
+	int ret;
+
+	if ((bridge == NULL) || (wake_source == NULL)) {
+		return SUNXI_A133_SUSPEND_EINVAL;
+	}
+	if (bridge->phase == SUNXI_A133_PSCI_BRIDGE_FAILED) {
+		return SUNXI_A133_SUSPEND_EFAILSTOP;
+	}
+	if (bridge->phase != SUNXI_A133_PSCI_BRIDGE_COMMITTED) {
+		return SUNXI_A133_SUSPEND_ESTATE;
+	}
+
+	ret = bridge->backend.finish(bridge->backend.cookie, wake_source);
+	if (ret == SUNXI_A133_SUSPEND_OK) {
+		bridge->phase = SUNXI_A133_PSCI_BRIDGE_IDLE;
+	} else {
+		fail_if_terminal(bridge, ret);
+	}
+	return ret;
+}
