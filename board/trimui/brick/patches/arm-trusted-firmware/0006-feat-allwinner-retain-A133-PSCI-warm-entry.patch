diff --git a/plat/allwinner/common/tests/test_sunxi_a133_psci_bridge.c b/plat/allwinner/common/tests/test_sunxi_a133_psci_bridge.c
new file mode 100644
index 0000000..b695467
--- /dev/null
+++ b/plat/allwinner/common/tests/test_sunxi_a133_psci_bridge.c
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <sunxi_a133_psci_bridge.h>
+
+#define TEST_BL31_BASE		UINT64_C(0x40000000)
+#define TEST_BL31_LIMIT		UINT64_C(0x40020000)
+#define TEST_SECURE_ENTRY	UINT64_C(0x40000188)
+
+struct mock_backend {
+	char calls[16];
+	size_t call_count;
+	int prepare_ret;
+	int abort_ret;
+	int commit_ret;
+	int finish_ret;
+	uint64_t mpidr;
+	uint64_t secure_resume_entry;
+};
+
+static void record_call(struct mock_backend *mock, char call)
+{
+	assert(mock->call_count < sizeof(mock->calls));
+	mock->calls[mock->call_count++] = call;
+}
+
+static void mock_system_state(void *cookie, psci_power_state_t *target_state)
+{
+	struct mock_backend *mock = cookie;
+
+	record_call(mock, 'S');
+	for (size_t i = 0; i <= PLAT_MAX_PWR_LVL; i++) {
+		target_state->pwr_domain_state[i] = PLAT_MAX_OFF_STATE;
+	}
+}
+
+static int mock_prepare(void *cookie,
+			const psci_power_state_t *target_state,
+			uint64_t mpidr, uint64_t secure_resume_entry)
+{
+	struct mock_backend *mock = cookie;
+
+	(void)target_state;
+	record_call(mock, 'P');
+	mock->mpidr = mpidr;
+	mock->secure_resume_entry = secure_resume_entry;
+	return mock->prepare_ret;
+}
+
+static int mock_abort(void *cookie)
+{
+	struct mock_backend *mock = cookie;
+
+	record_call(mock, 'A');
+	return mock->abort_ret;
+}
+
+static int mock_commit(void *cookie)
+{
+	struct mock_backend *mock = cookie;
+
+	record_call(mock, 'C');
+	return mock->commit_ret;
+}
+
+static int mock_finish(void *cookie, uint32_t *wake_source)
+{
+	struct mock_backend *mock = cookie;
+
+	record_call(mock, 'F');
+	*wake_source = 0x12345678U;
+	return mock->finish_ret;
+}
+
+static struct sunxi_a133_psci_bridge_backend backend_for(
+	struct mock_backend *mock)
+{
+	const struct sunxi_a133_psci_bridge_backend backend = {
+		.cookie = mock,
+		.system_state = mock_system_state,
+		.prepare = mock_prepare,
+		.abort = mock_abort,
+		.commit = mock_commit,
+		.finish = mock_finish,
+	};
+
+	return backend;
+}
+
+static void init_bridge(struct sunxi_a133_psci_bridge *bridge,
+			struct mock_backend *mock)
+{
+	struct sunxi_a133_psci_bridge_backend backend = backend_for(mock);
+
+	assert(sunxi_a133_psci_bridge_init(
+		bridge, &backend, TEST_SECURE_ENTRY, TEST_BL31_BASE,
+		TEST_BL31_LIMIT) == SUNXI_A133_SUSPEND_OK);
+}
+
+static psci_power_state_t system_state(
+	struct sunxi_a133_psci_bridge *bridge)
+{
+	psci_power_state_t state = { 0 };
+
+	assert(sunxi_a133_psci_bridge_system_state(bridge, &state) ==
+	       SUNXI_A133_SUSPEND_OK);
+	for (size_t i = 0; i <= PLAT_MAX_PWR_LVL; i++) {
+		assert(state.pwr_domain_state[i] == PLAT_MAX_OFF_STATE);
+	}
+	return state;
+}
+
+static void test_trusted_entry_custody(void)
+{
+	struct sunxi_a133_psci_bridge bridge = { 0 };
+	struct mock_backend mock = { 0 };
+	struct sunxi_a133_psci_bridge_backend backend = backend_for(&mock);
+	psci_power_state_t state;
+
+	init_bridge(&bridge, &mock);
+	assert(bridge.secure_resume_entry == TEST_SECURE_ENTRY);
+	assert(sunxi_a133_psci_bridge_init(
+		&bridge, &backend, TEST_SECURE_ENTRY + 4U, TEST_BL31_BASE,
+		TEST_BL31_LIMIT) == SUNXI_A133_SUSPEND_ESTATE);
+	assert(bridge.secure_resume_entry == TEST_SECURE_ENTRY);
+
+	state = system_state(&bridge);
+	assert(sunxi_a133_psci_bridge_prepare(&bridge, &state,
+		UINT64_C(0x80000000)) == SUNXI_A133_SUSPEND_OK);
+	assert(mock.mpidr == UINT64_C(0x80000000));
+	assert(mock.secure_resume_entry == TEST_SECURE_ENTRY);
+	assert(memcmp(mock.calls, "SP", 2) == 0);
+	assert(sunxi_a133_psci_bridge_abort(&bridge) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(memcmp(mock.calls, "SPA", 3) == 0);
+}
+
+static void test_rejects_untrusted_entries(void)
+{
+	struct mock_backend mock = { 0 };
+	struct sunxi_a133_psci_bridge_backend backend = backend_for(&mock);
+	const uint64_t invalid_entries[] = {
+		0U,
+		TEST_BL31_BASE - 4U,
+		TEST_BL31_BASE + 2U,
+		TEST_BL31_LIMIT,
+		UINT64_C(0x100000000),
+	};
+
+	for (size_t i = 0; i < sizeof(invalid_entries) /
+				      sizeof(invalid_entries[0]); i++) {
+		struct sunxi_a133_psci_bridge bridge = { 0 };
+
+		assert(sunxi_a133_psci_bridge_init(
+			&bridge, &backend, invalid_entries[i], TEST_BL31_BASE,
+			TEST_BL31_LIMIT) == SUNXI_A133_SUSPEND_EINVAL);
+		assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_UNINITIALIZED);
+	}
+
+	{
+		struct sunxi_a133_psci_bridge bridge = { 0 };
+
+		assert(sunxi_a133_psci_bridge_init(
+			&bridge, &backend, 0U, 0U, 4U) ==
+		       SUNXI_A133_SUSPEND_EINVAL);
+	}
+
+	{
+		struct sunxi_a133_psci_bridge bridge = { 0 };
+		struct sunxi_a133_psci_bridge_backend incomplete = backend;
+
+		incomplete.finish = NULL;
+		assert(sunxi_a133_psci_bridge_init(
+			&bridge, &incomplete, TEST_SECURE_ENTRY,
+			TEST_BL31_BASE, TEST_BL31_LIMIT) ==
+		       SUNXI_A133_SUSPEND_EINVAL);
+	}
+}
+
+static void test_complete_order(void)
+{
+	struct sunxi_a133_psci_bridge bridge = { 0 };
+	struct mock_backend mock = { 0 };
+	psci_power_state_t state;
+	uint32_t wake = 0U;
+
+	init_bridge(&bridge, &mock);
+	state = system_state(&bridge);
+	assert(sunxi_a133_psci_bridge_prepare(&bridge, &state, 3U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_psci_bridge_commit(&bridge) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_psci_bridge_finish(&bridge, &wake) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(wake == 0x12345678U);
+	assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_IDLE);
+	assert(memcmp(mock.calls, "SPCF", 4) == 0);
+}
+
+static void test_retry_and_failstop_order(void)
+{
+	struct sunxi_a133_psci_bridge bridge = { 0 };
+	struct mock_backend mock = { 0 };
+	psci_power_state_t state;
+
+	init_bridge(&bridge, &mock);
+	state = system_state(&bridge);
+	assert(sunxi_a133_psci_bridge_prepare(&bridge, &state, 0U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	mock.commit_ret = SUNXI_A133_SUSPEND_ERETRY;
+	assert(sunxi_a133_psci_bridge_commit(&bridge) ==
+	       SUNXI_A133_SUSPEND_ERETRY);
+	assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_PREPARED);
+	mock.commit_ret = SUNXI_A133_SUSPEND_EFAILSTOP;
+	assert(sunxi_a133_psci_bridge_commit(&bridge) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_FAILED);
+	assert(sunxi_a133_psci_bridge_abort(&bridge) ==
+	       SUNXI_A133_SUSPEND_EFAILSTOP);
+	assert(memcmp(mock.calls, "SPCC", 4) == 0);
+}
+
+static void test_safe_prepare_failure(void)
+{
+	struct sunxi_a133_psci_bridge bridge = { 0 };
+	struct mock_backend mock = {
+		.prepare_ret = SUNXI_A133_SUSPEND_ENOTREADY,
+	};
+	psci_power_state_t state;
+
+	init_bridge(&bridge, &mock);
+	state = system_state(&bridge);
+	assert(sunxi_a133_psci_bridge_prepare(&bridge, &state, 0U) ==
+	       SUNXI_A133_SUSPEND_ENOTREADY);
+	assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_IDLE);
+	assert(sunxi_a133_psci_bridge_abort(&bridge) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(memcmp(mock.calls, "SP", 2) == 0);
+}
+
+static void test_finish_retry_preserves_commit(void)
+{
+	struct sunxi_a133_psci_bridge bridge = { 0 };
+	struct mock_backend mock = { 0 };
+	psci_power_state_t state;
+	uint32_t wake = 0U;
+
+	init_bridge(&bridge, &mock);
+	state = system_state(&bridge);
+	assert(sunxi_a133_psci_bridge_prepare(&bridge, &state, 0U) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(sunxi_a133_psci_bridge_commit(&bridge) ==
+	       SUNXI_A133_SUSPEND_OK);
+	mock.finish_ret = SUNXI_A133_SUSPEND_ERETRY;
+	assert(sunxi_a133_psci_bridge_finish(&bridge, &wake) ==
+	       SUNXI_A133_SUSPEND_ERETRY);
+	assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_COMMITTED);
+	mock.finish_ret = SUNXI_A133_SUSPEND_OK;
+	assert(sunxi_a133_psci_bridge_finish(&bridge, &wake) ==
+	       SUNXI_A133_SUSPEND_OK);
+	assert(bridge.phase == SUNXI_A133_PSCI_BRIDGE_IDLE);
+	assert(memcmp(mock.calls, "SPCFF", 5) == 0);
+}
+
+static void test_invalid_order_is_side_effect_free(void)
+{
+	struct sunxi_a133_psci_bridge bridge = { 0 };
+	struct mock_backend mock = { 0 };
+	uint32_t wake;
+
+	init_bridge(&bridge, &mock);
+	assert(sunxi_a133_psci_bridge_abort(&bridge) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_psci_bridge_commit(&bridge) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(sunxi_a133_psci_bridge_finish(&bridge, &wake) ==
+	       SUNXI_A133_SUSPEND_ESTATE);
+	assert(mock.call_count == 0U);
+}
+
+int main(void)
+{
+	test_trusted_entry_custody();
+	test_rejects_untrusted_entries();
+	test_complete_order();
+	test_retry_and_failstop_order();
+	test_safe_prepare_failure();
+	test_finish_retry_preserves_commit();
+	test_invalid_order_is_side_effect_free();
+	puts("sunxi_a133_psci_bridge tests: PASS");
+	return 0;
+}
