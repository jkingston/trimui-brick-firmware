 ifeq (${SUNXI_A133_SUSPEND_ORCHESTRATOR},1)
 BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_a133_suspend.c
 endif
+
+# Retain TF-A's own secure warm entry and expose checked transaction steps for
+# later PSCI callback composition. This deliberately does not add any callback
+# to plat_psci_ops_t, advertise SYSTEM_SUSPEND, issue CPU_OP, or enter WFI.
+SUNXI_A133_PSCI_SUSPEND_PRECURSOR	?=	0
+$(call assert_boolean,SUNXI_A133_PSCI_SUSPEND_PRECURSOR)
+ifeq (${SUNXI_A133_PSCI_SUSPEND_PRECURSOR},1)
+ifneq (${ARCH},aarch64)
+$(error SUNXI_A133_PSCI_SUSPEND_PRECURSOR requires ARCH=aarch64)
+endif
+ifneq (${SUNXI_A133_SUSPEND_ORCHESTRATOR},1)
+$(error SUNXI_A133_PSCI_SUSPEND_PRECURSOR requires SUNXI_A133_SUSPEND_ORCHESTRATOR=1)
+endif
+ifneq (${SUNXI_A133_STANDBY_SCRATCH},1)
+$(error SUNXI_A133_PSCI_SUSPEND_PRECURSOR requires SUNXI_A133_STANDBY_SCRATCH=1)
+endif
+$(eval $(call add_define,SUNXI_A133_PSCI_SUSPEND_PRECURSOR))
+BL31_SOURCES		+=	${AW_PLAT}/common/sunxi_a133_psci_bridge.c \
+				${AW_PLAT}/common/sunxi_a133_psci_bridge_runtime.c
+endif
