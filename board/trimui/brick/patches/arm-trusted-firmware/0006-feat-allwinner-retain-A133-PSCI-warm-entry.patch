@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Copyright (c) 2026, The Trusted Firmware Project Contributors. */
+
+#include <assert.h>
+#include <stdint.h>
+
+#include <platform_def.h>
+
+#include <sunxi_a133_psci_bridge.h>
+#include <sunxi_a133_vendor_scp_runtime.h>
+
+CASSERT(BL31_BASE <= UINT32_MAX, assert_a133_bl31_base_fits_cpu_op);
+CASSERT((BL31_LIMIT - 1U) <= UINT32_MAX,
+	assert_a133_bl31_limit_fits_cpu_op);
+
+static struct sunxi_a133_psci_bridge a133_psci_bridge;
+
+static void runtime_system_state(void *cookie,
+				 psci_power_state_t *target_state)
+{
+	(void)cookie;
+	sunxi_a133_vendor_scp_runtime_suspend_state(target_state);
+}
+
+static int runtime_prepare(void *cookie,
+			   const psci_power_state_t *target_state,
+			   uint64_t mpidr, uint64_t secure_resume_entry)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_suspend_prepare(
+		target_state, mpidr, secure_resume_entry);
+}
+
+static int runtime_abort(void *cookie)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_suspend_abort();
+}
+
+static int runtime_commit(void *cookie)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_suspend_commit();
+}
+
+static int runtime_finish(void *cookie, uint32_t *wake_source)
+{
+	(void)cookie;
+	return sunxi_a133_vendor_scp_runtime_suspend_finish(wake_source);
+}
+
+int sunxi_a133_psci_bridge_runtime_setup(uintptr_t secure_resume_entry)
+{
+	const struct sunxi_a133_psci_bridge_backend backend = {
+		.system_state = runtime_system_state,
+		.prepare = runtime_prepare,
+		.abort = runtime_abort,
+		.commit = runtime_commit,
+		.finish = runtime_finish,
+	};
+
+	return sunxi_a133_psci_bridge_init(&a133_psci_bridge, &backend,
+		secure_resume_entry, BL31_BASE, BL31_LIMIT);
+}
+
+int sunxi_a133_psci_bridge_runtime_system_state(
+	psci_power_state_t *target_state)
+{
+	return sunxi_a133_psci_bridge_system_state(&a133_psci_bridge,
+					    target_state);
+}
+
+int sunxi_a133_psci_bridge_runtime_prepare(
+	const psci_power_state_t *target_state, uint64_t mpidr)
+{
+	return sunxi_a133_psci_bridge_prepare(&a133_psci_bridge, target_state,
+					      mpidr);
+}
+
+int sunxi_a133_psci_bridge_runtime_abort(void)
+{
+	return sunxi_a133_psci_bridge_abort(&a133_psci_bridge);
+}
+
+int sunxi_a133_psci_bridge_runtime_commit(void)
+{
+	return sunxi_a133_psci_bridge_commit(&a133_psci_bridge);
+}
+
+int sunxi_a133_psci_bridge_runtime_finish(uint32_t *wake_source)
+{
+	return sunxi_a133_psci_bridge_finish(&a133_psci_bridge, wake_source);
+}
